#!/usr/bin/env bash

SCRIPT=${BASH_SOURCE[0]}
for ((hops = 0; hops < 40; hops++)); do
  [[ -L "$SCRIPT" ]] || break
  directory="$(cd -- "$(dirname -- "$SCRIPT")" && pwd -P)" || exit 1
  target="$(readlink "$SCRIPT")" || exit 1
  case "$target" in /*) SCRIPT="$target" ;; *) SCRIPT="$directory/$target" ;; esac
done
[[ ! -L "$SCRIPT" ]] || { printf 'script symlink loop\n' >&2; exit 1; }
HERE="$(cd -- "$(dirname -- "$SCRIPT")" && pwd -P)" || exit 1
. "$HERE/lib/maintenance.bash" || exit 1
LOG_NAME="${LOG_NAME:+$LOG_NAME.}symlinks"
LINK_CONFLICT_MODE=${LINK_CONFLICT_MODE:-skip}
APPLY_IGNORE_RULES=1
paths=()
SOURCES=()
IGNORE_PATHS=()
shopt -s nullglob dotglob

usage() {
  printf 'Usage: symlinks [--force] [--no-ignore] [--] [path...]\n'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) LINK_CONFLICT_MODE=force ;;
    --no-ignore) APPLY_IGNORE_RULES=0 ;;
    --help) usage; exit 0 ;;
    --) shift; paths+=( "$@" ); break ;;
    -*) usage >&2; exit 2 ;;
    *) paths+=( "$1" ) ;;
  esac
  shift
done
case "$LINK_CONFLICT_MODE" in
  skip|backup|force) ;;
  *) log -e "unknown LINK_CONFLICT_MODE=$LINK_CONFLICT_MODE"; exit 2 ;;
esac
[[ ${#paths[@]} -gt 0 ]] || paths=( . )
for path in "${paths[@]}"; do
  case "/$path/" in
    //*|*/../*) log -e "path must stay within home payload: $path"; exit 2 ;;
  esac
done
[[ -d "$PORTABLE_HOME" ]] || { failure "missing home payload"; finish; exit 1; }

within() {
  case "$1" in "$2"|"$2"/*) return 0 ;; *) return 1 ;; esac
}

collect() {
  local source="$1" relative="$2" ancestor physical child name
  shift 2
  if [[ "$APPLY_IGNORE_RULES" = 1 && "${source##*/}" = .DS_Store ]]; then return 0; fi
  if [[ -d "$source" ]]; then
    physical="$(cd -- "$source" && pwd -P)" || { failure "traverse $source"; return; }
    within "$physical" "$PORTABLE_HOME" || { failure "source directory escapes payload: $source"; return; }
    for ancestor in "$@"; do
      [[ "$ancestor" != "$physical" ]] || { failure "source directory loop: $source"; return; }
    done
    [[ -r "$source" && -x "$source" ]] || { failure "unreadable directory: $source"; return; }
    for child in "$source"/*; do
      name=${child##*/}
      if [[ -z "$relative" && "$name" = Library && "$OS" != Darwin ]]; then continue; fi
      collect "$child" "${relative:+$relative/}$name" "$@" "$physical"
    done
  elif [[ -f "$source" || -L "$source" ]]; then
    physical="$(cd -- "$(dirname "$source")" && pwd -P)" || { failure "resolve $source"; return; }
    within "$physical" "$PORTABLE_HOME" || { failure "source escapes payload: $source"; return; }
    SOURCES+=( "$relative" )
    IGNORE_PATHS+=( "${physical#$PORTABLES/}/${source##*/}" )
  else
    failure "nothing to link: $source"
  fi
}

link_file() {
  local relative="$1" source="$PORTABLE_HOME/$1" destination="$HOME/$1"
  local parent existing physical backup index=0
  if [[ "$source" -ef "$destination" ]]; then return 0; fi
  if [[ -L "$destination" && "$(readlink "$destination")" = "$source" ]]; then return 0; fi
  parent="$(dirname "$destination")"
  existing="$parent"
  while [[ ! -e "$existing" && ! -L "$existing" ]]; do existing="$(dirname "$existing")"; done
  [[ -d "$existing" ]] || { log -e "non-directory parent: $existing"; return 1; }
  physical="$(cd -- "$existing" && pwd -P)" || return 1
  if within "$physical" "$PORTABLES"; then
    log -e "refusing to modify repository through destination: $destination"
    return 1
  fi
  mkdir -p "$parent" || return 1
  if [[ -e "$destination" || -L "$destination" ]]; then
    case "$LINK_CONFLICT_MODE" in
      skip) log -w "skipping existing path: $destination"; return 0 ;;
      backup)
        backup="$destination.bak.$(date +%Y%m%d%H%M%S)"
        while [[ -e "$backup" || -L "$backup" ]]; do
          index=$((index + 1))
          backup="$destination.bak.$(date +%Y%m%d%H%M%S).$index"
        done
        mv "$destination" "$backup" || return 1
        log -i "backed up $destination -> $backup"
        ;;
      force) rm -rf -- "$destination" || return 1 ;;
    esac
  fi
  ln -s "$source" "$destination"
}

for path in "${paths[@]}"; do
  while [[ "$path" = ./* ]]; do path=${path#./}; done
  path=${path%/}
  [[ "$path" != . ]] || path=
  collect "$PORTABLE_HOME${path:+/$path}" "$path"
done

if [[ ${#SOURCES[@]} -gt 0 ]]; then
  temp="$(mktemp -d "${TMPDIR:-/tmp}/portables-links.XXXXXX")" || exit 1
  trap 'rm -rf -- "$temp"' EXIT
  git_available=0
  if [[ "$APPLY_IGNORE_RULES" = 1 ]] && command -v git >/dev/null 2>&1 &&
      [[ -e "$PORTABLES/.git" ]]; then
    git_available=1
    printf '%s\0' "${IGNORE_PATHS[@]}" >"$temp/paths"
    git_result=0
    git -C "$PORTABLES" check-ignore -z --stdin --no-index --non-matching -v \
      <"$temp/paths" >"$temp/ignored" || git_result=$?
    if [[ "$git_result" -gt 1 ]]; then
      failure "Git ignore lookup failed; links not applied"
      finish
      exit 1
    fi
    exec 3<"$temp/ignored"
  fi
  for ((i = 0; i < ${#SOURCES[@]}; i++)); do
    if [[ "$git_available" = 1 ]]; then
      if ! { IFS= read -r -d '' origin && IFS= read -r -d '' line &&
          IFS= read -r -d '' pattern && IFS= read -r -d '' ignored_path; } <&3; then
        failure "incomplete Git ignore output"
        break
      fi
      if [[ -n "$pattern" && "$pattern" != !* ]]; then continue; fi
    fi
    link_file "${SOURCES[i]}" || failure "link ${SOURCES[i]}"
  done
  [[ "$git_available" != 1 ]] || exec 3<&-
fi
finish
