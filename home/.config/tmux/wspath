#! /usr/bin/env zsh

# load named directories into hash table
[[ -e ~/.named-dirs.zsh ]] && . ~/.named-dirs.zsh

# Quoting prevents contracted aliases from expanding back into absolute paths.
abrvdir="${(D)${~1}}"
dirarry=("${(@s:/:)${abrvdir}}")

trees=(🌲 🌳 🌴 🪾 🎄 🎋)
integer tree_hash=0 char_code worktree_index=0 anchor_index=0 tail_index=0 i
display=()

for (( i = 1; i <= $#dirarry; i++ )); do
  if [[ ${dirarry[i]} == .worktrees ]]; then
    worktree_index=$i
    break
  fi
done

if (( worktree_index )); then
  # A path-derived choice keeps tmux refreshes from changing the displayed tree.
  for char in ${(s::)1}; do
    printf -v char_code '%d' "'$char"
    (( tree_hash = (tree_hash * 31 + char_code) % 2147483647 ))
  done
  tree=${trees[$(( tree_hash % $#trees + 1 ))]}
  dirarry[worktree_index]=$tree
fi

# Short contracted paths retain context that anchoring would discard.
if (( $#dirarry <= 3 )); then
  print -r -- "${(j:/:)dirarry}"
  exit
fi

if (( worktree_index )); then
  anchor_index=$(( worktree_index - 1 ))
  (( anchor_index < 1 )) && anchor_index=1
  display=("$tree")
  (( worktree_index > 1 )) && display=("${dirarry[anchor_index]}" "$tree")
  tail_index=$(( worktree_index + 1 ))
elif repo_root=$(git -C "${~1}" rev-parse --show-toplevel 2>/dev/null); then
  input_path=${~1}
  input_path=${input_path:A}
  repo_root=${repo_root:A}
  repo_suffix=${input_path#"$repo_root"}
  suffix_parts=()
  [[ -n $repo_suffix ]] && suffix_parts=("${(@s:/:)${repo_suffix#/}}")
  anchor_index=$(( $#dirarry - $#suffix_parts ))
  # An alias inside the repository can hide its root and part of its suffix.
  (( anchor_index < 1 )) && anchor_index=1
  display=("${dirarry[anchor_index]}")
  tail_index=$(( anchor_index + 1 ))
fi

if (( anchor_index )); then
  if (( $#dirarry - tail_index + 1 > 2 )); then
    display+=(…)
    tail_index=$(( $#dirarry - 1 ))
  fi
  if (( tail_index <= $#dirarry )); then
    display+=("${(@)dirarry[tail_index,-1]}")
  fi
  print -r -- "${(j:/:)display}"
  exit
fi

print -r -- "${dirarry[1]}/…/${(j:/:)dirarry[-2,-1]}"
exit

