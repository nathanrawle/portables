#!/usr/bin/env bash

set -euo pipefail

pane="$1"
direction="$2"
case "$direction" in
  left|right|up|down|equalize) ;;
  *) printf 'Unknown pane direction: %s\n' "$direction" >&2; exit 2 ;;
esac

read -r window zoomed original_hint < <(
  tmux display-message -p -t "$pane" '#{window_id} #{window_zoomed_flag} #{@reshape_origin}'
)
original_layout="$(tmux display-message -p -t "$pane" '#{window_layout}')"
command -v jq >/dev/null 2>&1 || {
  printf 'reshape-pane: jq is required for tmux JSON layouts\n' >&2
  exit 2
}
if ! rows="$(jq -er '
  def integer: type == "number" and . == floor;
  def cell:
    type == "object"
    and (.w | integer and . >= 1) and (.h | integer and . >= 1)
    and (.x | integer) and (.y | integer)
    and (if .t == "p" then
      (has("c") | not) and (.I | type == "string" and test("^%[0-9]+$"))
      and (.i | integer and . >= 0)
      and (if has("z") then (.z | integer and . >= 0) else true end)
      and (if has("a") then (.a | type == "boolean") else true end)
      and (if has("l") then (.l | integer and . >= 0) else true end)
    elif .t == "h" or .t == "v" then
      (.c | type == "array" and length > 0 and all(.[]; cell))
      and (. as $node | [.c[] | select(has("z") | not)] as $tiles
        | ($tiles | length) > 0
        and (if .t == "h" then
          ($tiles | map(.w) | add) + ($tiles | length) - 1 == .w
          and all($tiles[]; .h == $node.h)
        else
          ($tiles | map(.h) | add) + ($tiles | length) - 1 == .h
          and all($tiles[]; .w == $node.w)
        end))
    else false end);
  def walk_cells($path; $parent):
    if .t == "p" and has("z") then empty
    else
      ([$path, $parent, .t, .w, .h, (.I // "-"), (.i // -1)] | @tsv),
      (.c // [] | to_entries[] | .key as $key
        | .value | walk_cells($path + "." + ($key | tostring); $path))
    end;
  select(.V == 2 and (.L | cell))
  | [.. | objects | select(.t == "p")] as $panes
  | select(($panes | map(.I) | unique | length) == ($panes | length))
  | select(($panes | map(.i) | unique | length) == ($panes | length))
  | .L | walk_cells("r"; "-")
' <<<"$original_layout" 2>/dev/null)"; then
  printf 'reshape-pane: invalid or unsupported tmux JSON layout\n' >&2
  exit 2
fi
if [[ "$(tmux display-message -p -t "$pane" '#{pane_floating_flag}')" == 1 ]]; then
  printf 'reshape-pane: use move-pane to move a floating pane\n' >&2
  exit 2
fi
original_order="$(tmux list-panes -t "$window" -F $'#{pane_id}\t#{pane_index}')"
layout_order="$(jq -r '[.. | objects | select(.t == "p")] | sort_by(.i)[] | [.I, .i] | @tsv' <<<"$original_layout")"
if [[ "$layout_order" != "$original_order" ]]; then
  printf 'reshape-pane: layout does not match current panes\n' >&2
  exit 2
fi

transformation="$(awk -F '\t' -v active="${pane#%}" -v direction="$direction" -v hint="$original_hint" '
function invalid() { print "Invalid pane layout" > "/dev/stderr"; exit 1 }
function position(node,    owner, i) {
  owner = parent[node]
  for (i = 1; i <= count[owner]; i++) if (child[owner, i] == node) return i
  invalid()
}
function replace(node, replacement,    owner, slot) {
  owner = parent[node]
  if (owner) { slot = position(node); child[owner, slot] = replacement }
  else root = replacement
  parent[replacement] = owner
}
function detach(node,    owner, slot, i) {
  owner = parent[node]; slot = position(node)
  for (i = slot; i < count[owner]; i++) child[owner, i] = child[owner, i + 1]
  count[owner]--
  parent[node] = 0
}
function insert(owner, slot, node,    i) {
  for (i = count[owner]; i >= slot; i--) child[owner, i + 1] = child[owner, i]
  child[owner, slot] = node; count[owner]++; parent[node] = owner
}
function wrap(target, orientation, first, second,    node) {
  node = ++nodes; kind[node] = orientation
  width[node] = width[target]; height[node] = height[target]
  replace(target, node)
  count[node] = 2; child[node, 1] = first; child[node, 2] = second
  parent[first] = node; parent[second] = node
}
function beside(target, node, before, orientation,    owner, slot) {
  owner = parent[target]
  if (owner && kind[owner] == orientation) {
    slot = position(target) + (before ? 0 : 1)
    insert(owner, slot, node)
  } else if (before) wrap(target, orientation, node, target)
  else wrap(target, orientation, target, node)
}
function descend(node, reverse,    slot) {
  while (kind[node]) {
    slot = kind[node] == perpendicular || reverse ? count[node] : 1
    node = child[node, slot]
  }
  return node
}
function reachable(group, node, orientation, reverse,    owner, edge) {
  while (node && node != group) {
    owner = parent[node]
    if (kind[owner] == orientation) {
      edge = reverse ? count[owner] : 1
      if (position(node) != edge) return 0
    }
    node = owner
  }
  return node == group
}
function valid_origin(    fields, orientation, reverse, owner, slot, group) {
  if (split(hint, fields, " ") != 2 || fields[2] !~ /^%[0-9]+$/) return 0
  if (fields[1] !~ /^(left|right|up|down)$/) return 0
  origin_direction = fields[1]; origin = leaf[substr(fields[2], 2)]
  if (!origin || origin == source) return 0
  orientation = origin_direction == "left" || origin_direction == "right" ? "{" : "["
  reverse = origin_direction == "left" || origin_direction == "up"
  owner = parent[source]
  if (kind[owner] != orientation) return 0
  slot = position(source) + (reverse ? -1 : 1)
  if (slot < 1 || slot > count[owner]) return 0
  group = child[owner, slot]
  return reachable(group, origin, orientation, reverse)
}
function unchanged() { print hint_valid ? hint : ""; exit }
function lift(container,    owner, slot, anchor, reverse_direction) {
  owner = parent[source]; slot = position(source)
  anchor = child[owner, slot > 1 ? slot - 1 : slot + 1]
  anchor = descend(anchor, !backwards)
  reverse_direction = direction == "left" ? "right" : direction == "right" ? "left" : direction == "up" ? "down" : "up"
  next_hint = reverse_direction " %" id[anchor]
  detach(source)
  beside(container, source, backwards, axis)
}
function normalize(node,    i, j, descendant, size, replacement) {
  if (!kind[node]) return node
  size = count[node]; count[node] = 0
  for (i = 1; i <= size; i++) saved[node, i] = child[node, i]
  for (i = 1; i <= size; i++) {
    descendant = normalize(saved[node, i])
    if (kind[descendant] == kind[node]) {
      for (j = 1; j <= count[descendant]; j++) insert(node, count[node] + 1, child[descendant, j])
    } else insert(node, count[node] + 1, descendant)
  }
  if (count[node] == 1) {
    replacement = child[node, 1]; parent[replacement] = parent[node]
    return replacement
  }
  if (count[node] == 0) invalid()
  return node
}
function measure(node,    i, descendant, w, h, mw, mh) {
  if (!kind[node]) { minimum_width[node] = 2; minimum_height[node] = 2; return }
  w = 0; h = 0; mw = 0; mh = 0
  for (i = 1; i <= count[node]; i++) {
    descendant = child[node, i]; measure(descendant)
    if (kind[node] == "{") {
      w += width[descendant] + (i > 1)
      mw += minimum_width[descendant] + (i > 1)
      if (height[descendant] > h) h = height[descendant]
      if (minimum_height[descendant] > mh) mh = minimum_height[descendant]
    } else {
      h += height[descendant] + (i > 1)
      mh += minimum_height[descendant] + (i > 1)
      if (width[descendant] > w) w = width[descendant]
      if (minimum_width[descendant] > mw) mw = minimum_width[descendant]
    }
  }
  width[node] = w; height[node] = h
  minimum_width[node] = mw; minimum_height[node] = mh
}
function render(node, w, h, x, y,    out, i, descendant, available, total, amount, used, weight, required, minimum, balanced, remainder) {
  if (w < minimum_width[node] || h < minimum_height[node]) invalid()
  width[node] = w; height[node] = h
  out = "{\"w\":" w ",\"h\":" h ",\"x\":" x ",\"y\":" y
  if (!kind[node]) {
    return out ",\"t\":\"p\",\"I\":\"%" id[node] "\",\"i\":" pane_index[node] "}"
  }
  available = (kind[node] == "{" ? w : h) - count[node] + 1
  balanced = equalized[node]
  for (i = 1; i <= count[node]; i++) {
    descendant = child[node, i]
    minimum = kind[node] == "{" ? minimum_width[descendant] : minimum_height[descendant]
    if (minimum > int(available / count[node])) balanced = 0
  }
  total = 0; required = 0
  for (i = 1; i <= count[node]; i++) {
    descendant = child[node, i]
    minimum = kind[node] == "{" ? minimum_width[descendant] : minimum_height[descendant]
    required += minimum
    weight = equalized[node] ? 1 : (kind[node] == "{" ? width[descendant] : height[descendant]) - minimum
    if (weight > 0) total += weight
  }
  used = 0; out = out ",\"t\":\"" (kind[node] == "{" ? "h" : "v") "\",\"c\":["
  remainder = available % count[node]
  for (i = 1; i <= count[node]; i++) {
    descendant = child[node, i]
    minimum = kind[node] == "{" ? minimum_width[descendant] : minimum_height[descendant]
    weight = equalized[node] ? 1 : (kind[node] == "{" ? width[descendant] : height[descendant]) - minimum
    if (weight < 0) weight = 0
    # Reserving branch minima prevents rounding from rejecting layouts that fit.
    amount = minimum
    if (total) amount += int((available - required) * weight / total)
    else amount += int((available - required) / count[node])
    if (balanced) amount = int(available / count[node]) + (i <= remainder)
    if (i == count[node]) amount = available - used
    if (i > 1) out = out ","
    if (kind[node] == "{") out = out render(descendant, amount, h, x + used + i - 1, y)
    else out = out render(descendant, w, amount, x, y + used + i - 1)
    used += amount
  }
  return out "]}"
}
function equalize_once(    owner, i, before, after) {
  owner = parent[source]
  while (owner) {
    before = ""
    for (i = 1; i <= count[owner]; i++)
      before = before ":" (kind[owner] == "{" ? width[child[owner, i]] : height[child[owner, i]])
    # Nested containers must share the allocation instead of being skipped as in tmux 3.8.
    equalized[owner] = 1
    body = render(root, root_width, root_height, 0, 0)
    after = ""
    for (i = 1; i <= count[owner]; i++)
      after = after ":" (kind[owner] == "{" ? width[child[owner, i]] : height[child[owner, i]])
    if (before != after) return
    owner = parent[owner]
  }
}
{
  node = ++nodes; lookup[$1] = node
  parent[node] = $2 == "-" ? 0 : lookup[$2]
  width[node] = $4; height[node] = $5
  if (parent[node]) child[parent[node], ++count[parent[node]]] = node
  else root = node
  if ($3 == "p") {
    id[node] = substr($6, 2) + 0; pane_index[node] = $7
    leaf[id[node]] = node
    if (id[node] == active) source = node
  } else kind[node] = $3 == "h" ? "{" : "["
}
END {
  if (!root || !source) invalid()
  for (node = 1; node <= nodes; node++) {
    if (kind[node] && !count[node]) invalid()
  }
  root_width = width[root]; root_height = height[root]
  axis = direction == "left" || direction == "right" ? "{" : "["
  perpendicular = axis == "{" ? "[" : "{"
  backwards = direction == "left" || direction == "up"
  root = normalize(root)
  hint_valid = valid_origin()
  owner = parent[source]
  if (!owner) unchanged()
  if (direction == "equalize") {
    next_hint = hint_valid ? hint : ""
  } else if (kind[owner] != axis) {
    # Pairing locally avoids lifting across unrelated sibling regions.
    if (count[owner] > 2) {
      slot = position(source)
      neighbour = slot > 1 ? slot - 1 : slot + 1
      target = child[owner, neighbour]
      detach(source)
      beside(target, source, backwards, axis)
    } else lift(owner)
  }
  else {
    slot = position(source); neighbour = slot + (backwards ? -1 : 1)
    if (neighbour < 1 || neighbour > count[owner]) {
      container = parent[owner]
      while (container && kind[container] != perpendicular) container = parent[container]
      if (!container) unchanged()
      lift(container)
    } else {
      target = child[owner, neighbour]
      if (kind[target]) {
        if (hint_valid && direction == origin_direction) target = origin
        else target = descend(target, backwards)
        detach(source)
        beside(target, source, !backwards, axis)
      } else {
        detach(source)
        wrap(target, perpendicular, target, source)
      }
    }
  }
  root = normalize(root)
  measure(root)
  body = render(root, root_width, root_height, 0, 0)
  equalize_once()
  if (direction != "equalize") equalize_once()
  print next_hint
  print body
}' <<<"$rows")"
next_hint="${transformation%%$'\n'*}"
if [[ "$transformation" != *$'\n'* ]]; then
  if [[ "$next_hint" != "$original_hint" ]]; then tmux set-option -pu -t "$pane" @reshape_origin; fi
  exit 0
fi
body="${transformation#*$'\n'}"
new_layout="$(jq -cn --argjson original "$original_layout" --argjson tiled "$body" '
  ($original | [.. | objects | select(.t == "p")]) as $panes
  | ($panes | map(select(has("z")))) as $floating
  | def metadata:
      if .t == "p" then
        .I as $id | . + ($panes[] | select(.I == $id) | {a, l} | with_entries(select(.value != null)))
      else .c |= map(metadata) end;
  ($tiled | metadata) as $tree
  | {V: 2, L: (if ($floating | length) == 0 then $tree
      elif $tree.t == "p" then
        {t: "h", w: $tree.w, h: $tree.h, x: 0, y: 0, c: ([$tree] + $floating)}
      else $tree | .c += $floating end)}
')"
if [[ "$(tmux display-message -p -t "$pane" '#{window_layout}')" != "$original_layout" ]]; then
  printf 'reshape-pane: layout changed before application\n' >&2
  exit 1
fi

restore_layout() {
  local status=$?
  trap - EXIT
  if [[ "$status" -ne 0 ]]; then
    if ! tmux select-layout -t "$window" "$original_layout"; then
      printf 'reshape-pane: could not restore the original layout\n' >&2
    fi
    tmux select-pane -t "$pane" || true
    if [[ "$zoomed" -eq 1 ]]; then tmux resize-pane -Z -t "$pane" || true; fi
    if [[ -n "$original_hint" ]]; then
      tmux set-option -p -t "$pane" @reshape_origin "$original_hint" || true
    else tmux set-option -pu -t "$pane" @reshape_origin || true; fi
  fi
  exit "$status"
}
trap restore_layout EXIT
[[ "$zoomed" -eq 0 ]] || tmux resize-pane -Z -t "$pane"
tmux select-layout -t "$window" "$new_layout"
tmux select-pane -t "$pane"
if [[ "$next_hint" != "$original_hint" ]]; then
  if [[ -n "$next_hint" ]]; then
    tmux set-option -p -t "$pane" @reshape_origin "$next_hint"
  else
    tmux set-option -pu -t "$pane" @reshape_origin
  fi
fi
