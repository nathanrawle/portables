#!/usr/bin/env bash

set -euo pipefail

pane="$1"
direction="$2"
case "$direction" in
  left|right) axis=h; neighbours=(up-of down-of) ;;
  up|down) axis=v; neighbours=(left-of right-of) ;;
  *) printf 'Unknown pane direction: %s\n' "$direction" >&2; exit 2 ;;
esac

read -r window count zoomed < <(
  tmux display-message -p -t "$pane" '#{window_id} #{window_panes} #{window_zoomed_flag}'
)
[[ "$count" -gt 1 ]] || exit 0
[[ "$zoomed" -eq 0 ]] || tmux resize-pane -Z -t "$pane"
tmux select-pane -t "$pane"

peer=
for neighbour in "${neighbours[@]}"; do
  peer="$(tmux display-message -p -t "$window.{$neighbour}" '#{pane_id}' 2>/dev/null || true)"
  [[ -z "$peer" || "$peer" == "$pane" ]] || break
  peer=
done

before=
case "$direction" in left|up) before=b ;; esac
if [[ -n "$peer" ]]; then
  read -r x y width height window_width window_height < <(
    tmux display-message -p -t "$pane" \
      '#{pane_left} #{pane_top} #{pane_width} #{pane_height} #{window_width} #{window_height}'
  )
  edge=
  if [[ "$axis" == h ]]; then
    (( 2 * x + width >= window_width )) || edge=b
  else
    (( 2 * y + height >= window_height )) || edge=b
  fi
  # Promoting the peer first works for grids built with either rows or columns first.
  tmux move-pane "-${axis}f${edge}" -s "$peer" -t "$pane"
  tmux move-pane "-${axis}${before}" -s "$pane" -t "$peer"
else
  target="$(tmux display-message -p -t "$window.{next}" '#{pane_id}')"
  tmux move-pane "-${axis}f${before}" -s "$pane" -t "$target"
fi

tmux select-pane -t "$pane"
tmux select-layout -E -t "$pane"
tmux select-layout -E -t "$pane"
