#!/usr/bin/env zsh

emulate -L zsh
setopt pipefail

local -a _taw_shell_cmds _taw_positionals
local _taw_project_arg _taw_project_picker_requested _taw_agent_cmd _taw_editor_cmd _taw_named_branch
local _taw_agent_arg_provided _taw_editor_arg_provided _taw_agent_enabled _taw_created_repo_branch_applied _taw_debug
local _taw_agent_env_override _taw_peer _taw_force _taw_current_session_id _taw_convert
local _taw_worktree_arg _taw_base_ref _taw_window_dir _taw_window_name
local _taw_project_dir _taw_git_dir _taw_project_kind _taw_is_bare
local _taw_selected_worktree_dir
local _taw_session_name _taw_session_target _taw_project_name _taw_project_session_name _taw_project_session_target
local _taw_default_branch_result _taw_default_base_ref
local _taw_branch_target_name _taw_branch_target_ref
local _taw_picker_kind _taw_picker_branch _taw_picker_ref _taw_picker_path

_taw_shell_cmds=()
_taw_positionals=()
_taw_project_arg=
_taw_project_picker_requested=false
_taw_agent_cmd=codex
_taw_editor_cmd=
_taw_named_branch=
_taw_agent_arg_provided=false
_taw_editor_arg_provided=false
_taw_agent_enabled=true
_taw_created_repo_branch_applied=false
_taw_debug=false
_taw_agent_env_override=false
_taw_peer=false
_taw_force=false
_taw_current_session_id=
_taw_convert=false

_taw_die() {
  print -u2 -- "taw: $*"
  return 1
}

_taw_prompt() {
  local _taw_reply
  read "_taw_reply?$1" || return 1
  print -r -- "$_taw_reply"
}

_taw_prompt_project() {
  local _taw_prompt_text="$1" _taw_key _taw_rest _taw_reply

  if [[ -t 0 && -t 1 ]]; then
    IFS= read -r -k 1 "_taw_key?$_taw_prompt_text" || return 1
    case "$_taw_key" in
      $'\e')
        print
        return 130
        ;;
      $'\n'|$'\r')
        print
        return 0
        ;;
      *)
        print -n -- "$_taw_key"
        IFS= read -r _taw_rest || return 1
        print -r -- "$_taw_key$_taw_rest"
        ;;
    esac
    return
  fi

  _taw_reply="$(_taw_prompt "$_taw_prompt_text")" || return 1
  [[ "$_taw_reply" == $'\e' ]] && return 130
  print -r -- "$_taw_reply"
}

_taw_confirm() {
  local _taw_reply
  read "_taw_reply?$1 [y/N] " || return 1
  case "${_taw_reply:l}" in
    y|yes) return 0 ;;
    *) return 1 ;;
  esac
}

_taw_trim_whitespace() {
  local _taw_value="$1"

  _taw_value="${_taw_value#"${_taw_value%%[![:space:]]*}"}"
  _taw_value="${_taw_value%"${_taw_value##*[![:space:]]}"}"
  print -r -- "$_taw_value"
}

_taw_debug_dump() {
  [[ "$_taw_debug" == true ]] || return 0

  print -u2 -r -- "taw debug: $1"
  print -u2 -r -- "_taw_project_arg='$_taw_project_arg'"
  print -u2 -r -- "_taw_project_picker_requested=$_taw_project_picker_requested"
  print -u2 -r -- "_taw_agent_cmd=$_taw_agent_cmd"
  print -u2 -r -- "_taw_agent_enabled=$_taw_agent_enabled"
  print -u2 -r -- "_taw_editor_cmd=$_taw_editor_cmd"
  print -u2 -r -- "_taw_named_branch='$_taw_named_branch'"
  print -u2 -r -- "_taw_agent_arg_provided=$_taw_agent_arg_provided"
  print -u2 -r -- "_taw_editor_arg_provided=$_taw_editor_arg_provided"
  print -u2 -r -- "_taw_created_repo_branch_applied=$_taw_created_repo_branch_applied"
  print -u2 -r -- "_taw_peer=$_taw_peer"
  print -u2 -r -- "_taw_force=$_taw_force"
  print -u2 -r -- "_taw_current_session_id='$_taw_current_session_id'"
  print -u2 -r -- "_taw_worktree_arg='$_taw_worktree_arg'"
  print -u2 -r -- "_taw_base_ref='$_taw_base_ref'"
  print -u2 -r -- "_taw_window_dir='$_taw_window_dir'"
  print -u2 -r -- "_taw_window_name='$_taw_window_name'"
  print -u2 -r -- "_taw_project_dir=$_taw_project_dir"
  print -u2 -r -- "_taw_git_dir=$_taw_git_dir"
  print -u2 -r -- "_taw_project_kind=$_taw_project_kind"
  print -u2 -r -- "_taw_is_bare=$_taw_is_bare"
  print -u2 -r -- "_taw_selected_worktree_dir='$_taw_selected_worktree_dir'"
  print -u2 -r -- "_taw_session_name='$_taw_session_name'"
  print -u2 -r -- "_taw_session_target='$_taw_session_target'"
  print -u2 -r -- "_taw_project_name='$_taw_project_name'"
  print -u2 -r -- "_taw_project_session_name='$_taw_project_session_name'"
  print -u2 -r -- "_taw_project_session_target='$_taw_project_session_target'"
  print -u2 -r -- "_taw_default_branch_result='$_taw_default_branch_result'"
  print -u2 -r -- "_taw_default_base_ref='$_taw_default_base_ref'"
  print -u2 -r -- "_taw_picker_kind='$_taw_picker_kind'"
  print -u2 -r -- "_taw_picker_branch='$_taw_picker_branch'"
  print -u2 -r -- "_taw_picker_ref='$_taw_picker_ref'"
  print -u2 -r -- "_taw_picker_path='$_taw_picker_path'"
}

_taw_is_url() {
  [[ "$1" == http://* || "$1" == https://* || "$1" == git@*:* || "$1" == ssh://* ]]
}

_taw_is_bare_git_dir() {
  local _taw_candidate="$1" _taw_bare _taw_git

  [[ -d "$_taw_candidate" ]] || return 1
  _taw_candidate="${_taw_candidate:A}"
  _taw_bare="$(git -C "$_taw_candidate" rev-parse --is-bare-repository 2>/dev/null)" || return 1
  [[ "$_taw_bare" == true ]] || return 1
  _taw_git="$(git -C "$_taw_candidate" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || return 1
  [[ "${_taw_git:A}" == "$_taw_candidate" ]]
}

_taw_set_normal_project() {
  local _taw_project_root="$1" _taw_git_root="$2"

  _taw_project_dir="${_taw_project_root:A}"
  _taw_git_dir="${_taw_git_root:A}"
  _taw_project_kind=normal
  _taw_is_bare=false
}

_taw_project_dir_for_bare_git_dir() {
  local _taw_bare_git_dir="${1:A}" _taw_fallback="${2:-}" _taw_name

  _taw_name="${_taw_bare_git_dir:t}"
  if [[ "$_taw_name" == .* ]]; then
    print -r -- "${_taw_bare_git_dir:h}"
  elif [[ "$_taw_name" == *.git ]]; then
    print -r -- "${_taw_bare_git_dir:h}/${_taw_name%.git}"
  elif [[ -n "$_taw_fallback" ]]; then
    print -r -- "${_taw_fallback:A}"
  else
    print -r -- "$_taw_bare_git_dir"
  fi
}

_taw_set_bare_project() {
  local _taw_bare_git_dir="$1" _taw_fallback="${2:-}"

  _taw_git_dir="${_taw_bare_git_dir:A}"
  _taw_project_dir="$(_taw_project_dir_for_bare_git_dir "$_taw_git_dir" "$_taw_fallback")" || return 1
  _taw_project_kind=bare
  _taw_is_bare=true
}

_taw_set_plain_project() {
  local _taw_project_root="$1"

  _taw_project_dir="${_taw_project_root:A}"
  _taw_git_dir=
  _taw_project_kind=plain
  _taw_is_bare=false
}

_taw_abs_path() {
  local _taw_path="$1"
  local _taw_cwd

  _taw_cwd="$(pwd -P)" || return 1
  if [[ "$_taw_path" == /* ]]; then
    print -r -- "${_taw_path:A}"
  else
    print -r -- "$_taw_cwd/$_taw_path"
  fi
}

_taw_bare_worktree_input_has_dot_segment() {
  local _taw_input="$1" _taw_segment
  local -a _taw_segments

  _taw_segments=( "${(@s:/:)_taw_input}" )
  for _taw_segment in "${_taw_segments[@]}"; do
    case "$_taw_segment" in
      .|..) return 0 ;;
    esac
  done

  return 1
}

_taw_validate_relative_bare_worktree_input() {
  local _taw_input="$1"

  [[ -n "$_taw_input" ]] || {
    _taw_die "invalid bare worktree path: $_taw_input"
    return 1
  }
  if [[ "$_taw_input" == /* ]] || _taw_bare_worktree_input_has_dot_segment "$_taw_input"; then
    _taw_die "invalid bare worktree path: $_taw_input"
    return 1
  fi
}

_taw_classify_existing_path() {
  local _taw_start="$1" _taw_inside _taw_top _taw_common _taw_child

  [[ -d "$_taw_start" ]] || return 1
  _taw_start="${_taw_start:A}"

  _taw_inside="$(git -C "$_taw_start" rev-parse --is-inside-work-tree 2>/dev/null)" || _taw_inside=
  if [[ "$_taw_inside" == true ]]; then
    _taw_top="$(git -C "$_taw_start" rev-parse --show-toplevel 2>/dev/null)" || return 1
    _taw_top="${_taw_top:A}"
    _taw_common="$(git -C "$_taw_top" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
    _taw_common="${_taw_common:A}"

    if _taw_is_bare_git_dir "$_taw_common"; then
      _taw_set_bare_project "$_taw_common" "${_taw_common:h}"
      _taw_selected_worktree_dir="$_taw_top"
    else
      _taw_set_normal_project "$_taw_top" "$_taw_common"
    fi
    return 0
  fi

  if _taw_is_bare_git_dir "$_taw_start"; then
    _taw_set_bare_project "$_taw_start" "${_taw_start:h}"
    return 0
  fi

  for _taw_child in "$_taw_start"/.git "$_taw_start"/.bare; do
    if _taw_is_bare_git_dir "$_taw_child"; then
      _taw_set_bare_project "$_taw_child" "$_taw_start"
      return 0
    fi
  done

  _taw_set_plain_project "$_taw_start"
  return 0
}

_taw_detect_current_project() {
  local _taw_saved_project_dir="$_taw_project_dir" _taw_saved_git_dir="$_taw_git_dir"
  local _taw_saved_project_kind="$_taw_project_kind" _taw_saved_is_bare="$_taw_is_bare"
  local _taw_saved_selected_worktree_dir="$_taw_selected_worktree_dir"

  _taw_classify_existing_path "$PWD" || return 1
  [[ "$_taw_project_kind" != plain ]] && return 0

  _taw_project_dir="$_taw_saved_project_dir"
  _taw_git_dir="$_taw_saved_git_dir"
  _taw_project_kind="$_taw_saved_project_kind"
  _taw_is_bare="$_taw_saved_is_bare"
  _taw_selected_worktree_dir="$_taw_saved_selected_worktree_dir"
  return 1
}

_taw_clone_prompted_repo() {
  local _taw_source="$1" _taw_dest _taw_clone_type
  local -a _taw_dest_entries

  _taw_dest="$(_taw_prompt "Clone destination: ")" || return 1
  [[ -n "$_taw_dest" ]] || _taw_die "clone destination is required" || return 1
  _taw_dest="$(_taw_abs_path "$_taw_dest")"

  _taw_clone_type="$(_taw_prompt "Clone type [bare/normal] (bare): ")" || return 1
  _taw_clone_type="${_taw_clone_type:l}"
  [[ -n "$_taw_clone_type" ]] || _taw_clone_type=bare

  case "$_taw_clone_type" in
    bare)
      if [[ -e "$_taw_dest/.git" ]]; then
        _taw_die "destination already has .git: $_taw_dest"
        return 1
      fi
      _taw_dest_entries=( "$_taw_dest"/*(N) "$_taw_dest"/.[!.]*(N) "$_taw_dest"/..?*(N) )
      if [[ -e "$_taw_dest" && ${#_taw_dest_entries[@]} -gt 0 ]]; then
        _taw_die "bare clone destination must be empty: $_taw_dest"
        return 1
      fi
      mkdir -p -- "$_taw_dest" || return 1
      git clone --bare "$_taw_source" "$_taw_dest/.git" || return 1
      ;;
    normal)
      git clone "$_taw_source" "$_taw_dest" || return 1
      ;;
    *)
      _taw_die "clone type must be bare or normal"
      return 1
      ;;
  esac

  print -r -- "$_taw_dest"
}

_taw_prompt_create_project() {
  local _taw_target_path="$1" _taw_kind _taw_repo_branch _taw_worktree_input _taw_worktree_path _taw_worktree_branch

  _taw_confirm "Create project at $_taw_target_path?" || return 1

  _taw_kind="$(_taw_prompt "Create kind [plain/repo/bare] (repo): ")" || return 1
  _taw_kind="${_taw_kind:l}"
  [[ -n "$_taw_kind" ]] || _taw_kind=repo
  case "$_taw_kind" in
    plain|repo|bare) ;;
    *)
      _taw_die "create kind must be plain, repo, or bare"
      return 1
      ;;
  esac

  case "$_taw_kind" in
    plain)
      if [[ -n "$_taw_named_branch" || ${#_taw_positionals[@]} -gt 0 ]]; then
        _taw_die "plain projects do not accept operands"
        return 1
      fi
      mkdir -p -- "$_taw_target_path" || return 1
      _taw_set_plain_project "$_taw_target_path"
      ;;
    repo)
      if [[ -n "$_taw_named_branch" && ${#_taw_positionals[@]} -gt 0 ]] || (( ${#_taw_positionals[@]} > 1 )); then
        _taw_die "repo projects do not accept two pending operands"
        return 1
      fi
      if [[ -n "$_taw_named_branch" ]]; then
        _taw_repo_branch="$_taw_named_branch"
      elif (( ${#_taw_positionals[@]} > 0 )); then
        _taw_repo_branch="${_taw_positionals[1]}"
      fi
      if [[ -n "$_taw_repo_branch" ]]; then
        git check-ref-format --branch "$_taw_repo_branch" >/dev/null 2>&1 || {
          _taw_die "invalid repo branch: $_taw_repo_branch"
          return 1
        }
      fi
      mkdir -p -- "$_taw_target_path" || return 1
      git -C "$_taw_target_path" init || return 1
      if [[ -n "$_taw_repo_branch" ]]; then
        git -C "$_taw_target_path" symbolic-ref HEAD "refs/heads/$_taw_repo_branch" || return 1
        _taw_created_repo_branch_applied=true
      fi
      _taw_set_normal_project "$_taw_target_path" "$_taw_target_path/.git"
      _taw_named_branch=
      _taw_positionals=()
      ;;
    bare)
      if [[ -n "$_taw_named_branch" && ${#_taw_positionals[@]} -gt 0 ]] || (( ${#_taw_positionals[@]} > 1 )); then
        _taw_die "bare projects do not accept two pending operands"
        return 1
      fi
      if [[ -n "$_taw_named_branch" ]]; then
        _taw_worktree_input="$_taw_named_branch"
      elif (( ${#_taw_positionals[@]} > 0 )); then
        _taw_worktree_input="${_taw_positionals[1]}"
      fi
      if [[ -n "$_taw_worktree_input" ]]; then
        _taw_validate_relative_bare_worktree_input "$_taw_worktree_input" || return 1
        _taw_worktree_path="${_taw_target_path:A}/$_taw_worktree_input"
        _taw_worktree_branch="$_taw_worktree_input"
      fi
      if [[ -n "$_taw_worktree_branch" ]]; then
        git check-ref-format --branch "$_taw_worktree_branch" >/dev/null 2>&1 || {
          _taw_die "invalid bare worktree branch: $_taw_worktree_branch"
          return 1
        }
      fi
      mkdir -p -- "$_taw_target_path" || return 1
      git init --bare "$_taw_target_path/.git" || return 1
      _taw_set_bare_project "$_taw_target_path/.git" "$_taw_target_path" || return 1
      if [[ -n "$_taw_worktree_branch" ]]; then
        _taw_prepare_orphan_worktree "$_taw_worktree_path" "$_taw_worktree_branch" || return 1
        _taw_selected_worktree_dir="$_taw_worktree_path"
      else
        _taw_default_bare_target || {
          _taw_die "could not determine default branch for bare project"
          return 1
        }
        _taw_worktree_branch="$_taw_default_branch_result"
        git check-ref-format --branch "$_taw_worktree_branch" >/dev/null 2>&1 || {
          _taw_die "invalid bare worktree branch: $_taw_worktree_branch"
          return 1
        }
        _taw_worktree_path="${_taw_target_path:A}/$_taw_worktree_branch"
        _taw_prepare_orphan_worktree "$_taw_worktree_path" "$_taw_worktree_branch" || return 1
        _taw_selected_worktree_dir="$_taw_worktree_path"
      fi
      _taw_named_branch=
      _taw_positionals=()
      ;;
  esac
}

_taw_use_project_path() {
  local _taw_path="$1" _taw_label="$2" _taw_session_name="${3:-}" _taw_session_target="${4:-}" _taw_abs

  [[ -d "$_taw_path" ]] || {
    _taw_die "could not cd to project: $_taw_label"
    return 1
  }
  _taw_abs="${_taw_path:A}"
  _taw_classify_existing_path "$_taw_abs" || return 1
  [[ -z "$_taw_session_name" ]] || _taw_project_session_name="$_taw_session_name"
  [[ -z "$_taw_session_target" ]] || _taw_project_session_target="$_taw_session_target"
}

_taw_resolve_project_from_tmux_exact() {
  local _taw_query="$1" _taw_expected_path="${2:-}" _taw_expected_id="${3:-}"
  local _taw_sessions _taw_line _taw_session_id _taw_session _taw_path _taw_rest
  local _taw_tab=$'\t'

  _taw_sessions="$(tmux list-sessions -F '#{session_id}	#{session_name}	#{session_path}' 2>/dev/null)" || return 1

  for _taw_line in "${(@f)_taw_sessions}"; do
    _taw_session_id="${_taw_line%%${_taw_tab}*}"
    _taw_rest="${_taw_line#*${_taw_tab}}"
    [[ "$_taw_rest" == "$_taw_line" ]] && _taw_rest=
    _taw_session="${_taw_rest%%${_taw_tab}*}"
    _taw_path="${_taw_rest#*${_taw_tab}}"
    [[ "$_taw_path" == "$_taw_rest" ]] && _taw_path=
    [[ "$_taw_session" == "$_taw_query" ]] || continue
    if [[ -n "$_taw_expected_id" && "$_taw_session_id" != "$_taw_expected_id" ]]; then
      return 2
    fi
    [[ -n "$_taw_path" ]] || return 2
    if [[ -n "$_taw_expected_path" && "${_taw_path:A}" != "${_taw_expected_path:A}" ]]; then
      return 2
    fi
    _taw_use_project_path "$_taw_path" "$_taw_path" "$_taw_session" "${_taw_expected_id:-$_taw_session_id}" || return 2
    return 0
  done

  return 1
}

_taw_resolve_project_from_tmux() {
  local _taw_query="$1" _taw_sessions _taw_line _taw_session_id _taw_session _taw_path _taw_rest
  local _taw_tab=$'\t'

  _taw_resolve_project_from_tmux_exact "$_taw_query"
  case $? in
    0) return 0 ;;
    2) return 2 ;;
  esac

  _taw_sessions="$(tmux list-sessions -F '#{session_id}	#{session_name}	#{session_path}' 2>/dev/null)" || return 1

  for _taw_line in "${(@f)_taw_sessions}"; do
    _taw_session_id="${_taw_line%%${_taw_tab}*}"
    _taw_rest="${_taw_line#*${_taw_tab}}"
    [[ "$_taw_rest" == "$_taw_line" ]] && _taw_rest=
    _taw_session="${_taw_rest%%${_taw_tab}*}"
    _taw_path="${_taw_rest#*${_taw_tab}}"
    [[ "$_taw_path" == "$_taw_rest" ]] && _taw_path=
    [[ -n "$_taw_path" && "${_taw_path:t}" == "$_taw_query" ]] || continue
    _taw_use_project_path "$_taw_path" "$_taw_path" "$_taw_session" "$_taw_session_id"
    return
  done

  return 1
}

_taw_tmux_sessionizer_picker_rows() {
  local CONFIG_FILE_NAME="tmux-sessionizer.conf"
  local CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-sessionizer"
  local CONFIG_FILE="$CONFIG_DIR/$CONFIG_FILE_NAME"
  local TS_MAX_DEPTH
  local -a TS_SEARCH_PATHS TS_EXTRA_SEARCH_PATHS TS_SESSION_COMMANDS
  local _taw_current_session _taw_sessions _taw_session_line _taw_session_id _taw_session_name _taw_session_path _taw_session_rest
  local _taw_entry _taw_path _taw_depth
  local _taw_tab=$'\t'

  if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
  fi

  if [[ -f "$CONFIG_FILE_NAME" ]]; then
    source "./$CONFIG_FILE_NAME"
  fi

  [[ ${#TS_SEARCH_PATHS[@]} -gt 0 ]] || TS_SEARCH_PATHS=(~ ~/personal ~/personal/dev/env/.config)
  if (( ${#TS_EXTRA_SEARCH_PATHS[@]} > 0 )); then
    TS_SEARCH_PATHS+=( "${TS_EXTRA_SEARCH_PATHS[@]}" )
  fi

  if [[ -n "${TMUX:-}" ]]; then
    _taw_current_session="$(tmux display-message -p '#S' 2>/dev/null)" || _taw_current_session=
    _taw_sessions="$(tmux list-sessions -F '#{session_id}	#{session_name}	#{session_path}' 2>/dev/null)" || _taw_sessions=
    for _taw_session_line in "${(@f)_taw_sessions}"; do
      _taw_session_id="${_taw_session_line%%${_taw_tab}*}"
      _taw_session_rest="${_taw_session_line#*${_taw_tab}}"
      [[ "$_taw_session_rest" == "$_taw_session_line" ]] && _taw_session_rest=
      _taw_session_name="${_taw_session_rest%%${_taw_tab}*}"
      _taw_session_path="${_taw_session_rest#*${_taw_tab}}"
      [[ "$_taw_session_path" == "$_taw_session_rest" ]] && _taw_session_path=
      [[ "$_taw_session_name" == "$_taw_current_session" ]] && continue
      print -r -- "[TMUX] $_taw_session_name"$'\t'"tmux"$'\t'"$_taw_session_id"$'\t'"$_taw_session_name"$'\t'"$_taw_session_path"
    done
  else
    _taw_sessions="$(tmux list-sessions -F '#{session_id}	#{session_name}	#{session_path}' 2>/dev/null)" || _taw_sessions=
    for _taw_session_line in "${(@f)_taw_sessions}"; do
      _taw_session_id="${_taw_session_line%%${_taw_tab}*}"
      _taw_session_rest="${_taw_session_line#*${_taw_tab}}"
      [[ "$_taw_session_rest" == "$_taw_session_line" ]] && _taw_session_rest=
      _taw_session_name="${_taw_session_rest%%${_taw_tab}*}"
      _taw_session_path="${_taw_session_rest#*${_taw_tab}}"
      [[ "$_taw_session_path" == "$_taw_session_rest" ]] && _taw_session_path=
      print -r -- "[TMUX] $_taw_session_name"$'\t'"tmux"$'\t'"$_taw_session_id"$'\t'"$_taw_session_name"$'\t'"$_taw_session_path"
    done
  fi

  for _taw_entry in "${TS_SEARCH_PATHS[@]}"; do
    if [[ "$_taw_entry" == *:<-> ]]; then
      _taw_path="${_taw_entry%:*}"
      _taw_depth="${_taw_entry##*:}"
    else
      _taw_path="$_taw_entry"
      _taw_depth="${TS_MAX_DEPTH:-1}"
    fi

    [[ -d "$_taw_path" ]] || continue
    find "$_taw_path" -mindepth 1 -maxdepth "$_taw_depth" -path '*/.git' -prune -o -type d -print \
      | while IFS= read -r _taw_found_path; do
        print -r -- "$_taw_found_path"$'\t'"path"$'\t'"$_taw_found_path"
      done
  done
}

_taw_select_project_with_fzf() {
  local _taw_rows _taw_choice _taw_status

  command -v fzf >/dev/null 2>&1 || return 2
  _taw_rows="$(_taw_tmux_sessionizer_picker_rows)" || return 2
  [[ -n "$_taw_rows" ]] || return 2

  _taw_choice="$(print -r -- "$_taw_rows" | fzf --delimiter=$'\t' --with-nth=1 --prompt='taw project> ')"
  _taw_status=$?
  [[ $_taw_status -eq 0 ]] || return "$_taw_status"
  [[ -n "$_taw_choice" ]] || return 1

  print -r -- "${_taw_choice#*$'\t'}"
}

_taw_resolve_project_from_picker() {
  local _taw_input _taw_status _taw_kind _taw_value _taw_tmux_id _taw_tmux_session _taw_tmux_path _taw_tmux_rest

  _taw_input="$(_taw_select_project_with_fzf)"
  _taw_status=$?
  case "$_taw_status" in
    0)
      _taw_kind="${_taw_input%%$'\t'*}"
      _taw_value="${_taw_input#*$'\t'}"
      case "$_taw_kind" in
        path)
          _taw_resolve_project_arg "$_taw_value"
          ;;
        tmux)
          _taw_tmux_id="${_taw_value%%$'\t'*}"
          _taw_tmux_rest="${_taw_value#*$'\t'}"
          [[ "$_taw_tmux_rest" == "$_taw_value" ]] && _taw_tmux_rest=
          _taw_tmux_session="${_taw_tmux_rest%%$'\t'*}"
          _taw_tmux_path="${_taw_tmux_rest#*$'\t'}"
          [[ "$_taw_tmux_path" == "$_taw_tmux_rest" ]] && _taw_tmux_path=
          _taw_resolve_project_from_tmux_exact "$_taw_tmux_session" "$_taw_tmux_path" "$_taw_tmux_id" || {
            _taw_die "could not resolve tmux session: $_taw_tmux_session"
            return 1
          }
          ;;
        *)
          _taw_die "project picker returned an invalid row"
          return 1
          ;;
      esac
      return
      ;;
    130)
      return 130
      ;;
    *)
      _taw_die "project picker requires fzf and at least one project"
      return 1
      ;;
  esac
}

_taw_resolve_project() {
  local _taw_input _taw_status

  if [[ "$_taw_project_picker_requested" == true ]]; then
    if [[ -n "$_taw_project_arg" || -n "$_taw_named_branch" || ${#_taw_positionals[@]} -gt 0 ]]; then
      _taw_die "--pick-project cannot be combined with -p, -b, or positionals"
      return 1
    fi
    _taw_resolve_project_from_picker
    return
  fi

  if [[ "$_taw_peer" == true && -z "$_taw_project_arg" \
    && ${#_taw_positionals[@]} -gt 0 ]]; then
    _taw_project_arg="${_taw_positionals[1]}"
    if (( ${#_taw_positionals[@]} == 2 )); then
      _taw_positionals=( "${_taw_positionals[2]}" )
    else
      _taw_positionals=()
    fi
  fi

  if [[ -z "$_taw_project_arg" ]]; then
    if _taw_detect_current_project; then
      return 0
    fi

    if [[ -n "$_taw_named_branch" ]]; then
      _taw_die "-b cannot be used outside a project"
      return 1
    fi

    case "${#_taw_positionals[@]}" in
      0)
        _taw_input="$(_taw_prompt_project "Project, GitHub URL, or git repository directory (empty opens fzf): ")"
        _taw_status=$?
        case "$_taw_status" in
          0) ;;
          130) return 130 ;;
          *) return 1 ;;
        esac

        if [[ -z "$_taw_input" ]]; then
          _taw_project_picker_requested=true
          _taw_resolve_project_from_picker
          return
        fi

        _taw_project_arg="$_taw_input"
        ;;
      1)
        _taw_project_arg="${_taw_positionals[1]}"
        _taw_positionals=()
        ;;
      2)
        _taw_project_arg="${_taw_positionals[1]}"
        _taw_positionals=( "${_taw_positionals[2]}" )
        ;;
      *)
        _taw_die "expected at most project plus one positional outside a project"
        return 1
        ;;
    esac
  fi

  _taw_resolve_project_arg "$_taw_project_arg"
}

_taw_resolve_project_arg() {
  local _taw_arg="$1" _taw_resolved _taw_projects_candidate _taw_create_target

  if _taw_is_url "$_taw_arg"; then
    _taw_resolved="$(_taw_clone_prompted_repo "$_taw_arg")" || return 1
    _taw_use_project_path "$_taw_resolved" "$_taw_resolved"
    return
  fi

  if [[ -d "$_taw_arg" ]]; then
    _taw_use_project_path "$_taw_arg" "$_taw_arg"
    return
  fi
  [[ ! -e "$_taw_arg" && ! -L "$_taw_arg" ]] || {
    _taw_die "could not cd to project: $_taw_arg"
    return 1
  }

  _taw_create_target="$(_taw_abs_path "$_taw_arg")"
  if [[ "$_taw_arg" != /* && "$_taw_arg" != */* && -n "${PROJECTS_HOME:-}" ]]; then
    _taw_projects_candidate="${PROJECTS_HOME:A}/$_taw_arg"
    if [[ -d "$_taw_projects_candidate" ]]; then
      _taw_use_project_path "$_taw_projects_candidate" "$_taw_projects_candidate"
      return
    fi
    [[ ! -e "$_taw_projects_candidate" && ! -L "$_taw_projects_candidate" ]] || {
      _taw_die "could not cd to project: $_taw_projects_candidate"
      return 1
    }
    _taw_create_target="$_taw_projects_candidate"
  fi

  _taw_resolve_project_from_tmux "$_taw_arg"
  case $? in
    0) return 0 ;;
    2) return 1 ;;
  esac

  _taw_prompt_create_project "$_taw_create_target"
}

_taw_resolve_convert_project() {
  local _taw_arg="$1" _taw_projects_candidate

  if _taw_is_url "$_taw_arg"; then
    _taw_die "--convert requires an existing normal project"
    return 1
  fi

  if [[ -d "$_taw_arg" ]]; then
    _taw_use_project_path "$_taw_arg" "$_taw_arg"
    return
  fi
  [[ ! -e "$_taw_arg" && ! -L "$_taw_arg" ]] || {
    _taw_die "could not resolve project: $_taw_arg"
    return 1
  }

  if [[ "$_taw_arg" != /* && "$_taw_arg" != */* && -n "${PROJECTS_HOME:-}" ]]; then
    _taw_projects_candidate="${PROJECTS_HOME:A}/$_taw_arg"
    if [[ -d "$_taw_projects_candidate" ]]; then
      _taw_use_project_path "$_taw_projects_candidate" "$_taw_projects_candidate"
      return
    fi
  fi

  _taw_resolve_project_from_tmux "$_taw_arg"
  case $? in
    0) return 0 ;;
    2) return 1 ;;
  esac

  _taw_die "could not resolve existing project: $_taw_arg"
  return 1
}

_taw_classify_operands() {
  local _taw_positionals_count="${#_taw_positionals[@]}"

  _taw_worktree_arg=
  _taw_base_ref=

  case "$_taw_project_kind" in
    plain)
      if [[ -n "$_taw_named_branch" || $_taw_positionals_count -gt 0 ]]; then
        _taw_die "plain projects do not accept operands"
        return 1
      fi
      ;;
    normal)
      if [[ -n "$_taw_named_branch" ]]; then
        if (( _taw_positionals_count == 0 )); then
          _taw_base_ref="$_taw_named_branch"
        else
          _taw_die "normal projects do not accept positional operands with -b"
          return 1
        fi
      else
        case "$_taw_positionals_count" in
          0) ;;
          1)
            _taw_base_ref="${_taw_positionals[1]}"
            ;;
          *)
            _taw_die "normal projects accept at most one positional branch"
            return 1
            ;;
        esac
      fi
      ;;
    bare)
      if [[ -n "$_taw_named_branch" ]]; then
        if (( _taw_positionals_count == 0 )); then
          _taw_base_ref="$_taw_named_branch"
        else
          _taw_die "bare projects do not accept positional operands with -b"
          return 1
        fi
      else
        case "$_taw_positionals_count" in
          0) ;;
          1)
            _taw_worktree_arg="${_taw_positionals[1]}"
            ;;
          2)
            _taw_worktree_arg="${_taw_positionals[1]}"
            _taw_base_ref="${_taw_positionals[2]}"
            ;;
          *)
            _taw_die "bare projects accept at most two positional operands"
            return 1
            ;;
        esac
      fi
      ;;
  esac
}

_taw_git() {
  if [[ "$_taw_is_bare" == true ]]; then
    git --git-dir "$_taw_git_dir" "$@"
  else
    git -C "$_taw_project_dir" "$@"
  fi
}

_taw_branch_exists() {
  _taw_git show-ref --verify --quiet "refs/heads/$1"
}

_taw_remote_names_sorted() {
  local -a _taw_remotes _taw_sorted_remotes
  local _taw_remote

  _taw_remotes=( "${(@f)$(_taw_git remote 2>/dev/null)}" )
  for _taw_remote in "${_taw_remotes[@]}"; do
    [[ -n "$_taw_remote" ]] || continue
    [[ "$_taw_remote" == origin ]] && print -r -- "$_taw_remote" || _taw_sorted_remotes+=( "$_taw_remote" )
  done

  if (( ${#_taw_sorted_remotes[@]} > 0 )); then
    _taw_sorted_remotes=( "${(@o)_taw_sorted_remotes}" )
    for _taw_remote in "${_taw_sorted_remotes[@]}"; do
      print -r -- "$_taw_remote"
    done
  fi
}

_taw_remote_branch_for_path() {
  local _taw_path="$1" _taw_remote_candidate _taw_remote_prefix _taw_remote _taw_branch
  local -a _taw_remotes

  _taw_remotes=( "${(@f)$(_taw_git remote 2>/dev/null)}" )
  for _taw_remote_candidate in "${_taw_remotes[@]}"; do
    _taw_remote_prefix="$_taw_remote_candidate/"
    if [[ "$_taw_path" == "$_taw_remote_prefix"* ]]; then
      if [[ -z "$_taw_remote" || ${#_taw_remote_candidate} -gt ${#_taw_remote} ]]; then
        _taw_remote="$_taw_remote_candidate"
        _taw_branch="${_taw_path#$_taw_remote_prefix}"
      fi
    fi
  done

  [[ -n "$_taw_remote" && "$_taw_branch" != "$_taw_path" && "$_taw_branch" != HEAD ]] || return 1
  print -r -- "$_taw_remote	$_taw_branch"
}

_taw_remote_target_for_branch_name() {
  local _taw_branch="$1" _taw_remote _taw_remote_ref
  local -a _taw_remote_names

  _taw_remote_names=( "${(@f)$(_taw_remote_names_sorted)}" )
  for _taw_remote in "${_taw_remote_names[@]}"; do
    [[ -n "$_taw_remote" ]] || continue
    _taw_remote_ref="refs/remotes/$_taw_remote/$_taw_branch"
    if _taw_git rev-parse --verify --quiet "${_taw_remote_ref}^{commit}" >/dev/null; then
      print -r -- "$_taw_remote	$_taw_branch"
      return 0
    fi
  done

  return 1
}

_taw_local_branch_for_commit() {
  local _taw_commit="$1" _taw_line _taw_branch _taw_branch_commit
  local _taw_output

  _taw_output="$(_taw_git for-each-ref --sort=refname --format='%(refname:short) %(objectname)' refs/heads 2>/dev/null)" || return 1
  for _taw_line in "${(@f)_taw_output}"; do
    _taw_branch="${_taw_line%% *}"
    _taw_branch_commit="${_taw_line#* }"
    [[ "$_taw_branch_commit" == "$_taw_commit" ]] || continue
    print -r -- "$_taw_branch"
    return 0
  done

  return 1
}

_taw_resolve_branch_target() {
  local _taw_input="$1" _taw_fallback_branch="${2:-}" _taw_fallback_ref="${3:-}"
  local _taw_remote_target _taw_remote _taw_branch _taw_commit

  _taw_branch_target_name=
  _taw_branch_target_ref=

  [[ "$_taw_input" == refs/remotes/* ]] && return 1

  if _taw_branch_exists "$_taw_input"; then
    _taw_branch_target_name="$_taw_input"
    _taw_branch_target_ref="$_taw_input"
    return 0
  fi

  if [[ "$_taw_input" == */* ]]; then
    if _taw_remote_target="$(_taw_remote_branch_for_path "$_taw_input")"; then
      _taw_remote="${_taw_remote_target%%	*}"
      _taw_branch="${_taw_remote_target#*	}"
      if _taw_git rev-parse --verify --quiet "refs/remotes/$_taw_remote/$_taw_branch^{commit}" >/dev/null; then
        _taw_branch_target_name="$_taw_branch"
        _taw_branch_target_ref="$_taw_remote/$_taw_branch"
        return 0
      fi
      return 1
    fi
  fi

  if _taw_remote_target="$(_taw_remote_target_for_branch_name "$_taw_input")"; then
    _taw_remote="${_taw_remote_target%%	*}"
    _taw_branch="${_taw_remote_target#*	}"
    _taw_branch_target_name="$_taw_branch"
    _taw_branch_target_ref="$_taw_remote/$_taw_branch"
    return 0
  fi

  if [[ -n "$_taw_fallback_branch" ]]; then
    _taw_branch_target_name="$_taw_fallback_branch"
    _taw_branch_target_ref="${_taw_fallback_ref:-$_taw_fallback_branch}"
    return 0
  fi

  return 1
}

_taw_checkout_branch_target() {
  local _taw_branch="$1" _taw_ref="$2" _taw_remote_target _taw_remote_name _taw_remote_branch _taw_start_point

  if _taw_branch_exists "$_taw_branch"; then
    git -C "$_taw_project_dir" checkout "$_taw_branch" || return 1
  else
    if [[ "$_taw_ref" == */* ]]; then
      _taw_remote_target="$(_taw_remote_branch_for_path "$_taw_ref")" || return 1
      _taw_remote_name="${_taw_remote_target%%$'\t'*}"
      _taw_remote_branch="${_taw_remote_target#*$'\t'}"
      _taw_start_point="$(_taw_git rev-parse --verify --quiet "refs/remotes/$_taw_remote_name/$_taw_remote_branch^{commit}" 2>/dev/null)" || return 1
    else
      _taw_start_point="$_taw_ref"
    fi
    git -C "$_taw_project_dir" checkout -b "$_taw_branch" "$_taw_start_point" || return 1
    if [[ "$_taw_ref" == */* ]]; then
      if ! git -C "$_taw_project_dir" config --get "remote.$_taw_remote_name.url" >/dev/null 2>&1; then
        git -C "$_taw_project_dir" config "remote.$_taw_remote_name.url" "$_taw_git_dir" || return 1
        git -C "$_taw_project_dir" config "remote.$_taw_remote_name.fetch" "+refs/heads/*:refs/remotes/$_taw_remote_name/*" || return 1
      fi
      git -C "$_taw_project_dir" config "branch.$_taw_branch.remote" "$_taw_remote_name" || return 1
      git -C "$_taw_project_dir" config "branch.$_taw_branch.merge" "refs/heads/$_taw_remote_branch" || return 1
    fi
  fi
}

_taw_picker_branch_rows() {
  local _taw_local_refs _taw_remote_refs _taw_ref _taw_branch _taw_remote_target
  local _taw_remote_name _taw_remote_branch _taw_remote_path _taw_row_remote
  local -a _taw_remote_names
  local -A _taw_seen_by_branch

  _taw_local_refs="$(_taw_git for-each-ref --sort=refname --format='%(refname)' refs/heads 2>/dev/null)" \
    || return 1
  for _taw_ref in "${(@f)_taw_local_refs}"; do
    _taw_branch="${_taw_ref#refs/heads/}"
    [[ -n "$_taw_branch" && -z "${_taw_seen_by_branch[$_taw_branch]-}" ]] || continue
    _taw_seen_by_branch[$_taw_branch]=local
    print -r -- "$_taw_branch"$'\t'"branch"$'\t'"$_taw_branch"$'\t'"$_taw_branch"$'\t'
  done

  _taw_remote_refs="$(_taw_git for-each-ref --sort=refname --format='%(refname)' refs/remotes 2>/dev/null)" \
    || return 1
  _taw_remote_names=( "${(@f)$(_taw_remote_names_sorted)}" )
  for _taw_remote_name in "${_taw_remote_names[@]}"; do
    [[ -n "$_taw_remote_name" ]] || continue
    for _taw_ref in "${(@f)_taw_remote_refs}"; do
      _taw_remote_path="${_taw_ref#refs/remotes/}"
      _taw_remote_target="$(_taw_remote_branch_for_path "$_taw_remote_path")" || continue
      _taw_row_remote="${_taw_remote_target%%$'\t'*}"
      _taw_remote_branch="${_taw_remote_target#*$'\t'}"
      [[ "$_taw_row_remote" == "$_taw_remote_name" && -n "$_taw_remote_branch" && -z "${_taw_seen_by_branch[$_taw_remote_branch]-}" ]] || continue
      _taw_seen_by_branch[$_taw_remote_branch]=remote
      print -r -- "$_taw_remote_branch"$'\t'"branch"$'\t'"$_taw_remote_branch"$'\t'"$_taw_remote_name/$_taw_remote_branch"$'\t'
    done
  done
}

_taw_bare_worktree_count() {
  local _taw_output _taw_line _taw_path _taw_is_bare_entry _taw_count=0

  _taw_output="$(_taw_git worktree list --porcelain 2>/dev/null)" || return 1
  for _taw_line in "${(@f)_taw_output}" ""; do
    case "$_taw_line" in
      worktree\ *)
        _taw_path="${_taw_line#worktree }"
        _taw_is_bare_entry=false
        ;;
      bare)
        _taw_is_bare_entry=true
        ;;
      "")
        if [[ "$_taw_is_bare_entry" != true && -n "$_taw_path" ]]; then
          _taw_count=$((_taw_count + 1))
        fi
        ;;
    esac
  done

  print -r -- "$_taw_count"
}

_taw_default_bare_target() {
  local _taw_head_branch _taw_refs

  if _taw_default_branch; then
    return 0
  fi

  _taw_refs="$(_taw_git for-each-ref --count=1 --format='%(refname)' 2>/dev/null)" || return 1
  [[ -n "$_taw_refs" ]] && return 1

  if _taw_head_branch="$(_taw_git symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
    _taw_default_branch_result="$_taw_head_branch"
    _taw_default_base_ref=
    return 0
  fi

  return 1
}

_taw_default_branch() {
  local _taw_branch _taw_remote_head _taw_head_commit

  _taw_default_branch_result=
  _taw_default_base_ref=

  if _taw_branch="$(_taw_git symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
    _taw_branch="${_taw_branch#refs/heads/}"
    _taw_branch="${_taw_branch#heads/}"
    _taw_branch="${_taw_branch#origin/}"
    if _taw_branch_exists "$_taw_branch"; then
      _taw_default_branch_result="$_taw_branch"
      _taw_default_base_ref="$_taw_branch"
      return 0
    fi
  fi

  if _taw_head_commit="$(_taw_git rev-parse --verify --quiet HEAD^{commit} 2>/dev/null)"; then
    if _taw_branch="$(_taw_local_branch_for_commit "$_taw_head_commit")"; then
      _taw_default_branch_result="$_taw_branch"
      _taw_default_base_ref="$_taw_branch"
      return 0
    fi
  fi

  if _taw_remote_head="$(_taw_git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"; then
    _taw_branch="${_taw_remote_head#origin/}"
    if _taw_branch_exists "$_taw_branch"; then
      _taw_default_branch_result="$_taw_branch"
      _taw_default_base_ref="$_taw_branch"
      return 0
    fi
    if _taw_git rev-parse --verify --quiet "refs/remotes/origin/$_taw_branch^{commit}" >/dev/null; then
      _taw_default_branch_result="$_taw_branch"
      _taw_default_base_ref="origin/$_taw_branch"
      return 0
    fi
  fi

  for _taw_branch in main master; do
    _taw_branch_exists "$_taw_branch" || continue
    _taw_default_branch_result="$_taw_branch"
    _taw_default_base_ref="$_taw_branch"
    return 0
  done

  return 1
}

_taw_conversion_default_branch() {
  local _taw_current_branch="$1" _taw_remote_head _taw_branch

  _taw_default_branch_result=
  _taw_default_base_ref=

  if _taw_remote_head="$(_taw_git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"; then
    _taw_branch="${_taw_remote_head#origin/}"
    if _taw_branch_exists "$_taw_branch"; then
      _taw_default_branch_result="$_taw_branch"
      _taw_default_base_ref="$_taw_branch"
      return 0
    fi
    if _taw_git rev-parse --verify --quiet "refs/remotes/origin/$_taw_branch^{commit}" >/dev/null; then
      _taw_default_branch_result="$_taw_branch"
      _taw_default_base_ref="origin/$_taw_branch"
      return 0
    fi
  fi

  for _taw_branch in main master; do
    _taw_branch_exists "$_taw_branch" || continue
    _taw_default_branch_result="$_taw_branch"
    _taw_default_base_ref="$_taw_branch"
    return 0
  done

  _taw_default_branch_result="$_taw_current_branch"
  _taw_default_base_ref="$_taw_current_branch"
}

_taw_status_records_preserved() {
  local _taw_before="$1" _taw_after="$2" _taw_record
  local -A _taw_after_records

  for _taw_record in "${(@f)_taw_after}"; do
    [[ -n "$_taw_record" ]] || continue
    _taw_after_records[$_taw_record]=1
  done
  for _taw_record in "${(@f)_taw_before}"; do
    [[ -n "$_taw_record" ]] || continue
    [[ -n "${_taw_after_records[$_taw_record]-}" ]] || return 1
  done
}

_taw_move_worktree_entries() {
  local _taw_source="$1" _taw_dest="$2" _taw_entry
  local -a _taw_entries

  mkdir -p -- "$_taw_dest" || return 1
  _taw_entries=( "$_taw_source"/*(N) "$_taw_source"/.[!.]*(N) "$_taw_source"/..?*(N) )
  for _taw_entry in "${_taw_entries[@]}"; do
    [[ "${_taw_entry:t}" == .git ]] && continue
    mv -- "$_taw_entry" "$_taw_dest/" || return 1
  done
}

_taw_remove_empty_worktree_parents() {
  local _taw_path="${1:h}" _taw_root="${2:A}"

  while [[ "${_taw_path:A}" == "$_taw_root"/* ]]; do
    rmdir -- "$_taw_path" 2>/dev/null || return 0
    _taw_path="${_taw_path:h}"
  done
}

_taw_capture_wrapper_entries() {
  local _taw_root="${1:A}" _taw_dest="${2:A}" _taw_default_path="${3:A}"
  local _taw_current_path="${4:A}" _taw_source="${5:-${1:A}}"
  local _taw_entry _taw_relative _taw_target
  local -a _taw_entries

  _taw_entries=( "$_taw_source"/*(ND) )
  for _taw_entry in "${_taw_entries[@]}"; do
    [[ "$_taw_entry" == "$_taw_root/.git" \
      || "$_taw_entry" == "$_taw_default_path" \
      || "$_taw_entry" == "$_taw_current_path" ]] && continue

    if [[ "$_taw_default_path" == "$_taw_entry"/* \
      || "$_taw_current_path" == "$_taw_entry"/* ]]; then
      [[ -d "$_taw_entry" ]] || return 1
      _taw_capture_wrapper_entries "$_taw_root" "$_taw_dest" \
        "$_taw_default_path" "$_taw_current_path" "$_taw_entry" || return 1
      rmdir -- "$_taw_entry" 2>/dev/null || true
      continue
    fi

    _taw_relative="${_taw_entry#$_taw_root/}"
    _taw_target="$_taw_dest/$_taw_relative"
    [[ ! -e "$_taw_target" && ! -L "$_taw_target" ]] || return 1
    mkdir -p -- "${_taw_target:h}" || return 1
    mv -- "$_taw_entry" "$_taw_target" || return 1
  done
}

_taw_conversion_rollback() {
  local _taw_project_root="$1" _taw_backup="$2" _taw_current_path="$3"
  local _taw_default_path="$4" _taw_current_added="$5" _taw_default_added="$6"
  local _taw_default_created="$7" _taw_default_branch="$8"
  local _taw_rollback_ok=true

  if [[ "$_taw_current_added" == true && -d "$_taw_current_path" \
    && -d "$_taw_backup/tree" ]]; then
    _taw_move_worktree_entries "$_taw_current_path" "$_taw_backup/tree" \
      || _taw_rollback_ok=false
  fi

  if [[ -d "$_taw_project_root/.git" ]]; then
    if [[ "$_taw_current_added" == true ]]; then
      git --git-dir "$_taw_project_root/.git" worktree remove --force "$_taw_current_path" \
        >/dev/null 2>&1 || true
    fi
    if [[ "$_taw_default_added" == true ]]; then
      git --git-dir "$_taw_project_root/.git" worktree remove --force "$_taw_default_path" \
        >/dev/null 2>&1 || true
    fi
    if [[ "$_taw_default_created" == true ]]; then
      git --git-dir "$_taw_project_root/.git" update-ref -d "refs/heads/$_taw_default_branch" \
        >/dev/null 2>&1 || _taw_rollback_ok=false
    fi
  fi

  if [[ "$_taw_current_added" == true ]]; then
    _taw_remove_empty_worktree_parents "$_taw_current_path" "$_taw_project_root"
  fi
  if [[ "$_taw_default_added" == true ]]; then
    _taw_remove_empty_worktree_parents "$_taw_default_path" "$_taw_project_root"
  fi

  if [[ -f "$_taw_backup/meta/config" ]]; then
    cp -p -- "$_taw_backup/meta/config" "$_taw_project_root/.git/config" \
      || _taw_rollback_ok=false
  fi
  if [[ -f "$_taw_backup/meta/HEAD" ]]; then
    cp -p -- "$_taw_backup/meta/HEAD" "$_taw_project_root/.git/HEAD" \
      || _taw_rollback_ok=false
  fi
  if [[ -f "$_taw_backup/meta/index" ]]; then
    mv -- "$_taw_backup/meta/index" "$_taw_project_root/.git/index" \
      || _taw_rollback_ok=false
  fi
  if [[ -d "$_taw_backup/tree" ]]; then
    _taw_move_worktree_entries "$_taw_backup/tree" "$_taw_project_root" \
      || _taw_rollback_ok=false
  fi

  if [[ "$_taw_rollback_ok" == true ]]; then
    rm -rf -- "$_taw_backup"
    return 0
  fi

  _taw_die "rollback incomplete; recovery files remain at $_taw_backup"
  return 1
}

_taw_convert_project() {
  local _taw_project_root="${_taw_project_dir:A}" _taw_current_branch
  local _taw_default_branch _taw_default_ref _taw_default_path _taw_current_path
  local _taw_current_commit _taw_before_status _taw_after_status _taw_default_status
  local _taw_common_dir _taw_actual_git_dir _taw_worktree_count _taw_shared_index
  local _taw_operation_path _taw_lock_file _taw_backup _taw_current_git_dir
  local _taw_saved_pwd _taw_caller_relative _taw_default_created=false
  local _taw_default_added=false _taw_current_added=false
  local _taw_failure= _taw_head_after _taw_current_branch_after
  local -a _taw_operation_names _taw_modules

  [[ "$_taw_project_kind" == normal ]] || {
    _taw_die "--convert requires a normal git project"
    return 1
  }
  [[ -d "$_taw_project_root/.git" && ! -L "$_taw_project_root/.git" ]] || {
    _taw_die "--convert requires the project's primary .git directory"
    return 1
  }

  _taw_actual_git_dir="$(git -C "$_taw_project_root" rev-parse --path-format=absolute --git-dir 2>/dev/null)" \
    || return 1
  _taw_common_dir="$(git -C "$_taw_project_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || return 1
  if [[ "${_taw_actual_git_dir:A}" != "$_taw_project_root/.git" \
    || "${_taw_common_dir:A}" != "$_taw_project_root/.git" ]]; then
    _taw_die "--convert does not support external git directories or linked worktrees"
    return 1
  fi

  _taw_current_branch="$(git -C "$_taw_project_root" symbolic-ref --quiet --short HEAD 2>/dev/null)" || {
    _taw_die "--convert does not support detached HEAD"
    return 1
  }
  git check-ref-format --branch "$_taw_current_branch" >/dev/null 2>&1 || {
    _taw_die "invalid current branch: $_taw_current_branch"
    return 1
  }

  _taw_worktree_count="$(_taw_bare_worktree_count)" || return 1
  if (( _taw_worktree_count != 1 )); then
    _taw_die "--convert does not support repositories with linked worktrees"
    return 1
  fi

  _taw_operation_names=(
    MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-apply
    rebase-merge sequencer BISECT_START
  )
  for _taw_operation_path in "${_taw_operation_names[@]}"; do
    _taw_operation_path="$(git -C "$_taw_project_root" rev-parse --path-format=absolute \
      --git-path "$_taw_operation_path" 2>/dev/null)" \
      || return 1
    if [[ -e "$_taw_operation_path" ]]; then
      _taw_die "--convert does not support an active git operation"
      return 1
    fi
  done
  if [[ -n "$(git -C "$_taw_project_root" ls-files -u 2>/dev/null)" ]]; then
    _taw_die "--convert does not support unmerged index entries"
    return 1
  fi

  _taw_lock_file="$(find "$_taw_project_root/.git" -name '*.lock' -print -quit 2>/dev/null)" \
    || return 1
  if [[ -n "$_taw_lock_file" ]]; then
    _taw_die "--convert cannot run while git lock files exist"
    return 1
  fi

  _taw_modules=( "$_taw_project_root/.git/modules"/*(ND) )
  if (( ${#_taw_modules[@]} > 0 )); then
    _taw_die "--convert does not support initialized submodules"
    return 1
  fi
  if [[ "$(git -C "$_taw_project_root" config --bool core.sparseCheckout 2>/dev/null)" == true \
    || -e "$_taw_project_root/.git/info/sparse-checkout" ]]; then
    _taw_die "--convert does not support sparse checkouts"
    return 1
  fi
  _taw_shared_index="$(git -C "$_taw_project_root" rev-parse --shared-index-path 2>/dev/null)" \
    || _taw_shared_index=
  if [[ -n "$_taw_shared_index" ]]; then
    _taw_die "--convert does not support split indexes"
    return 1
  fi
  if [[ "$(git -C "$_taw_project_root" config --bool extensions.worktreeConfig 2>/dev/null)" == true ]]; then
    _taw_die "--convert does not support worktree-specific config"
    return 1
  fi

  _taw_conversion_default_branch "$_taw_current_branch" || return 1
  _taw_default_branch="$_taw_default_branch_result"
  _taw_default_ref="$_taw_default_base_ref"
  _taw_current_commit="$(git -C "$_taw_project_root" rev-parse --verify --quiet HEAD^{commit} 2>/dev/null)" \
    || _taw_current_commit=
  if [[ -z "$_taw_current_commit" && "$_taw_default_branch" == "$_taw_current_branch" \
    && "$_taw_default_ref" != "$_taw_current_branch" ]]; then
    _taw_die "unborn current branch conflicts with remote default: $_taw_default_ref"
    return 1
  fi
  _taw_default_path="$_taw_project_root/$_taw_default_branch"
  _taw_current_path="$_taw_project_root/$_taw_current_branch"
  if [[ "$_taw_default_path" != "$_taw_current_path" \
    && ( "$_taw_default_path" == "$_taw_current_path"/* \
      || "$_taw_current_path" == "$_taw_default_path"/* ) ]]; then
    _taw_die "default and current branch worktree paths overlap"
    return 1
  fi

  _taw_before_status="$(git -C "$_taw_project_root" status --porcelain=v2 --untracked-files=all)" \
    || return 1
  _taw_saved_pwd="$(pwd -P)" || return 1
  if [[ "$_taw_saved_pwd" == "$_taw_project_root/.git" \
    || "$_taw_saved_pwd" == "$_taw_project_root/.git"/* ]]; then
    _taw_caller_relative=outside
  elif [[ "$_taw_saved_pwd" == "$_taw_project_root" ]]; then
    _taw_caller_relative=
  elif [[ "$_taw_saved_pwd" == "$_taw_project_root"/* ]]; then
    _taw_caller_relative="${_taw_saved_pwd#$_taw_project_root/}"
  else
    _taw_caller_relative=outside
  fi

  _taw_backup="$(mktemp -d "${_taw_project_root:h}/.${_taw_project_root:t}.taw-convert.XXXXXX")" \
    || return 1
  mkdir -p -- "$_taw_backup/meta" "$_taw_backup/tree" || {
    rm -rf -- "$_taw_backup"
    return 1
  }
  cp -p -- "$_taw_project_root/.git/config" "$_taw_backup/meta/config" \
    && cp -p -- "$_taw_project_root/.git/HEAD" "$_taw_backup/meta/HEAD" \
    || _taw_failure="could not preserve git metadata"
  if [[ -z "$_taw_failure" && -f "$_taw_project_root/.git/index" ]]; then
    mv -- "$_taw_project_root/.git/index" "$_taw_backup/meta/index" \
      || _taw_failure="could not preserve git index"
  fi
  if [[ -z "$_taw_failure" ]]; then
    _taw_move_worktree_entries "$_taw_project_root" "$_taw_backup/tree" \
      || _taw_failure="could not move the working tree"
  fi
  if [[ -z "$_taw_failure" ]]; then
    git --git-dir "$_taw_project_root/.git" config core.bare true \
      || _taw_failure="could not make the repository bare"
  fi
  if [[ -z "$_taw_failure" \
    && -n "$(git --git-dir "$_taw_project_root/.git" config --get-all core.worktree 2>/dev/null)" ]]; then
    git --git-dir "$_taw_project_root/.git" config --unset-all core.worktree \
      || _taw_failure="could not remove core.worktree"
  fi

  if [[ -z "$_taw_failure" && "$_taw_default_branch" != "$_taw_current_branch" ]]; then
    if git --git-dir "$_taw_project_root/.git" show-ref --verify --quiet "refs/heads/$_taw_default_branch"; then
      if git --git-dir "$_taw_project_root/.git" worktree add \
        "$_taw_default_path" "$_taw_default_branch"; then
        _taw_default_added=true
      else
        [[ -e "$_taw_default_path/.git" ]] && _taw_default_added=true
        _taw_failure="could not create the default worktree"
      fi
    else
      _taw_default_created=true
      if git --git-dir "$_taw_project_root/.git" worktree add --track \
        -b "$_taw_default_branch" "$_taw_default_path" "$_taw_default_ref"; then
        _taw_default_added=true
      else
        [[ -e "$_taw_default_path/.git" ]] && _taw_default_added=true
        _taw_failure="could not create the default tracking worktree"
      fi
    fi
  fi

  if [[ -z "$_taw_failure" ]]; then
    if [[ -n "$_taw_current_commit" ]]; then
      if git --git-dir "$_taw_project_root/.git" worktree add --no-checkout \
        "$_taw_current_path" "$_taw_current_branch"; then
        _taw_current_added=true
      else
        [[ -e "$_taw_current_path/.git" ]] && _taw_current_added=true
        _taw_failure="could not create the current-branch worktree"
      fi
    else
      if git --git-dir "$_taw_project_root/.git" worktree add --orphan \
        -b "$_taw_current_branch" "$_taw_current_path"; then
        _taw_current_added=true
      else
        [[ -e "$_taw_current_path/.git" ]] && _taw_current_added=true
        _taw_failure="could not create the unborn current-branch worktree"
      fi
    fi
  fi

  if [[ -z "$_taw_failure" ]]; then
    _taw_current_git_dir="$(git -C "$_taw_current_path" rev-parse --path-format=absolute --git-dir 2>/dev/null)" \
      || _taw_failure="could not resolve current worktree metadata"
  fi
  if [[ -z "$_taw_failure" && -f "$_taw_backup/meta/index" ]]; then
    cp -p -- "$_taw_backup/meta/index" "$_taw_current_git_dir/index" \
      || _taw_failure="could not migrate the git index"
  fi
  if [[ -z "$_taw_failure" ]]; then
    _taw_move_worktree_entries "$_taw_backup/tree" "$_taw_current_path" \
      || _taw_failure="could not restore the working tree"
  fi
  if [[ -z "$_taw_failure" ]]; then
    git --git-dir "$_taw_project_root/.git" symbolic-ref HEAD "refs/heads/$_taw_default_branch" \
      || _taw_failure="could not set the bare repository default branch"
  fi
  if [[ -z "$_taw_failure" ]]; then
    _taw_capture_wrapper_entries "$_taw_project_root" "$_taw_current_path" \
      "$_taw_default_path" "$_taw_current_path" \
      || _taw_failure="could not capture changes created during conversion"
  fi

  if [[ -z "$_taw_failure" ]]; then
    [[ "$(git --git-dir "$_taw_project_root/.git" rev-parse --is-bare-repository 2>/dev/null)" == true ]] \
      || _taw_failure="converted repository is not bare"
  fi
  if [[ -z "$_taw_failure" ]]; then
    _taw_after_status="$(git -C "$_taw_current_path" status --porcelain=v2 --untracked-files=all)" \
      || _taw_failure="could not verify the current worktree"
    if [[ -z "$_taw_failure" ]] \
      && ! _taw_status_records_preserved "$_taw_before_status" "$_taw_after_status"; then
      print -u2 -r -- "taw: status before conversion:"
      print -u2 -r -- "$_taw_before_status"
      print -u2 -r -- "taw: status after conversion:"
      print -u2 -r -- "$_taw_after_status"
      _taw_failure="current worktree status changed during conversion"
    fi
  fi
  if [[ -z "$_taw_failure" ]]; then
    _taw_current_branch_after="$(git -C "$_taw_current_path" \
      symbolic-ref --quiet --short HEAD 2>/dev/null)" \
      || _taw_failure="could not verify the current worktree branch"
    [[ -n "$_taw_failure" || "$_taw_current_branch_after" == "$_taw_current_branch" ]] \
      || _taw_failure="current worktree branch changed during conversion"
  fi
  if [[ -z "$_taw_failure" && "$_taw_default_path" != "$_taw_current_path" ]]; then
    _taw_default_status="$(git -C "$_taw_default_path" status --porcelain --untracked-files=all)" \
      || _taw_failure="could not verify the default worktree"
    [[ -n "$_taw_failure" || -z "$_taw_default_status" ]] \
      || _taw_failure="default worktree is not clean"
  fi
  if [[ -z "$_taw_failure" ]]; then
    _taw_head_after="$(git --git-dir "$_taw_project_root/.git" symbolic-ref --quiet --short HEAD 2>/dev/null)" \
      || _taw_failure="could not verify the bare repository HEAD"
    [[ -n "$_taw_failure" || "$_taw_head_after" == "$_taw_default_branch" ]] \
      || _taw_failure="bare repository HEAD does not name the default branch"
  fi

  if [[ -n "$_taw_failure" ]]; then
    if ! _taw_conversion_rollback "$_taw_project_root" "$_taw_backup" "$_taw_current_path" \
      "$_taw_default_path" "$_taw_current_added" "$_taw_default_added" \
      "$_taw_default_created" "$_taw_default_branch"; then
      return 1
    fi
    if [[ "$_taw_caller_relative" != outside ]]; then
      builtin cd -- "$_taw_project_root/${_taw_caller_relative:-}" 2>/dev/null || true
    fi
    _taw_die "$_taw_failure; original project restored"
    return 1
  fi

  rm -rf -- "$_taw_backup" || return 1
  if [[ "$_taw_caller_relative" != outside ]]; then
    builtin cd -- "$_taw_current_path/${_taw_caller_relative:-}" || return 1
  fi

  print -r -- "taw: converted $_taw_project_root to a bare project"
  print -r -- "taw: default worktree: $_taw_default_path"
  print -r -- "taw: current worktree: $_taw_current_path"
}

_taw_bare_picker_rows() {
  local _taw_worktrees _taw_branch_rows _taw_line _taw_path _taw_branch_ref _taw_branch
  local _taw_is_bare_entry _taw_is_detached_entry _taw_rows="" _taw_row _taw_kind _taw_ref
  local -a _taw_fields
  local -A _taw_seen_by_branch

  _taw_worktrees="$(_taw_git worktree list --porcelain 2>/dev/null)" || return 1
  for _taw_line in "${(@f)_taw_worktrees}" ""; do
    case "$_taw_line" in
      worktree\ *)
        _taw_path="${_taw_line#worktree }"
        _taw_branch_ref=
        _taw_is_bare_entry=false
        _taw_is_detached_entry=false
        ;;
      branch\ *)
        _taw_branch_ref="${_taw_line#branch }"
        ;;
      bare)
        _taw_is_bare_entry=true
        ;;
      detached)
        _taw_is_detached_entry=true
        ;;
      "")
        if [[ -n "$_taw_path" && "$_taw_is_bare_entry" != true ]]; then
          if [[ "$_taw_branch_ref" == refs/heads/* ]]; then
            _taw_branch="${_taw_branch_ref#refs/heads/}"
            _taw_seen_by_branch[$_taw_branch]=1
            _taw_rows+="${_taw_branch} [worktree]"$'\t'"worktree"$'\t'"$_taw_branch"$'\t'"$_taw_branch"$'\t'"$_taw_path"$'\n'
          elif [[ "$_taw_is_detached_entry" == true ]]; then
            _taw_rows+="${_taw_path:t} [detached]"$'\t'"worktree"$'\t\t\t'"$_taw_path"$'\n'
          fi
        fi
        ;;
    esac
  done

  _taw_branch_rows="$(_taw_picker_branch_rows)" || return 1
  for _taw_row in "${(@f)_taw_branch_rows}"; do
    [[ -n "$_taw_row" ]] || continue
    _taw_fields=( "${(@ps:\t:)_taw_row}" )
    _taw_branch="${_taw_fields[3]}"
    [[ -n "$_taw_branch" && -z "${_taw_seen_by_branch[$_taw_branch]-}" ]] || continue
    _taw_rows+="$_taw_row"$'\n'
  done

  print -r -- "$_taw_rows"
}

_taw_select_branch_with_fzf() {
  local _taw_rows _taw_choice _taw_status
  local -a _taw_fields

  command -v fzf >/dev/null 2>&1 || return 2
  _taw_rows="$(_taw_picker_branch_rows)" || return 1
  [[ -n "$_taw_rows" ]] || return 2
  _taw_choice="$(print -r -- "$_taw_rows" | fzf --delimiter=$'\t' --with-nth=1 --prompt='taw> ')" || _taw_status=$?
  _taw_status=${_taw_status:-0}
  case "$_taw_status" in
    0) ;;
    130) return 130 ;;
    2) return 2 ;;
    1) return 1 ;;
    *) return 1 ;;
  esac
  [[ -n "$_taw_choice" ]] || return 1

  _taw_fields=( "${(@ps:\t:)_taw_choice}" )
  (( ${#_taw_fields[@]} >= 5 )) || return 1
  _taw_picker_kind="${_taw_fields[2]}"
  _taw_picker_branch="${_taw_fields[3]}"
  _taw_picker_ref="${_taw_fields[4]}"
  _taw_picker_path="${_taw_fields[5]}"
}

_taw_select_bare_target_with_fzf() {
  local _taw_rows _taw_choice _taw_status
  local -a _taw_fields

  command -v fzf >/dev/null 2>&1 || return 2
  _taw_rows="$(_taw_bare_picker_rows)" || return 1
  [[ -n "$_taw_rows" ]] || return 2
  _taw_choice="$(print -r -- "$_taw_rows" | fzf --delimiter=$'\t' --with-nth=1 --prompt='taw> ')" || _taw_status=$?
  _taw_status=${_taw_status:-0}
  case "$_taw_status" in
    0) ;;
    130) return 130 ;;
    2) return 2 ;;
    1) return 1 ;;
    *) return 1 ;;
  esac
  [[ -n "$_taw_choice" ]] || return 1

  _taw_fields=( "${(@ps:\t:)_taw_choice}" )
  (( ${#_taw_fields[@]} >= 5 )) || return 1
  _taw_picker_kind="${_taw_fields[2]}"
  _taw_picker_branch="${_taw_fields[3]}"
  _taw_picker_ref="${_taw_fields[4]}"
  _taw_picker_path="${_taw_fields[5]}"
}

_taw_existing_worktree_for_branch() {
  local _taw_branch="refs/heads/$1" _taw_output _taw_line
  local _taw_path _taw_seen_branch _taw_is_bare_entry

  _taw_output="$(_taw_git worktree list --porcelain 2>/dev/null)" || return 1

  for _taw_line in "${(@f)_taw_output}" ""; do
    case "$_taw_line" in
      worktree\ *)
        _taw_path="${_taw_line#worktree }"
        _taw_seen_branch=
        _taw_is_bare_entry=false
        ;;
      branch\ *)
        _taw_seen_branch="${_taw_line#branch }"
        ;;
      bare)
        _taw_is_bare_entry=true
        ;;
      "")
        if [[ "$_taw_is_bare_entry" != true && "$_taw_seen_branch" == "$_taw_branch" && -n "$_taw_path" ]]; then
          print -r -- "$_taw_path"
          return 0
        fi
        ;;
    esac
  done

  return 1
}

_taw_current_head_ref() {
  _taw_git symbolic-ref --quiet --short HEAD 2>/dev/null \
    || print -r -- HEAD
}

_taw_checkout_existing_worktree_branch() {
  local _taw_path="$1" _taw_expected_branch="$2" _taw_existing_branch _taw_ref="$3"
  local _taw_remote_target _taw_remote_name _taw_remote_branch _taw_start_point _taw_is_remote_ref=false

  _taw_existing_branch="$(git -C "$_taw_path" symbolic-ref --quiet --short HEAD 2>/dev/null)" \
    || _taw_existing_branch="$(git -C "$_taw_path" rev-parse --short HEAD 2>/dev/null)" \
    || _taw_existing_branch=unknown

  [[ "$_taw_existing_branch" == "$_taw_expected_branch" ]] && return 0

  _taw_confirm "Worktree $_taw_path is on $_taw_existing_branch; switch to $_taw_expected_branch?" || {
    _taw_die "worktree branch mismatch"
    return 1
  }

  if git -C "$_taw_path" show-ref --verify --quiet "refs/heads/$_taw_expected_branch"; then
    git -C "$_taw_path" checkout "$_taw_expected_branch" || return 1
  else
    [[ -n "$_taw_ref" ]] || _taw_ref="$(_taw_current_head_ref)"
    if _taw_branch_exists "$_taw_ref"; then
      _taw_start_point="$_taw_ref"
    elif [[ "$_taw_ref" == */* ]]; then
      _taw_remote_target="$(_taw_remote_branch_for_path "$_taw_ref")" || return 1
      _taw_remote_name="${_taw_remote_target%%$'\t'*}"
      _taw_remote_branch="${_taw_remote_target#*$'\t'}"
      _taw_start_point="$(git -C "$_taw_path" rev-parse --verify --quiet "refs/remotes/$_taw_remote_name/$_taw_remote_branch^{commit}" 2>/dev/null)" || return 1
      _taw_is_remote_ref=true
    else
      _taw_start_point="$_taw_ref"
    fi
    git -C "$_taw_path" checkout -b "$_taw_expected_branch" "$_taw_start_point" || return 1
    if [[ "$_taw_is_remote_ref" == true ]]; then
      if ! git -C "$_taw_path" config --get "remote.$_taw_remote_name.url" >/dev/null 2>&1; then
        git -C "$_taw_path" config "remote.$_taw_remote_name.url" "$_taw_git_dir" || return 1
      fi
      git -C "$_taw_path" config "remote.$_taw_remote_name.fetch" "+refs/heads/*:refs/remotes/$_taw_remote_name/*" || return 1
      git -C "$_taw_path" config "branch.$_taw_expected_branch.remote" "$_taw_remote_name" || return 1
      git -C "$_taw_path" config "branch.$_taw_expected_branch.merge" "refs/heads/$_taw_remote_branch" || return 1
    fi
  fi
}

_taw_prepare_worktree() {
  local _taw_path="$1" _taw_branch="$2" _taw_ref="$3" _taw_existing_common
  local _taw_remote_target _taw_remote_name _taw_remote_branch _taw_start_point _taw_is_remote_ref=false

  [[ "$_taw_is_bare" == true ]] || {
    _taw_die "creating worktrees requires a bare project"
    return 1
  }
  git check-ref-format --branch "$_taw_branch" >/dev/null 2>&1 || {
    _taw_die "invalid worktree branch: $_taw_branch"
    return 1
  }

  if [[ -e "$_taw_path" ]]; then
    git -C "$_taw_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
      _taw_die "worktree path exists but is not a git worktree: $_taw_path"
      return 1
    }
    _taw_existing_common="$(git -C "$_taw_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || {
      _taw_die "could not inspect worktree git dir: $_taw_path"
      return 1
    }
    _taw_existing_common="${_taw_existing_common:A}"
    if [[ "$_taw_existing_common" != "${_taw_git_dir:A}" ]]; then
      _taw_die "worktree path does not belong to selected project: $_taw_path"
      return 1
    fi
    _taw_checkout_existing_worktree_branch "$_taw_path" "$_taw_branch" "$_taw_ref" || return 1
    return 0
  fi

  mkdir -p -- "${_taw_path:h}" || return 1
  if _taw_branch_exists "$_taw_branch"; then
    _taw_git worktree add "$_taw_path" "$_taw_branch" || return 1
  else
    [[ -n "$_taw_ref" ]] || _taw_ref="$(_taw_current_head_ref)"
    if _taw_branch_exists "$_taw_ref"; then
      _taw_start_point="$_taw_ref"
    elif [[ "$_taw_ref" == */* ]]; then
      _taw_remote_target="$(_taw_remote_branch_for_path "$_taw_ref")" || return 1
      _taw_remote_name="${_taw_remote_target%%$'\t'*}"
      _taw_remote_branch="${_taw_remote_target#*$'\t'}"
      _taw_start_point="$(_taw_git rev-parse --verify --quiet "refs/remotes/$_taw_remote_name/$_taw_remote_branch^{commit}" 2>/dev/null)" || return 1
      _taw_is_remote_ref=true
    else
      _taw_start_point="$_taw_ref"
    fi
    _taw_git worktree add -b "$_taw_branch" "$_taw_path" "$_taw_start_point" || return 1
    if [[ "$_taw_is_remote_ref" == true ]]; then
      if ! _taw_git config --get "remote.$_taw_remote_name.url" >/dev/null 2>&1; then
        _taw_git config "remote.$_taw_remote_name.url" "$_taw_git_dir" || return 1
      fi
      _taw_git config "remote.$_taw_remote_name.fetch" "+refs/heads/*:refs/remotes/$_taw_remote_name/*" || return 1
      _taw_git config "branch.$_taw_branch.remote" "$_taw_remote_name" || return 1
      _taw_git config "branch.$_taw_branch.merge" "refs/heads/$_taw_remote_branch" || return 1
    fi
  fi
}

_taw_resolve_bare_worktree_arg() {
  local _taw_arg="$1" _taw_project_root _taw_path _taw_branch _taw_branch_start

  [[ -n "$_taw_arg" ]] || {
    _taw_die "invalid bare worktree path: $_taw_arg"
    return 1
  }
  if _taw_bare_worktree_input_has_dot_segment "$_taw_arg"; then
    _taw_die "invalid bare worktree path: $_taw_arg"
    return 1
  fi
  _taw_project_root="${_taw_project_dir:A}"
  if [[ "$_taw_arg" == /* ]]; then
    _taw_path="${_taw_arg:A}"
  else
    _taw_path="${_taw_project_root}/$_taw_arg"
    _taw_path="${_taw_path:A}"
  fi

  if [[ "$_taw_path" != "$_taw_project_root"/* ]]; then
    _taw_die "worktree path must stay under project root: $_taw_arg"
    return 1
  fi

  _taw_branch_start=$(( ${#_taw_project_root} + 2 ))
  _taw_branch="${_taw_path[$_taw_branch_start,-1]}"
  [[ -n "$_taw_branch" ]] || {
    _taw_die "invalid bare worktree path: $_taw_arg"
    return 1
  }

  print -r -- "$_taw_path"$'\t'"$_taw_branch"
}

_taw_prepare_orphan_worktree() {
  local _taw_path="$1" _taw_branch="$2" _taw_existing_common

  [[ "$_taw_is_bare" == true ]] || {
    _taw_die "creating worktrees requires a bare project"
    return 1
  }
  git check-ref-format --branch "$_taw_branch" >/dev/null 2>&1 || {
    _taw_die "invalid worktree branch: $_taw_branch"
    return 1
  }

  if [[ -e "$_taw_path" ]]; then
    git -C "$_taw_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
      _taw_die "worktree path exists but is not a git worktree: $_taw_path"
      return 1
    }
    _taw_existing_common="$(git -C "$_taw_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || {
      _taw_die "could not inspect worktree git dir: $_taw_path"
      return 1
    }
    _taw_existing_common="${_taw_existing_common:A}"
    if [[ "$_taw_existing_common" != "${_taw_git_dir:A}" ]]; then
      _taw_die "worktree path does not belong to selected project: $_taw_path"
      return 1
    fi
    _taw_die "orphan worktree path already exists: $_taw_path"
    return 1
  fi

  mkdir -p -- "${_taw_path:h}" || return 1
  _taw_git worktree add --orphan -b "$_taw_branch" "$_taw_path" || return 1
}

_taw_parse_created_window() {
  local _taw_created="$1"
  _taw_created_window="${_taw_created%% *}"
  _taw_created_pane="${_taw_created##* }"
}

_taw_existing_tmux_window_for_dir() {
  local _taw_panes _taw_line _taw_window _taw_pane _taw_pane_path _taw_pane_real _taw_window_match=
  local _taw_target_dir="${_taw_window_dir:A}" _taw_tab=$'\t'

  _taw_panes="$(tmux list-panes -s -t "$_taw_session_target:" \
    -F '#{window_id}	#{pane_id}	#{pane_current_path}' 2>/dev/null)" || return 1

  for _taw_line in "${(@f)_taw_panes}"; do
    _taw_window="${_taw_line%%${_taw_tab}*}"
    _taw_pane="${_taw_line#*${_taw_tab}}"
    _taw_pane="${_taw_pane%%${_taw_tab}*}"
    _taw_pane_path="${_taw_line##*${_taw_tab}}"
    [[ "$_taw_pane_path" != "$_taw_line" && -n "$_taw_window" && -n "$_taw_pane" && -d "$_taw_pane_path" ]] || continue
    _taw_pane_real="${_taw_pane_path:A}"
    if [[ "$_taw_pane_real" == "$_taw_target_dir" ]]; then
      print -r -- "$_taw_window	$_taw_pane"
      return 0
    elif [[ "$_taw_pane_real" == "$_taw_target_dir"/* ]]; then
      [[ -n "$_taw_window_match" ]] || _taw_window_match="$_taw_window"
    fi
  done

  [[ -n "$_taw_window_match" ]] || return 1
  print -r -- "$_taw_window_match"
  return 0
}

_taw_peer_tmux_window_for_dir() {
  local _taw_panes _taw_line _taw_session_id _taw_session _taw_window _taw_pane _taw_pane_path
  local _taw_pane_real _taw_rest _taw_rank _taw_best_rank=99 _taw_best_session_id
  local _taw_best_window _taw_best_pane _taw_target_dir="${_taw_window_dir:A}" _taw_tab=$'\t'

  _taw_panes="$(tmux list-panes -a \
    -F '#{session_id}	#{session_name}	#{window_id}	#{pane_id}	#{pane_current_path}' \
    2>/dev/null)" || return 1

  for _taw_line in "${(@f)_taw_panes}"; do
    _taw_session_id="${_taw_line%%${_taw_tab}*}"
    _taw_rest="${_taw_line#*${_taw_tab}}"
    _taw_session="${_taw_rest%%${_taw_tab}*}"
    _taw_rest="${_taw_rest#*${_taw_tab}}"
    _taw_window="${_taw_rest%%${_taw_tab}*}"
    _taw_rest="${_taw_rest#*${_taw_tab}}"
    _taw_pane="${_taw_rest%%${_taw_tab}*}"
    _taw_pane_path="${_taw_rest#*${_taw_tab}}"
    [[ -n "$_taw_session_id" && -n "$_taw_session" && -n "$_taw_window" \
      && -n "$_taw_pane" && -d "$_taw_pane_path" ]] || continue

    _taw_pane_real="${_taw_pane_path:A}"
    if [[ "$_taw_session_id" == "$_taw_current_session_id" ]]; then
      _taw_rank=0
    elif [[ "$_taw_session_id" == "$_taw_session_target" \
      || "$_taw_session" == "$_taw_session_target" ]]; then
      _taw_rank=2
    else
      _taw_rank=4
    fi

    if [[ "$_taw_pane_real" == "$_taw_target_dir" ]]; then
      :
    elif [[ "$_taw_pane_real" == "$_taw_target_dir"/* ]]; then
      _taw_rank=$((_taw_rank + 1))
    else
      continue
    fi

    (( _taw_rank < _taw_best_rank )) || continue
    _taw_best_rank="$_taw_rank"
    _taw_best_session_id="$_taw_session_id"
    _taw_best_window="$_taw_window"
    if (( _taw_rank % 2 == 0 )); then
      _taw_best_pane="$_taw_pane"
    else
      _taw_best_pane=
    fi
  done

  [[ -n "$_taw_best_window" ]] || return 1
  print -r -- "$_taw_best_session_id	$_taw_best_window	$_taw_best_pane"
}

_taw_switch_to_tmux_window() {
  local _taw_window_id="$1" _taw_pane_id="${2:-}"

  if [[ "$_taw_peer" == true ]]; then
    tmux select-window -t "$_taw_window_id" || return 1
    if [[ -n "$_taw_pane_id" ]]; then
      tmux select-pane -t "$_taw_pane_id" || return 1
    fi
  elif [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$_taw_session_target" || return 1
    tmux select-window -t "$_taw_window_id" || return 1
    if [[ -n "$_taw_pane_id" ]]; then
      tmux select-pane -t "$_taw_pane_id" || return 1
    fi
  else
    tmux select-window -t "$_taw_window_id" || return 1
    if [[ -n "$_taw_pane_id" ]]; then
      tmux select-pane -t "$_taw_pane_id" || return 1
    fi
    tmux attach-session -t "$_taw_session_target" || return 1
  fi
}

_taw_can_reuse_existing_window() {
  [[ "$_taw_agent_arg_provided" != true \
    && "$_taw_editor_arg_provided" != true \
    && ${#_taw_shell_cmds[@]} -eq 0 \
    && "$_taw_agent_env_override" != true ]]
}

_taw_create_tmux_window() {
  local _taw_created _taw_created_window _taw_created_pane _taw_window_id _taw_editor_pane
  local _taw_agent_pane _taw_shell_pane _taw_last_shell_pane _taw_shell_cmd _taw_existing_window
  local _taw_shell_anchor_pane
  local _taw_existing_session_id _taw_existing_window_id _taw_existing_pane_id _taw_existing_rest

  if [[ "$_taw_peer" == true ]]; then
    if [[ "$_taw_force" != true ]]; then
      _taw_existing_window="$(_taw_peer_tmux_window_for_dir)" \
        || _taw_existing_window=
    fi
    if [[ -n "$_taw_existing_window" ]]; then
      _taw_existing_session_id="${_taw_existing_window%%$'\t'*}"
      _taw_existing_rest="${_taw_existing_window#*$'\t'}"
      _taw_existing_window_id="${_taw_existing_rest%%$'\t'*}"
      _taw_existing_pane_id="${_taw_existing_rest#*$'\t'}"
      [[ "$_taw_existing_pane_id" == "$_taw_existing_rest" ]] && _taw_existing_pane_id=

      if ! _taw_can_reuse_existing_window; then
        _taw_die "matching tmux window already exists; use --force to create a fresh layout"
        return 1
      fi

      if [[ "$_taw_existing_session_id" != "$_taw_current_session_id" ]]; then
        tmux link-window -d -s "$_taw_existing_window_id" \
          -t "$_taw_current_session_id:" || return 1
      fi
      _taw_switch_to_tmux_window "$_taw_existing_window_id" "$_taw_existing_pane_id"
      return
    fi

    _taw_created="$(tmux new-window -d -P -F '#{window_id} #{pane_id}' \
      -t "$_taw_current_session_id:" -n "$_taw_window_name" -c "$_taw_window_dir" \
      "$_taw_editor_cmd")" || return 1
  elif tmux has-session -t "$_taw_session_target" 2>/dev/null; then
    if _taw_can_reuse_existing_window && _taw_existing_window="$(_taw_existing_tmux_window_for_dir)"; then
      _taw_existing_window_id="${_taw_existing_window%%$'\t'*}"
      if [[ "$_taw_existing_window" == *$'\t'* ]]; then
        _taw_existing_pane_id="${_taw_existing_window#*$'\t'}"
      else
        _taw_existing_pane_id=
      fi
      _taw_switch_to_tmux_window "$_taw_existing_window_id" "$_taw_existing_pane_id"
      return
    fi

    _taw_created="$(tmux new-window -d -P -F '#{window_id} #{pane_id}' \
      -t "$_taw_session_target:" -n "$_taw_window_name" -c "$_taw_window_dir" \
      "$_taw_editor_cmd")" || return 1
  else
    if [[ -n "$_taw_project_session_target" ]]; then
      _taw_die "could not resolve tmux session: $_taw_session_name"
      return 1
    fi
    _taw_created="$(tmux new-session -d -P -F '#{window_id} #{pane_id}' \
      -s "$_taw_session_name" -n "$_taw_window_name" -c "$_taw_window_dir" \
      "$_taw_editor_cmd")" || return 1
  fi

  _taw_parse_created_window "$_taw_created"
  _taw_window_id="$_taw_created_window"
  _taw_editor_pane="$_taw_created_pane"
  tmux set-window-option -t "$_taw_window_id" automatic-rename off >/dev/null || return 1
  tmux set-window-option -t "$_taw_window_id" allow-rename off >/dev/null || return 1
  tmux rename-window -t "$_taw_window_id" "$_taw_window_name" >/dev/null || return 1

  _taw_shell_anchor_pane="$_taw_editor_pane"
  if [[ "$_taw_agent_enabled" == true ]]; then
    _taw_agent_pane="$(tmux split-window -h -P -F '#{pane_id}' \
      -t "$_taw_editor_pane" -c "$_taw_window_dir" "$_taw_agent_cmd")" || return 1
    _taw_shell_anchor_pane="$_taw_agent_pane"
  fi

  if (( ${#_taw_shell_cmds[@]} > 0 )); then
    if [[ -n "${_taw_shell_cmds[1]}" ]]; then
      if [[ "$_taw_agent_enabled" == true ]]; then
        _taw_shell_pane="$(tmux split-window -v -P -F '#{pane_id}' \
          -t "$_taw_shell_anchor_pane" -c "$_taw_window_dir" \
          "${_taw_shell_cmds[1]}")" || return 1
      else
        _taw_shell_pane="$(tmux split-window -h -P -F '#{pane_id}' \
          -t "$_taw_shell_anchor_pane" -c "$_taw_window_dir" \
          "${_taw_shell_cmds[1]}")" || return 1
      fi
    else
      if [[ "$_taw_agent_enabled" == true ]]; then
        _taw_shell_pane="$(tmux split-window -v -P -F '#{pane_id}' \
          -t "$_taw_shell_anchor_pane" -c "$_taw_window_dir")" || return 1
      else
        _taw_shell_pane="$(tmux split-window -h -P -F '#{pane_id}' \
          -t "$_taw_shell_anchor_pane" -c "$_taw_window_dir")" || return 1
      fi
    fi
    _taw_last_shell_pane="$_taw_shell_pane"

    for _taw_shell_cmd in "${_taw_shell_cmds[@]:1}"; do
      if [[ -n "$_taw_shell_cmd" ]]; then
        _taw_last_shell_pane="$(tmux split-window -h -P -F '#{pane_id}' \
          -t "$_taw_last_shell_pane" -c "$_taw_window_dir" \
          "$_taw_shell_cmd")" || return 1
      else
        _taw_last_shell_pane="$(tmux split-window -h -P -F '#{pane_id}' \
          -t "$_taw_last_shell_pane" -c "$_taw_window_dir")" || return 1
      fi
    done
  fi

  tmux select-pane -t "$_taw_editor_pane" >/dev/null 2>&1 || return 1
  _taw_switch_to_tmux_window "$_taw_window_id"
}

while (( $# > 0 )); do
  case "$1" in
    --)
      shift
      _taw_positionals+=( "$@" )
      break
      ;;
    -debug|--debug)
      _taw_debug=true
      shift
      ;;
    --peer)
      _taw_peer=true
      shift
      ;;
    --convert)
      _taw_convert=true
      shift
      ;;
    --force)
      _taw_force=true
      shift
      ;;
    -ts|--ts|-picker|--picker|-pick-project|--pick-project)
      _taw_project_picker_requested=true
      shift
      ;;
    -p|-proj|-prj|-r|-repo|-repository)
      (( $# >= 2 )) || _taw_die "$1 requires a value" || return 1
      [[ -n "$2" ]] || _taw_die "$1 requires a non-empty value" || return 1
      _taw_project_arg="$2"
      shift 2
      ;;
    -p=*|-proj=*|-prj=*|-r=*|-repo=*|-repository=*)
      _taw_project_arg="${1#*=}"
      [[ -n "$_taw_project_arg" ]] || _taw_die "${1%%=*} requires a non-empty value" || return 1
      shift
      ;;
    -agent)
      (( $# >= 2 )) || _taw_die "-agent requires a value" || return 1
      [[ -n "$2" ]] || _taw_die "-agent requires a non-empty value" || return 1
      _taw_agent_cmd="$2"
      _taw_agent_arg_provided=true
      shift 2
      ;;
    -agent=*)
      _taw_agent_cmd="${1#*=}"
      [[ -n "$_taw_agent_cmd" ]] || _taw_die "-agent requires a non-empty value" || return 1
      _taw_agent_arg_provided=true
      shift
      ;;
    -ed|-editor)
      (( $# >= 2 )) || _taw_die "$1 requires a value" || return 1
      [[ -n "$2" ]] || _taw_die "$1 requires a non-empty value" || return 1
      _taw_editor_cmd="$2"
      _taw_editor_arg_provided=true
      shift 2
      ;;
    -ed=*|-editor=*)
      _taw_editor_cmd="${1#*=}"
      [[ -n "$_taw_editor_cmd" ]] || _taw_die "-editor requires a non-empty value" || return 1
      _taw_editor_arg_provided=true
      shift
      ;;
    -b|-branch)
      (( $# >= 2 )) || _taw_die "$1 requires a value" || return 1
      [[ -n "$2" ]] || _taw_die "$1 requires a non-empty value" || return 1
      _taw_named_branch="$2"
      shift 2
      ;;
    -b=*|-branch=*)
      _taw_named_branch="${1#*=}"
      [[ -n "$_taw_named_branch" ]] || _taw_die "${1%%=*} requires a non-empty value" || return 1
      shift
      ;;
    -sh|-shell)
      if (( $# >= 2 )) && [[ "$2" != "--" && "$2" != -* ]]; then
        _taw_shell_cmds+=( "$2" )
        shift 2
      else
        _taw_shell_cmds+=( "" )
        shift
      fi
      ;;
    -sh=*|-shell=*)
      _taw_shell_cmds+=( "${1#*=}" )
      shift
      ;;
    -*)
      _taw_die "unknown option: $1"
      return 1
      ;;
    *)
      _taw_positionals+=( "$1" )
      shift
      ;;
  esac
done

(( ${#_taw_positionals[@]} <= 2 )) || {
  _taw_die "expected at most worktree and branch positional arguments"
  return 1
}

if [[ "$_taw_force" == true && "$_taw_peer" != true ]]; then
  _taw_die "--force requires --peer"
  return 1
fi

if [[ "$_taw_convert" == true ]]; then
  if (( ${#_taw_positionals[@]} != 1 )); then
    _taw_die "--convert requires exactly one project"
    return 1
  fi
  if [[ -n "$_taw_project_arg" || "$_taw_project_picker_requested" == true \
    || -n "$_taw_named_branch" || "$_taw_peer" == true || "$_taw_force" == true \
    || "$_taw_agent_arg_provided" == true || "$_taw_editor_arg_provided" == true \
    || ${#_taw_shell_cmds[@]} -gt 0 ]]; then
    _taw_die "--convert cannot be combined with project, branch, picker, peer, or layout options"
    return 1
  fi

  _taw_resolve_convert_project "${_taw_positionals[1]}" || return 1
  _taw_convert_project
  return
fi

if [[ "$_taw_peer" == true ]]; then
  [[ -n "${TMUX:-}" ]] || {
    _taw_die "--peer requires an active tmux client"
    return 1
  }
  _taw_current_session_id="$(tmux display-message -p '#{session_id}' 2>/dev/null)" || {
    _taw_die "could not resolve current tmux session"
    return 1
  }
  [[ -n "$_taw_current_session_id" ]] || {
    _taw_die "could not resolve current tmux session"
    return 1
  }
fi

if [[ -z "$_taw_editor_cmd" ]]; then
  if [[ -n "${EDITOR:-}" ]]; then
    _taw_editor_cmd="$EDITOR"
  elif command -v nvim >/dev/null 2>&1; then
    _taw_editor_cmd=nvim
  elif command -v vim >/dev/null 2>&1; then
    _taw_editor_cmd=vim
  else
    _taw_editor_cmd=nvim
  fi
fi

_taw_debug_dump "before project resolution"
_taw_resolve_project
case $? in
  0) ;;
  130) return 0 ;;
  *) return 1 ;;
esac

_taw_classify_operands || return 1

if [[ "$_taw_project_kind" == normal ]]; then
  _taw_window_dir="$_taw_project_dir"
  _taw_window_name="${_taw_project_dir:t}"
  if [[ -n "$_taw_base_ref" ]]; then
    _taw_resolve_branch_target "$_taw_base_ref" || return 1
    _taw_checkout_branch_target "$_taw_branch_target_name" "$_taw_branch_target_ref" || return 1
  elif [[ "$_taw_created_repo_branch_applied" == true || "$_taw_project_picker_requested" == true ]]; then
    :
  else
    _taw_select_branch_with_fzf
    case $? in
      0)
        [[ -n "$_taw_picker_branch" && -n "$_taw_picker_ref" ]] || {
          _taw_die "selected branch is incomplete"
          return 1
        }
        _taw_checkout_branch_target "$_taw_picker_branch" "$_taw_picker_ref" || return 1
        ;;
      2)
        ;;
      130)
        return 0
        ;;
      *)
        _taw_die "branch selection failed"
        return 1
        ;;
    esac
  fi
elif [[ -n "$_taw_worktree_arg" ]]; then
  local _taw_worktree_target _taw_worktree_branch

  _taw_worktree_target="$(_taw_resolve_bare_worktree_arg "$_taw_worktree_arg")" || return 1
  _taw_window_dir="${_taw_worktree_target%%$'\t'*}"
  _taw_worktree_branch="${_taw_worktree_target#*$'\t'}"
  _taw_window_name="${_taw_window_dir:t}"
  if [[ -n "$_taw_base_ref" ]]; then
    _taw_resolve_branch_target "$_taw_base_ref" || return 1
    _taw_prepare_worktree "$_taw_window_dir" "$_taw_worktree_branch" "$_taw_branch_target_ref" || return 1
  else
    _taw_prepare_worktree "$_taw_window_dir" "$_taw_worktree_branch" "" || return 1
  fi
elif [[ "$_taw_is_bare" == true ]]; then
  local _taw_branch_worktree _taw_branch_ref _taw_existing_worktree _taw_skip_prepare_worktree _taw_nonbare_worktree_count

  _taw_skip_prepare_worktree=false
  if [[ -n "$_taw_selected_worktree_dir" && -z "$_taw_base_ref" ]]; then
    _taw_window_dir="$_taw_selected_worktree_dir"
    _taw_skip_prepare_worktree=true
  elif [[ -n "$_taw_base_ref" ]]; then
    _taw_resolve_branch_target "$_taw_base_ref" || return 1
    _taw_branch_worktree="$_taw_branch_target_name"
    _taw_branch_ref="$_taw_branch_target_ref"
  else
    _taw_nonbare_worktree_count="$(_taw_bare_worktree_count)" || return 1
    if [[ "$_taw_project_picker_requested" != true ]] && (( _taw_nonbare_worktree_count > 0 )) && command -v fzf >/dev/null 2>&1; then
      _taw_select_bare_target_with_fzf
      case $? in
        0)
          case "$_taw_picker_kind" in
            worktree)
              [[ -n "$_taw_picker_path" ]] || {
                _taw_die "selected worktree is missing a path"
                return 1
              }
              _taw_window_dir="${_taw_picker_path:A}"
              _taw_skip_prepare_worktree=true
              ;;
            branch)
              [[ -n "$_taw_picker_branch" && -n "$_taw_picker_ref" ]] || {
                _taw_die "selected branch is incomplete"
                return 1
              }
              _taw_branch_worktree="$_taw_picker_branch"
              _taw_branch_ref="$_taw_picker_ref"
              ;;
            *)
              _taw_die "unknown picker selection: $_taw_picker_kind"
              return 1
              ;;
          esac
          ;;
        2)
          _taw_default_bare_target || {
            _taw_die "could not determine default branch for bare project"
            return 1
          }
          _taw_branch_worktree="$_taw_default_branch_result"
          _taw_branch_ref="$_taw_default_base_ref"
          ;;
        130)
          return 0
          ;;
        *)
          _taw_die "worktree selection failed"
          return 1
          ;;
      esac
    else
      _taw_default_bare_target || {
        _taw_die "could not determine default branch for bare project"
        return 1
      }
      _taw_branch_worktree="$_taw_default_branch_result"
      _taw_branch_ref="$_taw_default_base_ref"
    fi
  fi

  if [[ "$_taw_skip_prepare_worktree" != true ]]; then
    _taw_window_dir="${_taw_project_dir:A}/$_taw_branch_worktree"
    _taw_existing_worktree="$(_taw_existing_worktree_for_branch "$_taw_branch_worktree")" \
      || _taw_existing_worktree=
    if [[ -n "$_taw_existing_worktree" && "${_taw_existing_worktree:A}" != "${_taw_window_dir:A}" ]]; then
      if _taw_confirm "Branch $_taw_branch_worktree already has a worktree at $_taw_existing_worktree; open it?"; then
        _taw_window_dir="${_taw_existing_worktree:A}"
      fi
    fi
  fi

  _taw_window_name="${_taw_window_dir:t}"
  if [[ "$_taw_skip_prepare_worktree" != true ]]; then
    if [[ -n "$_taw_branch_ref" ]]; then
      _taw_prepare_worktree "$_taw_window_dir" "$_taw_branch_worktree" "$_taw_branch_ref" || return 1
    else
      _taw_prepare_orphan_worktree "$_taw_window_dir" "$_taw_branch_worktree" || return 1
    fi
  fi
else
  _taw_window_dir="$_taw_project_dir"
  _taw_window_name="${_taw_project_dir:t}"
fi

_taw_window_name="${_taw_window_dir:t}"
_taw_window_name="${_taw_window_name//:/_}"
if [[ -n "$_taw_project_session_name" ]]; then
  _taw_session_name="$_taw_project_session_name"
  _taw_session_target="${_taw_project_session_target:-$_taw_session_name}"
else
  _taw_project_name="${_taw_project_dir:t}"
  _taw_project_name="${_taw_project_name%.git}"
  _taw_session_name="${_taw_project_name//:/_}"
  _taw_session_target="$_taw_session_name"
fi

if [[ "$_taw_agent_arg_provided" == true ]]; then
  _taw_agent_enabled=true
elif [[ "$_taw_project_picker_requested" == true ]]; then
  _taw_agent_enabled=false
else
  _taw_agent_enabled=true
  if [[ -n "${TAW_AGENT:-}" ]]; then
    local _taw_agent_override

    _taw_agent_override="$(_taw_trim_whitespace "$TAW_AGENT")"
    if [[ -n "$_taw_agent_override" ]]; then
      _taw_agent_cmd="$_taw_agent_override"
      _taw_agent_env_override=true
    fi
  fi
fi

_taw_debug_dump "before tmux window"
_taw_create_tmux_window
