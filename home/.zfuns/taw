#!/usr/bin/env zsh

emulate -L zsh
setopt pipefail

local -a _taw_shell_cmds _taw_positionals
local _taw_project_arg _taw_project_picker_requested _taw_explicit_picker_requested _taw_picker_mode
local _taw_picker_context_resolved _taw_picker_layout _taw_agent_cmd _taw_editor_cmd _taw_named_branch
local _taw_agent_arg_provided _taw_editor_arg_provided _taw_agent_enabled _taw_created_repo_branch_applied _taw_debug
local _taw_agent_env_override _taw_editor_enabled _taw_shell_enabled _taw_shell_arg_provided
local _taw_peer _taw_force _taw_current_session_id _taw_convert
local _taw_worktree_arg _taw_base_ref _taw_window_dir _taw_window_name
local _taw_project_dir _taw_git_dir _taw_project_kind _taw_is_bare
local _taw_selected_worktree_dir
local _taw_session_name _taw_session_target _taw_project_name _taw_project_session_name _taw_project_session_target
local _taw_resolved_tmux_session_id _taw_resolved_tmux_session_name _taw_resolved_tmux_session_path
local _taw_selected_tmux_session_name _taw_selected_tmux_session_target
local _taw_default_branch_result _taw_default_base_ref
local _taw_branch_target_name _taw_branch_target_ref
local _taw_picker_kind _taw_picker_branch _taw_picker_ref _taw_picker_path

_taw_shell_cmds=()
_taw_positionals=()
_taw_project_arg=
_taw_project_picker_requested=false
_taw_explicit_picker_requested=false
_taw_picker_mode=
_taw_picker_context_resolved=false
_taw_picker_layout=
_taw_agent_cmd=codex
_taw_editor_cmd=
_taw_named_branch=
_taw_agent_arg_provided=false
_taw_editor_arg_provided=false
_taw_agent_enabled=true
_taw_editor_enabled=true
_taw_shell_enabled=false
_taw_shell_arg_provided=false
_taw_debug=false
_taw_agent_env_override=false
_taw_peer=false
_taw_force=false
_taw_current_session_id=
_taw_convert=false

_taw_die() {
  print -u2 -- "taw: $*"
  return 1
}

_taw_prompt() {
  local _taw_reply
  read "_taw_reply?$1" || return 1
  print -r -- "$_taw_reply"
}

_taw_prompt_project() {
  local _taw_prompt_text="$1" _taw_key _taw_rest _taw_reply

  if [[ -t 0 && -t 1 ]]; then
    IFS= read -r -k 1 "_taw_key?$_taw_prompt_text" || return 1
    case "$_taw_key" in
      $'\e')
        print
        return 130
        ;;
      $'\n'|$'\r')
        print
        return 0
        ;;
      *)
        print -n -- "$_taw_key"
        IFS= read -r _taw_rest || return 1
        print -r -- "$_taw_key$_taw_rest"
        ;;
    esac
    return
  fi

  _taw_reply="$(_taw_prompt "$_taw_prompt_text")" || return 1
  [[ "$_taw_reply" == $'\e' ]] && return 130
  print -r -- "$_taw_reply"
}

_taw_confirm() {
  local _taw_reply
  read "_taw_reply?$1 [y/N] " || return 1
  case "${_taw_reply:l}" in
    y|yes) return 0 ;;
    *) return 1 ;;
  esac
}

_taw_trim_whitespace() {
  local _taw_value="$1"

  _taw_value="${_taw_value#"${_taw_value%%[![:space:]]*}"}"
  _taw_value="${_taw_value%"${_taw_value##*[![:space:]]}"}"
  print -r -- "$_taw_value"
}

_taw_picker_safe() {
  local _taw_value
  for _taw_value in "$@"; do
    [[ "$_taw_value" != *[[:cntrl:]]* ]] || return 1
  done
}

_taw_require_picker_safe() {
  local _taw_label="$1"
  shift

  _taw_picker_safe "$@" || {
    _taw_die "$_taw_label contains control characters and cannot be used by the picker"
    return 1
  }
}

_taw_emit_picker_row() {
  (( ${+_taw_picker_row_count} )) && (( ++_taw_picker_row_count ))
  print -r -- "$1"
}

_taw_debug_dump() {
  [[ "$_taw_debug" == true ]] || return 0

  print -u2 -r -- "taw debug: $1"
  print -u2 -r -- "_taw_project_arg='$_taw_project_arg'"
  print -u2 -r -- "_taw_project_picker_requested=$_taw_project_picker_requested"
  print -u2 -r -- "_taw_explicit_picker_requested=$_taw_explicit_picker_requested"
  print -u2 -r -- "_taw_picker_mode='$_taw_picker_mode'"
  print -u2 -r -- "_taw_picker_layout='$_taw_picker_layout'"
  print -u2 -r -- "_taw_agent_cmd=$_taw_agent_cmd"
  print -u2 -r -- "_taw_agent_enabled=$_taw_agent_enabled"
  print -u2 -r -- "_taw_editor_cmd=$_taw_editor_cmd"
  print -u2 -r -- "_taw_named_branch='$_taw_named_branch'"
  print -u2 -r -- "_taw_agent_arg_provided=$_taw_agent_arg_provided"
  print -u2 -r -- "_taw_editor_arg_provided=$_taw_editor_arg_provided"
  print -u2 -r -- "_taw_peer=$_taw_peer"
  print -u2 -r -- "_taw_force=$_taw_force"
  print -u2 -r -- "_taw_current_session_id='$_taw_current_session_id'"
  print -u2 -r -- "_taw_worktree_arg='$_taw_worktree_arg'"
  print -u2 -r -- "_taw_base_ref='$_taw_base_ref'"
  print -u2 -r -- "_taw_window_dir='$_taw_window_dir'"
  print -u2 -r -- "_taw_window_name='$_taw_window_name'"
  print -u2 -r -- "_taw_project_dir=$_taw_project_dir"
  print -u2 -r -- "_taw_git_dir=$_taw_git_dir"
  print -u2 -r -- "_taw_project_kind=$_taw_project_kind"
  print -u2 -r -- "_taw_is_bare=$_taw_is_bare"
  print -u2 -r -- "_taw_selected_worktree_dir='$_taw_selected_worktree_dir'"
  print -u2 -r -- "_taw_session_name='$_taw_session_name'"
  print -u2 -r -- "_taw_session_target='$_taw_session_target'"
  print -u2 -r -- "_taw_project_name='$_taw_project_name'"
  print -u2 -r -- "_taw_project_session_name='$_taw_project_session_name'"
  print -u2 -r -- "_taw_project_session_target='$_taw_project_session_target'"
  print -u2 -r -- "_taw_selected_tmux_session_name='$_taw_selected_tmux_session_name'"
  print -u2 -r -- "_taw_selected_tmux_session_target='$_taw_selected_tmux_session_target'"
  print -u2 -r -- "_taw_default_branch_result='$_taw_default_branch_result'"
  print -u2 -r -- "_taw_default_base_ref='$_taw_default_base_ref'"
  print -u2 -r -- "_taw_picker_kind='$_taw_picker_kind'"
  print -u2 -r -- "_taw_picker_branch='$_taw_picker_branch'"
  print -u2 -r -- "_taw_picker_ref='$_taw_picker_ref'"
  print -u2 -r -- "_taw_picker_path='$_taw_picker_path'"
}

_taw_is_url() {
  [[ "$1" == http://* || "$1" == https://* || "$1" == git@*:* || "$1" == ssh://* ]]
}

_taw_is_bare_git_dir() {
  local _taw_candidate="$1" _taw_bare _taw_git

  [[ -d "$_taw_candidate" ]] || return 1
  _taw_candidate="${_taw_candidate:A}"
  _taw_bare="$(git -C "$_taw_candidate" rev-parse --is-bare-repository 2>/dev/null)" || return 1
  [[ "$_taw_bare" == true ]] || return 1
  _taw_git="$(git -C "$_taw_candidate" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || return 1
  [[ "${_taw_git:A}" == "$_taw_candidate" ]]
}

_taw_set_normal_project() {
  local _taw_project_root="$1" _taw_git_root="$2"

  _taw_project_dir="${_taw_project_root:A}"
  _taw_git_dir="${_taw_git_root:A}"
  _taw_project_kind=normal
  _taw_is_bare=false
}

_taw_primary_worktree_for_common_dir() {
  local _taw_common_dir="$1" _taw_output _taw_line

  _taw_output="$(git --git-dir "$_taw_common_dir" worktree list --porcelain 2>/dev/null)" \
    || return 1
  for _taw_line in "${(@f)_taw_output}"; do
    if [[ "$_taw_line" == worktree\ * ]]; then
      print -r -- "${_taw_line#worktree }"
      return 0
    fi
  done

  return 1
}

_taw_project_dir_for_bare_git_dir() {
  local _taw_bare_git_dir="${1:A}" _taw_fallback="${2:-}" _taw_name

  _taw_name="${_taw_bare_git_dir:t}"
  if [[ "$_taw_name" == .* ]]; then
    print -r -- "${_taw_bare_git_dir:h}"
  elif [[ "$_taw_name" == *.git ]]; then
    print -r -- "${_taw_bare_git_dir:h}/${_taw_name%.git}"
  elif [[ -n "$_taw_fallback" ]]; then
    print -r -- "${_taw_fallback:A}"
  else
    print -r -- "$_taw_bare_git_dir"
  fi
}

_taw_set_bare_project() {
  local _taw_bare_git_dir="$1" _taw_fallback="${2:-}"

  _taw_git_dir="${_taw_bare_git_dir:A}"
  _taw_project_dir="$(_taw_project_dir_for_bare_git_dir "$_taw_git_dir" "$_taw_fallback")" || return 1
  _taw_project_kind=bare
  _taw_is_bare=true
}

_taw_set_plain_project() {
  local _taw_project_root="$1"

  _taw_project_dir="${_taw_project_root:A}"
  _taw_git_dir=
  _taw_project_kind=plain
  _taw_is_bare=false
}

_taw_abs_path() {
  local _taw_path="$1"
  local _taw_cwd

  _taw_cwd="$(pwd -P)" || return 1
  if [[ "$_taw_path" == /* ]]; then
    print -r -- "${_taw_path:A}"
  else
    print -r -- "$_taw_cwd/$_taw_path"
  fi
}

_taw_bare_worktree_input_has_dot_segment() {
  local _taw_input="$1" _taw_segment
  local -a _taw_segments

  _taw_segments=( "${(@s:/:)_taw_input}" )
  for _taw_segment in "${_taw_segments[@]}"; do
    case "$_taw_segment" in
      .|..) return 0 ;;
    esac
  done

  return 1
}

_taw_validate_relative_bare_worktree_input() {
  local _taw_input="$1"

  [[ -n "$_taw_input" ]] || {
    _taw_die "invalid bare worktree path: $_taw_input"
    return 1
  }
  if [[ "$_taw_input" == /* ]] || _taw_bare_worktree_input_has_dot_segment "$_taw_input"; then
    _taw_die "invalid bare worktree path: $_taw_input"
    return 1
  fi
}

_taw_classify_existing_path() {
  local _taw_start="$1" _taw_inside _taw_top _taw_common _taw_actual _taw_primary _taw_child

  [[ -d "$_taw_start" ]] || return 1
  _taw_start="${_taw_start:A}"

  _taw_inside="$(git -C "$_taw_start" rev-parse --is-inside-work-tree 2>/dev/null)" || _taw_inside=
  if [[ "$_taw_inside" == true ]]; then
    _taw_top="$(git -C "$_taw_start" rev-parse --show-toplevel 2>/dev/null)" || return 1
    _taw_top="${_taw_top:A}"
    _taw_common="$(git -C "$_taw_top" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
    _taw_common="${_taw_common:A}"
    _taw_actual="$(git -C "$_taw_top" rev-parse --path-format=absolute --git-dir 2>/dev/null)" \
      || return 1
    _taw_actual="${_taw_actual:A}"

    if _taw_is_bare_git_dir "$_taw_common"; then
      _taw_set_bare_project "$_taw_common" "${_taw_common:h}"
      _taw_selected_worktree_dir="$_taw_top"
    elif [[ "$_taw_actual" != "$_taw_common" ]]; then
      _taw_primary="$(_taw_primary_worktree_for_common_dir "$_taw_common")" || return 1
      _taw_set_normal_project "$_taw_primary" "$_taw_common"
      _taw_selected_worktree_dir="$_taw_top"
    else
      _taw_set_normal_project "$_taw_top" "$_taw_common"
    fi
    return 0
  fi

  if _taw_is_bare_git_dir "$_taw_start"; then
    _taw_set_bare_project "$_taw_start" "${_taw_start:h}"
    return 0
  fi

  for _taw_child in "$_taw_start"/.git "$_taw_start"/.bare; do
    if _taw_is_bare_git_dir "$_taw_child"; then
      _taw_set_bare_project "$_taw_child" "$_taw_start"
      return 0
    fi
  done

  _taw_set_plain_project "$_taw_start"
  return 0
}

_taw_detect_current_project() {
  local _taw_saved_project_dir="$_taw_project_dir" _taw_saved_git_dir="$_taw_git_dir"
  local _taw_saved_project_kind="$_taw_project_kind" _taw_saved_is_bare="$_taw_is_bare"
  local _taw_saved_selected_worktree_dir="$_taw_selected_worktree_dir"

  _taw_classify_existing_path "$PWD" || return 1
  [[ "$_taw_project_kind" != plain ]] && return 0

  _taw_project_dir="$_taw_saved_project_dir"
  _taw_git_dir="$_taw_saved_git_dir"
  _taw_project_kind="$_taw_saved_project_kind"
  _taw_is_bare="$_taw_saved_is_bare"
  _taw_selected_worktree_dir="$_taw_saved_selected_worktree_dir"
  return 1
}

_taw_clone_prompted_repo() {
  local _taw_source="$1" _taw_dest _taw_clone_type
  local -a _taw_dest_entries

  _taw_dest="$(_taw_prompt "Clone destination: ")" || return 1
  [[ -n "$_taw_dest" ]] || _taw_die "clone destination is required" || return 1
  _taw_dest="$(_taw_abs_path "$_taw_dest")"

  _taw_clone_type="$(_taw_prompt "Clone type [normal/bare] (normal): ")" || return 1
  _taw_clone_type="${_taw_clone_type:l}"
  [[ -n "$_taw_clone_type" ]] || _taw_clone_type=normal

  case "$_taw_clone_type" in
    bare)
      if [[ -e "$_taw_dest/.git" ]]; then
        _taw_die "destination already has .git: $_taw_dest"
        return 1
      fi
      _taw_dest_entries=( "$_taw_dest"/*(N) "$_taw_dest"/.[!.]*(N) "$_taw_dest"/..?*(N) )
      if [[ -e "$_taw_dest" && ${#_taw_dest_entries[@]} -gt 0 ]]; then
        _taw_die "bare clone destination must be empty: $_taw_dest"
        return 1
      fi
      mkdir -p -- "$_taw_dest" || return 1
      git clone --bare "$_taw_source" "$_taw_dest/.git" || return 1
      ;;
    normal)
      git clone "$_taw_source" "$_taw_dest" || return 1
      ;;
    *)
      _taw_die "clone type must be bare or normal"
      return 1
      ;;
  esac

  print -r -- "$_taw_dest"
}

_taw_prompt_create_project() {
  local _taw_target_path="$1" _taw_kind _taw_repo_branch _taw_worktree_input _taw_worktree_path _taw_worktree_branch

  _taw_confirm "Create project at $_taw_target_path?" || return 1

  _taw_kind="$(_taw_prompt "Create kind [plain/repo/bare] (repo): ")" || return 1
  _taw_kind="${_taw_kind:l}"
  [[ -n "$_taw_kind" ]] || _taw_kind=repo
  case "$_taw_kind" in
    plain|repo|bare) ;;
    *)
      _taw_die "create kind must be plain, repo, or bare"
      return 1
      ;;
  esac

  case "$_taw_kind" in
    plain)
      if [[ -n "$_taw_named_branch" || ${#_taw_positionals[@]} -gt 0 ]]; then
        _taw_die "plain projects do not accept operands"
        return 1
      fi
      mkdir -p -- "$_taw_target_path" || return 1
      _taw_set_plain_project "$_taw_target_path"
      ;;
    repo)
      if [[ -n "$_taw_named_branch" && ${#_taw_positionals[@]} -gt 0 ]] || (( ${#_taw_positionals[@]} > 1 )); then
        _taw_die "repo projects do not accept two pending operands"
        return 1
      fi
      if [[ -n "$_taw_named_branch" ]]; then
        _taw_repo_branch="$_taw_named_branch"
      elif (( ${#_taw_positionals[@]} > 0 )); then
        _taw_repo_branch="${_taw_positionals[1]}"
      fi
      if [[ -n "$_taw_repo_branch" ]]; then
        _taw_validate_relative_bare_worktree_input "$_taw_repo_branch" || return 1
        git check-ref-format --branch "$_taw_repo_branch" >/dev/null 2>&1 || {
          _taw_die "invalid repo branch: $_taw_repo_branch"
          return 1
        }
      fi
      mkdir -p -- "$_taw_target_path" || return 1
      git -C "$_taw_target_path" init || return 1
      _taw_set_normal_project "$_taw_target_path" "$_taw_target_path/.git"
      if [[ -n "$_taw_repo_branch" ]]; then
        _taw_worktree_path="${_taw_target_path:A}/.worktrees/$_taw_repo_branch"
        _taw_prepare_orphan_worktree "$_taw_worktree_path" "$_taw_repo_branch" || return 1
        _taw_selected_worktree_dir="$_taw_worktree_path"
      fi
      _taw_named_branch=
      _taw_positionals=()
      ;;
    bare)
      if [[ -n "$_taw_named_branch" && ${#_taw_positionals[@]} -gt 0 ]] || (( ${#_taw_positionals[@]} > 1 )); then
        _taw_die "bare projects do not accept two pending operands"
        return 1
      fi
      if [[ -n "$_taw_named_branch" ]]; then
        _taw_worktree_input="$_taw_named_branch"
      elif (( ${#_taw_positionals[@]} > 0 )); then
        _taw_worktree_input="${_taw_positionals[1]}"
      fi
      if [[ -n "$_taw_worktree_input" ]]; then
        _taw_validate_relative_bare_worktree_input "$_taw_worktree_input" || return 1
        _taw_worktree_path="${_taw_target_path:A}/.worktrees/$_taw_worktree_input"
        _taw_worktree_branch="$_taw_worktree_input"
      fi
      if [[ -n "$_taw_worktree_branch" ]]; then
        git check-ref-format --branch "$_taw_worktree_branch" >/dev/null 2>&1 || {
          _taw_die "invalid bare worktree branch: $_taw_worktree_branch"
          return 1
        }
      fi
      mkdir -p -- "$_taw_target_path" || return 1
      git init --bare "$_taw_target_path/.git" || return 1
      _taw_set_bare_project "$_taw_target_path/.git" "$_taw_target_path" || return 1
      if [[ -n "$_taw_worktree_branch" ]]; then
        _taw_prepare_orphan_worktree "$_taw_worktree_path" "$_taw_worktree_branch" || return 1
        _taw_selected_worktree_dir="$_taw_worktree_path"
      else
        _taw_default_bare_target || {
          _taw_die "could not determine default branch for bare project"
          return 1
        }
        _taw_worktree_branch="$_taw_default_branch_result"
        git check-ref-format --branch "$_taw_worktree_branch" >/dev/null 2>&1 || {
          _taw_die "invalid bare worktree branch: $_taw_worktree_branch"
          return 1
        }
        _taw_worktree_path="${_taw_target_path:A}/.worktrees/$_taw_worktree_branch"
        _taw_prepare_orphan_worktree "$_taw_worktree_path" "$_taw_worktree_branch" || return 1
        _taw_selected_worktree_dir="$_taw_worktree_path"
      fi
      _taw_named_branch=
      _taw_positionals=()
      ;;
  esac
}

_taw_use_project_path() {
  local _taw_path="$1" _taw_label="$2" _taw_session_name="${3:-}" _taw_session_target="${4:-}" _taw_abs

  [[ -d "$_taw_path" ]] || {
    _taw_die "could not cd to project: $_taw_label"
    return 1
  }
  _taw_abs="${_taw_path:A}"
  _taw_classify_existing_path "$_taw_abs" || return 1
  [[ -z "$_taw_session_name" ]] || _taw_project_session_name="$_taw_session_name"
  [[ -z "$_taw_session_target" ]] || _taw_project_session_target="$_taw_session_target"
}

_taw_resolve_tmux_session_exact() {
  local _taw_query="$1" _taw_expected_path="${2:-}" _taw_expected_id="${3:-}"
  local _taw_sessions _taw_line _taw_session_id _taw_session _taw_path _taw_rest
  local _taw_tab=$'\t'

  _taw_sessions="$(tmux list-sessions -F '#{session_id}	#{session_name}	#{session_path}' 2>/dev/null)" || return 1

  for _taw_line in "${(@f)_taw_sessions}"; do
    _taw_session_id="${_taw_line%%${_taw_tab}*}"
    _taw_rest="${_taw_line#*${_taw_tab}}"
    [[ "$_taw_rest" == "$_taw_line" ]] && _taw_rest=
    _taw_session="${_taw_rest%%${_taw_tab}*}"
    _taw_path="${_taw_rest#*${_taw_tab}}"
    [[ "$_taw_path" == "$_taw_rest" ]] && _taw_path=
    [[ "$_taw_session" == "$_taw_query" ]] || continue
    if [[ -n "$_taw_expected_id" && "$_taw_session_id" != "$_taw_expected_id" ]]; then
      return 2
    fi
    [[ -n "$_taw_path" ]] || return 2
    if [[ -n "$_taw_expected_path" && "${_taw_path:A}" != "${_taw_expected_path:A}" ]]; then
      return 2
    fi
    _taw_resolved_tmux_session_id="$_taw_session_id"
    _taw_resolved_tmux_session_name="$_taw_session"
    _taw_resolved_tmux_session_path="$_taw_path"
    return 0
  done

  return 1
}

_taw_resolve_project_from_tmux_exact() {
  _taw_resolve_tmux_session_exact "$@" || return
  _taw_use_project_path "$_taw_resolved_tmux_session_path" \
    "$_taw_resolved_tmux_session_path" "$_taw_resolved_tmux_session_name" \
    "$_taw_resolved_tmux_session_id" || return 2
}

_taw_resolve_project_from_tmux() {
  local _taw_query="$1" _taw_sessions _taw_line _taw_session_id _taw_session _taw_path _taw_rest
  local _taw_tab=$'\t'

  _taw_resolve_project_from_tmux_exact "$_taw_query"
  case $? in
    0) return 0 ;;
    2) return 2 ;;
  esac

  _taw_sessions="$(tmux list-sessions -F '#{session_id}	#{session_name}	#{session_path}' 2>/dev/null)" || return 1

  for _taw_line in "${(@f)_taw_sessions}"; do
    _taw_session_id="${_taw_line%%${_taw_tab}*}"
    _taw_rest="${_taw_line#*${_taw_tab}}"
    [[ "$_taw_rest" == "$_taw_line" ]] && _taw_rest=
    _taw_session="${_taw_rest%%${_taw_tab}*}"
    _taw_path="${_taw_rest#*${_taw_tab}}"
    [[ "$_taw_path" == "$_taw_rest" ]] && _taw_path=
    [[ -n "$_taw_path" && "${_taw_path:t}" == "$_taw_query" ]] || continue
    _taw_use_project_path "$_taw_path" "$_taw_path" "$_taw_session" "$_taw_session_id"
    return
  done

  return 1
}

_taw_tmux_sessionizer_project_rows() {
  local _taw_root="$1" _taw_depth="$2" _taw_found_path
  local -a _taw_directories

  (( _taw_depth > 0 )) || return 0
  _taw_directories=("$_taw_root"/*(DNoN/))
  for _taw_found_path in "${_taw_directories[@]}"; do
    [[ "${_taw_found_path:t}" == .git ]] && continue
    _taw_picker_safe "$_taw_found_path" || continue
    _taw_emit_picker_row "$_taw_found_path"$'\t'"path"$'\t'"$_taw_found_path" || return 1
    _taw_tmux_sessionizer_project_rows \
      "$_taw_found_path" "$((_taw_depth - 1))" || return 1
  done
}

_taw_tmux_sessionizer_picker_rows() {
  local CONFIG_FILE_NAME="tmux-sessionizer.conf"
  local CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-sessionizer"
  local CONFIG_FILE="$CONFIG_DIR/$CONFIG_FILE_NAME"
  local TS_MAX_DEPTH
  local -a TS_SEARCH_PATHS TS_EXTRA_SEARCH_PATHS TS_SESSION_COMMANDS _taw_tmux_list_args
  local -a _taw_tmux_rows
  local _taw_picker_current_session_id _taw_sessions _taw_session_line
  local _taw_session_id _taw_session_name _taw_session_path _taw_session_rest
  local _taw_entry _taw_path _taw_depth
  local _taw_marker=__taw_picker_end__ _taw_session_format
  local _taw_tab=$'\t'

  if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
  fi

  if [[ -f "$CONFIG_FILE_NAME" ]]; then
    source "./$CONFIG_FILE_NAME"
  fi

  [[ ${#TS_SEARCH_PATHS[@]} -gt 0 ]] || TS_SEARCH_PATHS=(~ ~/personal ~/personal/dev/env/.config)
  if (( ${#TS_EXTRA_SEARCH_PATHS[@]} > 0 )); then
    TS_SEARCH_PATHS+=( "${TS_EXTRA_SEARCH_PATHS[@]}" )
  fi

  if [[ -n "${TMUX:-}" ]]; then
    _taw_picker_current_session_id="$(tmux display-message -p '#{session_id}' 2>/dev/null)" \
      || _taw_picker_current_session_id=
  fi

  _taw_session_format=$'#{session_id}\t#{session_name}\t#{session_path}'"$_taw_marker"
  _taw_tmux_list_args=(list-sessions -F "$_taw_session_format")
  if [[ -n "$_taw_picker_current_session_id" ]]; then
    _taw_tmux_list_args+=(
      -f "#{!=:#{session_id},$_taw_picker_current_session_id}"
    )
  fi
  _taw_sessions="$(tmux "${_taw_tmux_list_args[@]}" 2>/dev/null)" || _taw_sessions=
  for _taw_session_line in "${(@f)_taw_sessions}"; do
    [[ -n "$_taw_session_line" ]] || continue
    _taw_session_id="${_taw_session_line%%${_taw_tab}*}"
    [[ -n "$_taw_picker_current_session_id" \
      && "$_taw_session_id" == "$_taw_picker_current_session_id" ]] && continue
    _taw_session_rest="${_taw_session_line#*${_taw_tab}}"
    _taw_session_name="${_taw_session_rest%%${_taw_tab}*}"
    _taw_session_path="${_taw_session_rest#*${_taw_tab}}"
    [[ "$_taw_session_rest" != "$_taw_session_line" \
      && "$_taw_session_path" != "$_taw_session_rest" \
      && "$_taw_session_path" == *"$_taw_marker" ]] || {
      _taw_die "tmux returned invalid session metadata"
      return 1
    }
    _taw_session_path="${_taw_session_path%$_taw_marker}"
    [[ -n "$_taw_session_id" && -n "$_taw_session_name" \
      && -n "$_taw_session_path" ]] || {
      _taw_die "tmux returned invalid session metadata"
      return 1
    }
    _taw_require_picker_safe "tmux session" \
      "$_taw_session_id" "$_taw_session_name" "$_taw_session_path" || return 1
    _taw_tmux_rows+=("[TMUX] $_taw_session_name"$'\t'"tmux"$'\t'"$_taw_session_id"$'\t'"$_taw_session_name"$'\t'"$_taw_session_path")
  done
  for _taw_session_line in "${_taw_tmux_rows[@]}"; do
    _taw_emit_picker_row "$_taw_session_line" || return 1
  done

  for _taw_entry in "${TS_SEARCH_PATHS[@]}"; do
    if [[ "$_taw_entry" == *:<-> ]]; then
      _taw_path="${_taw_entry%:*}"
      _taw_depth="${_taw_entry##*:}"
    else
      _taw_path="$_taw_entry"
      _taw_depth="${TS_MAX_DEPTH:-1}"
    fi

    [[ -d "$_taw_path" ]] || continue
    _taw_tmux_sessionizer_project_rows "$_taw_path" "$_taw_depth" || return 1
  done
}

_taw_select_project_with_fzf() {
  local _taw_rows _taw_choice _taw_status

  command -v fzf >/dev/null 2>&1 || return 2
  _taw_rows="$(_taw_tmux_sessionizer_picker_rows)" || return 2
  [[ -n "$_taw_rows" ]] || return 2

  _taw_choice="$(print -r -- "$_taw_rows" | fzf --delimiter=$'\t' --with-nth=1 --prompt='taw project> ')"
  _taw_status=$?
  [[ $_taw_status -eq 0 ]] || return "$_taw_status"
  [[ -n "$_taw_choice" ]] || return 1

  print -r -- "${_taw_choice#*$'\t'}"
}

_taw_resolve_project_picker_choice() {
  local _taw_choice="$1" _taw_kind _taw_value _taw_tmux_id _taw_tmux_session
  local _taw_tmux_path _taw_tmux_rest

  _taw_kind="${_taw_choice%%$'\t'*}"
  _taw_value="${_taw_choice#*$'\t'}"
  case "$_taw_kind" in
    path)
      _taw_require_picker_safe "project path" "$_taw_value" || return 1
      _taw_resolve_project_arg "$_taw_value"
      ;;
    tmux)
      _taw_tmux_id="${_taw_value%%$'\t'*}"
      _taw_tmux_rest="${_taw_value#*$'\t'}"
      [[ "$_taw_tmux_rest" == "$_taw_value" ]] && _taw_tmux_rest=
      _taw_tmux_session="${_taw_tmux_rest%%$'\t'*}"
      _taw_tmux_path="${_taw_tmux_rest#*$'\t'}"
      [[ "$_taw_tmux_path" == "$_taw_tmux_rest" ]] && _taw_tmux_path=
      _taw_require_picker_safe "tmux session" \
        "$_taw_tmux_id" "$_taw_tmux_session" "$_taw_tmux_path" || return 1
      _taw_resolve_tmux_session_exact "$_taw_tmux_session" "$_taw_tmux_path" "$_taw_tmux_id" || {
        _taw_die "could not resolve tmux session: $_taw_tmux_session"
        return 1
      }
      _taw_selected_tmux_session_name="$_taw_resolved_tmux_session_name"
      _taw_selected_tmux_session_target="$_taw_resolved_tmux_session_id"
      ;;
    *)
      _taw_die "project picker returned an invalid row"
      return 1
      ;;
  esac
}

_taw_resolve_project_from_picker() {
  local _taw_input _taw_status

  _taw_input="$(_taw_select_project_with_fzf)"
  _taw_status=$?
  case "$_taw_status" in
    0)
      _taw_resolve_project_picker_choice "$_taw_input"
      return $?
      ;;
    130)
      return 130
      ;;
    *)
      _taw_die "project picker requires fzf and at least one project"
      return 1
      ;;
  esac
}

_taw_next_picker_mode() {
  case "$1" in
    session) print -r -- worktree ;;
    worktree) print -r -- branch ;;
    branch) print -r -- session ;;
    *) return 1 ;;
  esac
}

_taw_ensure_picker_project_context() {
  [[ "$_taw_picker_context_resolved" == true ]] && return 0
  _taw_detect_current_project || {
    _taw_die "$_taw_picker_mode picker requires a current Git project"
    return 1
  }
  _taw_picker_context_resolved=true
}

_taw_explicit_picker_rows() {
  local _taw_status
  local -i _taw_picker_row_count=0

  case "$_taw_picker_mode" in
    session)
      _taw_tmux_sessionizer_picker_rows
      ;;
    worktree)
      _taw_worktree_picker_rows
      ;;
    branch)
      _taw_picker_branch_rows
      ;;
    *)
      return 1
      ;;
  esac
  _taw_status=$?
  (( _taw_status == 0 )) || return "$_taw_status"
  (( _taw_picker_row_count > 0 )) || return 3
}

_taw_resolve_explicit_picker() {
  local _taw_output _taw_status _taw_producer_status _taw_query= _taw_key _taw_choice
  local _taw_status_line _taw_status_marker=$'\x1e__taw_picker_status__'
  local -a _taw_output_lines _taw_fields _taw_pipeline_status

  command -v fzf >/dev/null 2>&1 || {
    _taw_die "picker mode requires fzf"
    return 1
  }

  while true; do
    if [[ "$_taw_picker_mode" != session ]]; then
      _taw_ensure_picker_project_context || return 1
    fi
    _taw_output="$(_taw_explicit_picker_rows | fzf \
      --delimiter=$'\t' --with-nth=1 --prompt="$_taw_picker_mode> " \
      --header='Enter: default | C-S: shell | C-A: agent | Opt-Z: editor+shell | Opt-A: editor+agent | Opt-Enter: all | Tab: mode' \
      --print-query --expect=tab,ctrl-s,ctrl-a,alt-z,alt-a,alt-enter --query="$_taw_query" \
      --bind='load:transform:[ "$FZF_TOTAL_COUNT" -eq 0 ] && printf abort'
      _taw_pipeline_status=( "${pipestatus[@]}" )
      print -r -- "$_taw_status_marker"$'\t'"${_taw_pipeline_status[1]}"$'\t'"${_taw_pipeline_status[2]}"
    )"
    _taw_status_line="${_taw_output##*$'\n'}"
    _taw_fields=( "${(@ps:\t:)_taw_status_line}" )
    (( ${#_taw_fields[@]} == 3 )) \
      && [[ "${_taw_fields[1]}" == "$_taw_status_marker" \
        && "${_taw_fields[2]}" == <-> && "${_taw_fields[3]}" == <-> ]] || return 1
    _taw_producer_status="${_taw_fields[2]}"
    _taw_status="${_taw_fields[3]}"
    if [[ "$_taw_output" == "$_taw_status_line" ]]; then
      _taw_output=
    else
      _taw_output="${_taw_output%$'\n'$_taw_status_line}"
    fi

    case "$_taw_producer_status" in
      0|141) ;;
      3)
        _taw_die "$_taw_picker_mode picker has no targets"
        return 1
        ;;
      *) return 1 ;;
    esac
    case "$_taw_status" in
      0) ;;
      130) return 130 ;;
      *) return 1 ;;
    esac

    _taw_output_lines=( "${(@f)_taw_output}" )
    (( ${#_taw_output_lines[@]} >= 2 )) || return 1
    _taw_query="${_taw_output_lines[1]}"
    _taw_key="${_taw_output_lines[2]}"
    if [[ "$_taw_key" == tab ]]; then
      _taw_picker_mode="$(_taw_next_picker_mode "$_taw_picker_mode")" || return 1
      continue
    fi
    case "$_taw_key" in
      "") _taw_picker_layout= ;;
      ctrl-s) _taw_picker_layout=shell ;;
      ctrl-a) _taw_picker_layout=agent ;;
      alt-z) _taw_picker_layout=editor-shell ;;
      alt-a) _taw_picker_layout=editor-agent ;;
      alt-enter) _taw_picker_layout=editor-agent-shell ;;
      *) return 1 ;;
    esac

    (( ${#_taw_output_lines[@]} >= 3 )) || return 1
    _taw_choice="${_taw_output_lines[3]}"
    [[ -n "$_taw_choice" ]] || return 1
    if [[ "$_taw_picker_mode" == session ]]; then
      _taw_selected_worktree_dir=
      _taw_resolve_project_picker_choice "${_taw_choice#*$'\t'}"
      return $?
    fi

    _taw_fields=( "${(@ps:\t:)_taw_choice}" )
    (( ${#_taw_fields[@]} == 5 )) || return 1
    _taw_require_picker_safe "picker selection" "${_taw_fields[@]}" || return 1
    _taw_picker_kind="${_taw_fields[2]}"
    _taw_picker_branch="${_taw_fields[3]}"
    _taw_picker_ref="${_taw_fields[4]}"
    _taw_picker_path="${_taw_fields[5]}"
    case "$_taw_picker_mode" in
      worktree)
        [[ "$_taw_picker_kind" == worktree && -n "$_taw_picker_path" ]] || return 1
        _taw_selected_worktree_dir="${_taw_picker_path:A}"
        ;;
      branch)
        [[ "$_taw_picker_kind" == branch && -n "$_taw_picker_branch" \
          && -n "$_taw_picker_ref" ]] || return 1
        ;;
    esac
    return 0
  done
}

_taw_resolve_project() {
  local _taw_input _taw_status

  if [[ "$_taw_explicit_picker_requested" == true ]]; then
    if [[ -n "$_taw_project_arg" || -n "$_taw_named_branch" || ${#_taw_positionals[@]} -gt 0 ]]; then
      _taw_die "picker mode cannot be combined with -p, -b, or positionals"
      return 1
    fi
    _taw_resolve_explicit_picker
    return
  fi

  if [[ "$_taw_project_picker_requested" == true ]]; then
    if [[ -n "$_taw_project_arg" || -n "$_taw_named_branch" || ${#_taw_positionals[@]} -gt 0 ]]; then
      _taw_die "--pick-project cannot be combined with -p, -b, or positionals"
      return 1
    fi
    _taw_resolve_project_from_picker
    return
  fi

  if [[ "$_taw_peer" == true && -z "$_taw_project_arg" \
    && ${#_taw_positionals[@]} -gt 0 ]]; then
    _taw_project_arg="${_taw_positionals[1]}"
    if (( ${#_taw_positionals[@]} == 2 )); then
      _taw_positionals=( "${_taw_positionals[2]}" )
    else
      _taw_positionals=()
    fi
  fi

  if [[ -z "$_taw_project_arg" ]]; then
    if _taw_detect_current_project; then
      return 0
    fi

    if [[ -n "$_taw_named_branch" ]]; then
      _taw_die "-b cannot be used outside a project"
      return 1
    fi

    case "${#_taw_positionals[@]}" in
      0)
        _taw_input="$(_taw_prompt_project "Project, GitHub URL, or git repository directory (empty opens fzf): ")"
        _taw_status=$?
        case "$_taw_status" in
          0) ;;
          130) return 130 ;;
          *) return 1 ;;
        esac

        if [[ -z "$_taw_input" ]]; then
          _taw_project_picker_requested=true
          _taw_resolve_project_from_picker
          return
        fi

        _taw_project_arg="$_taw_input"
        ;;
      1)
        _taw_project_arg="${_taw_positionals[1]}"
        _taw_positionals=()
        ;;
      2)
        _taw_project_arg="${_taw_positionals[1]}"
        _taw_positionals=( "${_taw_positionals[2]}" )
        ;;
      *)
        _taw_die "expected at most project plus one positional outside a project"
        return 1
        ;;
    esac
  fi

  _taw_resolve_project_arg "$_taw_project_arg"
}

_taw_resolve_project_arg() {
  local _taw_arg="$1" _taw_resolved _taw_projects_candidate _taw_create_target

  if _taw_is_url "$_taw_arg"; then
    _taw_resolved="$(_taw_clone_prompted_repo "$_taw_arg")" || return 1
    _taw_use_project_path "$_taw_resolved" "$_taw_resolved"
    return
  fi

  if [[ -d "$_taw_arg" ]]; then
    _taw_use_project_path "$_taw_arg" "$_taw_arg"
    return
  fi
  [[ ! -e "$_taw_arg" && ! -L "$_taw_arg" ]] || {
    _taw_die "could not cd to project: $_taw_arg"
    return 1
  }

  _taw_create_target="$(_taw_abs_path "$_taw_arg")"
  if [[ "$_taw_arg" != /* && "$_taw_arg" != */* && -n "${PROJECTS_HOME:-}" ]]; then
    _taw_projects_candidate="${PROJECTS_HOME:A}/$_taw_arg"
    if [[ -d "$_taw_projects_candidate" ]]; then
      _taw_use_project_path "$_taw_projects_candidate" "$_taw_projects_candidate"
      return
    fi
    [[ ! -e "$_taw_projects_candidate" && ! -L "$_taw_projects_candidate" ]] || {
      _taw_die "could not cd to project: $_taw_projects_candidate"
      return 1
    }
    _taw_create_target="$_taw_projects_candidate"
  fi

  _taw_resolve_project_from_tmux "$_taw_arg"
  case $? in
    0) return 0 ;;
    2) return 1 ;;
  esac

  _taw_prompt_create_project "$_taw_create_target"
}

_taw_resolve_convert_project() {
  local _taw_arg="$1" _taw_projects_candidate

  if _taw_is_url "$_taw_arg"; then
    _taw_die "--convert requires an existing normal project"
    return 1
  fi

  if [[ -d "$_taw_arg" ]]; then
    _taw_use_project_path "$_taw_arg" "$_taw_arg"
    return
  fi
  [[ ! -e "$_taw_arg" && ! -L "$_taw_arg" ]] || {
    _taw_die "could not resolve project: $_taw_arg"
    return 1
  }

  if [[ "$_taw_arg" != /* && "$_taw_arg" != */* && -n "${PROJECTS_HOME:-}" ]]; then
    _taw_projects_candidate="${PROJECTS_HOME:A}/$_taw_arg"
    if [[ -d "$_taw_projects_candidate" ]]; then
      _taw_use_project_path "$_taw_projects_candidate" "$_taw_projects_candidate"
      return
    fi
  fi

  _taw_resolve_project_from_tmux "$_taw_arg"
  case $? in
    0) return 0 ;;
    2) return 1 ;;
  esac

  _taw_die "could not resolve existing project: $_taw_arg"
  return 1
}

_taw_classify_operands() {
  local _taw_positionals_count="${#_taw_positionals[@]}"

  _taw_worktree_arg=
  _taw_base_ref=

  case "$_taw_project_kind" in
    plain)
      if [[ -n "$_taw_named_branch" || $_taw_positionals_count -gt 0 ]]; then
        _taw_die "plain projects do not accept operands"
        return 1
      fi
      ;;
    normal)
      if [[ -n "$_taw_named_branch" ]]; then
        if (( _taw_positionals_count == 0 )); then
          _taw_base_ref="$_taw_named_branch"
        else
          _taw_die "normal projects do not accept positional operands with -b"
          return 1
        fi
      else
        case "$_taw_positionals_count" in
          0) ;;
          1)
            _taw_worktree_arg="${_taw_positionals[1]}"
            ;;
          2)
            _taw_worktree_arg="${_taw_positionals[1]}"
            _taw_base_ref="${_taw_positionals[2]}"
            ;;
          *)
            _taw_die "normal projects accept at most two positional operands"
            return 1
            ;;
        esac
      fi
      ;;
    bare)
      if [[ -n "$_taw_named_branch" ]]; then
        if (( _taw_positionals_count == 0 )); then
          _taw_base_ref="$_taw_named_branch"
        else
          _taw_die "bare projects do not accept positional operands with -b"
          return 1
        fi
      else
        case "$_taw_positionals_count" in
          0) ;;
          1)
            _taw_worktree_arg="${_taw_positionals[1]}"
            ;;
          2)
            _taw_worktree_arg="${_taw_positionals[1]}"
            _taw_base_ref="${_taw_positionals[2]}"
            ;;
          *)
            _taw_die "bare projects accept at most two positional operands"
            return 1
            ;;
        esac
      fi
      ;;
  esac
}

_taw_git() {
  if [[ "$_taw_is_bare" == true ]]; then
    git --git-dir "$_taw_git_dir" "$@"
  else
    git -C "$_taw_project_dir" "$@"
  fi
}

_taw_ensure_remote_fetch_refspec() {
  local _taw_remote_name="$1"

  if ! _taw_git config --get-all "remote.$_taw_remote_name.fetch" >/dev/null 2>&1; then
    _taw_git config --add "remote.$_taw_remote_name.fetch" \
      "+refs/heads/*:refs/remotes/$_taw_remote_name/*"
  fi
}

_taw_branch_exists() {
  _taw_git show-ref --verify --quiet "refs/heads/$1"
}

_taw_remote_names_sorted() {
  local -a _taw_remotes _taw_sorted_remotes
  local _taw_remote

  _taw_remotes=( "${(@f)$(_taw_git remote 2>/dev/null)}" )
  for _taw_remote in "${_taw_remotes[@]}"; do
    [[ -n "$_taw_remote" ]] || continue
    [[ "$_taw_remote" == origin ]] && print -r -- "$_taw_remote" || _taw_sorted_remotes+=( "$_taw_remote" )
  done

  if (( ${#_taw_sorted_remotes[@]} > 0 )); then
    _taw_sorted_remotes=( "${(@o)_taw_sorted_remotes}" )
    for _taw_remote in "${_taw_sorted_remotes[@]}"; do
      print -r -- "$_taw_remote"
    done
  fi
}

_taw_remote_branch_for_path() {
  local _taw_path="$1" _taw_remote_candidate _taw_remote_prefix _taw_remote _taw_branch
  local -a _taw_remotes

  _taw_remotes=( "${(@f)$(_taw_git remote 2>/dev/null)}" )
  for _taw_remote_candidate in "${_taw_remotes[@]}"; do
    _taw_remote_prefix="$_taw_remote_candidate/"
    if [[ "$_taw_path" == "$_taw_remote_prefix"* ]]; then
      if [[ -z "$_taw_remote" || ${#_taw_remote_candidate} -gt ${#_taw_remote} ]]; then
        _taw_remote="$_taw_remote_candidate"
        _taw_branch="${_taw_path#$_taw_remote_prefix}"
      fi
    fi
  done

  [[ -n "$_taw_remote" && "$_taw_branch" != "$_taw_path" && "$_taw_branch" != HEAD ]] || return 1
  print -r -- "$_taw_remote	$_taw_branch"
}

_taw_has_configured_remote_prefix() {
  local _taw_path="$1" _taw_remote

  for _taw_remote in "${(@f)$(_taw_git remote 2>/dev/null)}"; do
    [[ -n "$_taw_remote" && "$_taw_path" == "$_taw_remote/"* ]] && return 0
  done

  return 1
}

_taw_remote_target_for_branch_name() {
  local _taw_branch="$1" _taw_remote _taw_remote_ref
  local -a _taw_remote_names

  _taw_remote_names=( "${(@f)$(_taw_remote_names_sorted)}" )
  for _taw_remote in "${_taw_remote_names[@]}"; do
    [[ -n "$_taw_remote" ]] || continue
    _taw_remote_ref="refs/remotes/$_taw_remote/$_taw_branch"
    if _taw_git rev-parse --verify --quiet "${_taw_remote_ref}^{commit}" >/dev/null; then
      print -r -- "$_taw_remote	$_taw_branch"
      return 0
    fi
  done

  return 1
}

_taw_local_branch_for_commit() {
  local _taw_commit="$1" _taw_line _taw_branch _taw_branch_commit
  local _taw_output

  _taw_output="$(_taw_git for-each-ref --sort=refname --format='%(refname:short) %(objectname)' refs/heads 2>/dev/null)" || return 1
  for _taw_line in "${(@f)_taw_output}"; do
    _taw_branch="${_taw_line%% *}"
    _taw_branch_commit="${_taw_line#* }"
    [[ "$_taw_branch_commit" == "$_taw_commit" ]] || continue
    print -r -- "$_taw_branch"
    return 0
  done

  return 1
}

_taw_resolve_branch_target() {
  local _taw_input="$1" _taw_fallback_branch="${2:-}" _taw_fallback_ref="${3:-}"
  local _taw_remote_target _taw_remote _taw_branch _taw_commit

  _taw_branch_target_name=
  _taw_branch_target_ref=

  [[ "$_taw_input" == refs/remotes/* ]] && return 1

  if _taw_branch_exists "$_taw_input"; then
    _taw_branch_target_name="$_taw_input"
    _taw_branch_target_ref="$_taw_input"
    return 0
  fi

  if [[ "$_taw_input" == */* ]]; then
    if _taw_remote_target="$(_taw_remote_branch_for_path "$_taw_input")"; then
      _taw_remote="${_taw_remote_target%%	*}"
      _taw_branch="${_taw_remote_target#*	}"
      if _taw_git rev-parse --verify --quiet "refs/remotes/$_taw_remote/$_taw_branch^{commit}" >/dev/null; then
        _taw_branch_target_name="$_taw_branch"
        _taw_branch_target_ref="$_taw_remote/$_taw_branch"
        return 0
      fi
      return 1
    fi
  fi

  if _taw_remote_target="$(_taw_remote_target_for_branch_name "$_taw_input")"; then
    _taw_remote="${_taw_remote_target%%	*}"
    _taw_branch="${_taw_remote_target#*	}"
    _taw_branch_target_name="$_taw_branch"
    _taw_branch_target_ref="$_taw_remote/$_taw_branch"
    return 0
  fi

  if [[ -n "$_taw_fallback_branch" ]]; then
    _taw_branch_target_name="$_taw_fallback_branch"
    _taw_branch_target_ref="${_taw_fallback_ref:-$_taw_fallback_branch}"
    return 0
  fi

  return 1
}

_taw_picker_branch_rows() {
  local _taw_local_refs _taw_remote_refs _taw_ref _taw_branch
  local _taw_remote_name _taw_remote_branch _taw_remote_path _taw_row_remote
  local _taw_remote_candidate _taw_remote_prefix
  local -a _taw_remote_names
  local -A _taw_seen_by_branch _taw_remote_by_ref _taw_branch_by_ref

  _taw_local_refs="$(_taw_git for-each-ref --sort=refname --format='%(refname)' refs/heads 2>/dev/null)" \
    || return 1
  for _taw_ref in "${(@f)_taw_local_refs}"; do
    _taw_branch="${_taw_ref#refs/heads/}"
    [[ -n "$_taw_branch" && -z "${_taw_seen_by_branch[$_taw_branch]-}" ]] || continue
    _taw_seen_by_branch[$_taw_branch]=local
    _taw_emit_picker_row "$_taw_branch"$'\t'"branch"$'\t'"$_taw_branch"$'\t'"$_taw_branch"$'\t' || return 1
  done

  _taw_remote_refs="$(_taw_git for-each-ref --sort=refname --format='%(refname)' refs/remotes 2>/dev/null)" \
    || return 1
  _taw_remote_names=( "${(@f)$(_taw_remote_names_sorted)}" )
  for _taw_ref in "${(@f)_taw_remote_refs}"; do
    _taw_remote_path="${_taw_ref#refs/remotes/}"
    _taw_row_remote=
    _taw_remote_branch=
    for _taw_remote_candidate in "${_taw_remote_names[@]}"; do
      _taw_remote_prefix="$_taw_remote_candidate/"
      if [[ "$_taw_remote_path" == "$_taw_remote_prefix"* \
        && ( -z "$_taw_row_remote" \
          || ${#_taw_remote_candidate} -gt ${#_taw_row_remote} ) ]]; then
        _taw_row_remote="$_taw_remote_candidate"
        _taw_remote_branch="${_taw_remote_path#$_taw_remote_prefix}"
      fi
    done
    [[ -n "$_taw_row_remote" && -n "$_taw_remote_branch" \
      && "$_taw_remote_branch" != HEAD ]] || continue
    _taw_remote_by_ref[$_taw_ref]="$_taw_row_remote"
    _taw_branch_by_ref[$_taw_ref]="$_taw_remote_branch"
  done

  for _taw_remote_name in "${_taw_remote_names[@]}"; do
    [[ -n "$_taw_remote_name" ]] || continue
    for _taw_ref in "${(@f)_taw_remote_refs}"; do
      _taw_row_remote="${_taw_remote_by_ref[$_taw_ref]-}"
      _taw_remote_branch="${_taw_branch_by_ref[$_taw_ref]-}"
      [[ "$_taw_row_remote" == "$_taw_remote_name" && -n "$_taw_remote_branch" && -z "${_taw_seen_by_branch[$_taw_remote_branch]-}" ]] || continue
      _taw_seen_by_branch[$_taw_remote_branch]=remote
      _taw_emit_picker_row "$_taw_remote_branch"$'\t'"branch"$'\t'"$_taw_remote_branch"$'\t'"$_taw_remote_name/$_taw_remote_branch"$'\t' || return 1
    done
  done
}

_taw_bare_worktree_count() {
  local _taw_output _taw_line _taw_path _taw_is_bare_entry _taw_count=0

  _taw_output="$(_taw_git worktree list --porcelain 2>/dev/null)" || return 1
  for _taw_line in "${(@f)_taw_output}" ""; do
    case "$_taw_line" in
      worktree\ *)
        _taw_path="${_taw_line#worktree }"
        _taw_is_bare_entry=false
        ;;
      bare)
        _taw_is_bare_entry=true
        ;;
      "")
        if [[ "$_taw_is_bare_entry" != true && -n "$_taw_path" ]]; then
          _taw_count=$((_taw_count + 1))
        fi
        ;;
    esac
  done

  print -r -- "$_taw_count"
}

_taw_default_bare_target() {
  local _taw_head_branch _taw_refs

  if _taw_default_branch; then
    return 0
  fi

  _taw_refs="$(_taw_git for-each-ref --count=1 --format='%(refname)' 2>/dev/null)" || return 1
  [[ -n "$_taw_refs" ]] && return 1

  if _taw_head_branch="$(_taw_git symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
    _taw_default_branch_result="$_taw_head_branch"
    _taw_default_base_ref=
    return 0
  fi

  return 1
}

_taw_default_branch() {
  local _taw_branch _taw_remote_head _taw_head_commit

  _taw_default_branch_result=
  _taw_default_base_ref=

  if _taw_branch="$(_taw_git symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
    _taw_branch="${_taw_branch#refs/heads/}"
    _taw_branch="${_taw_branch#heads/}"
    _taw_branch="${_taw_branch#origin/}"
    if _taw_branch_exists "$_taw_branch"; then
      _taw_default_branch_result="$_taw_branch"
      _taw_default_base_ref="$_taw_branch"
      return 0
    fi
  fi

  if _taw_head_commit="$(_taw_git rev-parse --verify --quiet HEAD^{commit} 2>/dev/null)"; then
    if _taw_branch="$(_taw_local_branch_for_commit "$_taw_head_commit")"; then
      _taw_default_branch_result="$_taw_branch"
      _taw_default_base_ref="$_taw_branch"
      return 0
    fi
  fi

  if _taw_remote_head="$(_taw_git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"; then
    _taw_branch="${_taw_remote_head#origin/}"
    if _taw_branch_exists "$_taw_branch"; then
      _taw_default_branch_result="$_taw_branch"
      _taw_default_base_ref="$_taw_branch"
      return 0
    fi
    if _taw_git rev-parse --verify --quiet "refs/remotes/origin/$_taw_branch^{commit}" >/dev/null; then
      _taw_default_branch_result="$_taw_branch"
      _taw_default_base_ref="origin/$_taw_branch"
      return 0
    fi
  fi

  for _taw_branch in main master; do
    _taw_branch_exists "$_taw_branch" || continue
    _taw_default_branch_result="$_taw_branch"
    _taw_default_base_ref="$_taw_branch"
    return 0
  done

  return 1
}

_taw_move_worktree_entries() {
  local _taw_source="$1" _taw_dest="$2" _taw_entry _taw_target
  local -a _taw_entries

  mkdir -p -- "$_taw_dest" || return 1
  _taw_entries=( "$_taw_source"/*(N) "$_taw_source"/.[!.]*(N) "$_taw_source"/..?*(N) )
  for _taw_entry in "${_taw_entries[@]}"; do
    [[ "${_taw_entry:t}" == .git ]] && continue
    _taw_target="$_taw_dest/${_taw_entry:t}"
    [[ ! -e "$_taw_target" && ! -L "$_taw_target" ]] || return 1
    mv -n -- "$_taw_entry" "$_taw_target" || return 1
    [[ ! -e "$_taw_entry" && ! -L "$_taw_entry" ]] || return 1
  done
}

_taw_move_primary_entries() {
  local _taw_source="$1" _taw_dest="$2" _taw_protected="${3:-}"
  local _taw_entry _taw_target
  local -a _taw_entries

  [[ -z "$_taw_protected" ]] || _taw_protected="${_taw_protected:A}"
  mkdir -p -- "$_taw_dest" || return 1
  _taw_entries=( "$_taw_source"/*(N) "$_taw_source"/.[!.]*(N) "$_taw_source"/..?*(N) )
  for _taw_entry in "${_taw_entries[@]}"; do
    [[ "${_taw_entry:t}" == .git || "${_taw_entry:t}" == .worktrees ]] && continue
    [[ -z "$_taw_protected" || "${_taw_entry:A}" != "$_taw_protected" ]] || continue
    _taw_target="$_taw_dest/${_taw_entry:t}"
    [[ ! -e "$_taw_target" && ! -L "$_taw_target" ]] || return 1
    mv -n -- "$_taw_entry" "$_taw_target" || return 1
    [[ ! -e "$_taw_entry" && ! -L "$_taw_entry" ]] || return 1
  done
}

_taw_prune_empty_worktree_parents() {
  local _taw_source="${1:A}" _taw_root="${2:A}" _taw_parent

  _taw_parent="${_taw_source:h}"
  while [[ "$_taw_parent" == "$_taw_root"/* ]]; do
    rmdir -- "$_taw_parent" 2>/dev/null || break
    _taw_parent="${_taw_parent:h}"
  done
}

_taw_status_records_preserved() {
  local _taw_before="$1" _taw_after="$2" _taw_record
  local -A _taw_after_records

  for _taw_record in "${(@f)_taw_after}"; do
    [[ -n "$_taw_record" ]] || continue
    _taw_after_records[$_taw_record]=1
  done
  for _taw_record in "${(@f)_taw_before}"; do
    [[ -n "$_taw_record" ]] || continue
    [[ -n "${_taw_after_records[$_taw_record]-}" ]] || return 1
  done
}

_taw_convert_project() {
  local _taw_project_root="${_taw_project_dir:A}" _taw_original_git_dir="${_taw_git_dir:A}"
  local _taw_original_git_name="${_taw_original_git_dir:t}"
  local _taw_active_git_dir="${_taw_original_git_dir:A}" _taw_default_branch
  local _taw_default_ref _taw_default_commit _taw_default_created=false
  local _taw_output _taw_line _taw_path _taw_branch_ref _taw_branch _taw_dest_name
  local _taw_existing_destination _taw_other_path
  local _taw_default_path= _taw_default_count=0 _taw_locked=false
  local _taw_is_bare_entry=false _taw_backup _taw_failure= _taw_actual_git_dir
  local _taw_before_default_status= _taw_after_default_status _taw_saved_pwd
  local _taw_caller_target=outside _taw_caller_relative= _taw_caller_original_path=
  local _taw_caller_relocated=false _taw_default_git_dir
  local _taw_common_moved=false _taw_default_staged=false _taw_default_removed=false
  local _taw_config_changed=false _taw_rollback_ok=true
  local _taw_wrapper_staged=false _taw_wrapper_entry _taw_default_entry
  local _taw_index_present=false _taw_i _taw_operation_path _taw_lock_file
  local _taw_shared_index
  local -a _taw_paths _taw_destinations
  local -a _taw_statuses _taw_moved_flags _taw_operation_names _taw_modules
  local -a _taw_wrapper_entries _taw_default_entries

  [[ "$_taw_project_kind" == bare && "$_taw_is_bare" == true ]] || {
    _taw_die "--convert requires a bare git project"
    return 1
  }
  if [[ "$_taw_original_git_name" != .* && "$_taw_original_git_name" != *.git ]]; then
    _taw_die "--convert does not support suffixless bare repositories: $_taw_original_git_dir"
    return 1
  fi

  _taw_default_bare_target || {
    _taw_die "could not determine the bare repository's default branch"
    return 1
  }
  _taw_default_branch="$_taw_default_branch_result"
  _taw_default_ref="$_taw_default_base_ref"
  git check-ref-format --branch "$_taw_default_branch" >/dev/null 2>&1 || {
    _taw_die "invalid default branch: $_taw_default_branch"
    return 1
  }

  _taw_operation_names=(
    MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-apply
    rebase-merge sequencer BISECT_START
  )
  for _taw_operation_path in "${_taw_operation_names[@]}"; do
    _taw_operation_path="$(git --git-dir "$_taw_original_git_dir" rev-parse \
      --path-format=absolute --git-path "$_taw_operation_path" 2>/dev/null)" \
      || return 1
    if [[ -e "$_taw_operation_path" ]]; then
      _taw_die "--convert does not support an active git operation"
      return 1
    fi
  done
  _taw_lock_file="$(find "$_taw_original_git_dir" -name '*.lock' -print -quit 2>/dev/null)" \
    || return 1
  [[ -z "$_taw_lock_file" ]] || {
    _taw_die "--convert cannot run while git lock files exist"
    return 1
  }
  _taw_modules=( "$_taw_original_git_dir/modules"/*(ND) )
  (( ${#_taw_modules[@]} == 0 )) || {
    _taw_die "--convert does not support initialized submodules"
    return 1
  }
  if [[ "$(git --git-dir "$_taw_original_git_dir" config \
    --bool extensions.worktreeConfig 2>/dev/null)" == true ]]; then
    _taw_die "--convert does not support worktree-specific config"
    return 1
  fi

  _taw_output="$(git --git-dir "$_taw_original_git_dir" \
    worktree list --porcelain 2>/dev/null)" || return 1
  for _taw_line in "${(@f)_taw_output}" ""; do
    case "$_taw_line" in
      worktree\ *)
        _taw_path="${_taw_line#worktree }"
        _taw_branch_ref=
        _taw_locked=false
        _taw_is_bare_entry=false
        ;;
      branch\ *)
        _taw_branch_ref="${_taw_line#branch }"
        ;;
      detached) ;;
      locked*)
        _taw_locked=true
        ;;
      bare)
        _taw_is_bare_entry=true
        ;;
      "")
        if [[ "$_taw_is_bare_entry" != true && -n "$_taw_path" ]]; then
          [[ "$_taw_locked" != true ]] || {
            _taw_die "--convert does not support locked worktrees: $_taw_path"
            return 1
          }
          for _taw_operation_path in "${_taw_operation_names[@]}"; do
            _taw_operation_path="$(git -C "$_taw_path" rev-parse \
              --path-format=absolute --git-path "$_taw_operation_path" 2>/dev/null)" \
              || return 1
            if [[ -e "$_taw_operation_path" ]]; then
              _taw_die "--convert does not support an active Git operation: $_taw_path"
              return 1
            fi
          done
          if [[ -n "$(git -C "$_taw_path" ls-files -u 2>/dev/null)" ]]; then
            _taw_die "--convert does not support unmerged entries: $_taw_path"
            return 1
          fi
          if [[ "$(git -C "$_taw_path" config --bool core.sparseCheckout \
            2>/dev/null)" == true ]]; then
            _taw_die "--convert does not support sparse worktrees: $_taw_path"
            return 1
          fi
          _taw_shared_index="$(git -C "$_taw_path" rev-parse \
            --shared-index-path 2>/dev/null)" || _taw_shared_index=
          if [[ -n "$_taw_shared_index" ]]; then
            _taw_die "--convert does not support split indexes: $_taw_path"
            return 1
          fi
          if [[ -n "$_taw_branch_ref" ]]; then
            _taw_branch="${_taw_branch_ref#refs/heads/}"
            _taw_dest_name="$_taw_branch"
          else
            _taw_branch=
            _taw_dest_name="${_taw_path:t}"
            [[ -n "$_taw_dest_name" ]] || {
              _taw_die "could not name detached worktree: $_taw_path"
              return 1
            }
          fi
          if [[ "$_taw_branch" == "$_taw_default_branch" ]]; then
            _taw_default_count=$((_taw_default_count + 1))
            _taw_default_path="${_taw_path:A}"
          else
            local _taw_destination="${_taw_project_root:A}/.worktrees/$_taw_dest_name"
            for _taw_existing_destination in "${_taw_destinations[@]}"; do
              if [[ "${_taw_destination:A}" == "${_taw_existing_destination:A}" \
                || "${_taw_destination:A}" == "${_taw_existing_destination:A}"/* \
                || "${_taw_existing_destination:A}" == "${_taw_destination:A}"/* ]]; then
                _taw_die "worktree destination collision: $_taw_destination"
                return 1
              fi
            done
            if [[ "${_taw_path:A}" != "${_taw_destination:A}" \
              && ( -e "$_taw_destination" || -L "$_taw_destination" ) ]]; then
              _taw_die "worktree destination already exists: $_taw_destination"
              return 1
            fi
            _taw_paths+=( "${_taw_path:A}" )
            _taw_destinations+=( "${_taw_destination:A}" )
            _taw_moved_flags+=( false )
            _taw_statuses+=( "$(git -C "$_taw_path" status \
              --porcelain=v2 --branch --untracked-files=all)" ) || return 1
          fi
        fi
        _taw_path=
        ;;
    esac
  done

  (( _taw_default_count <= 1 )) || {
    _taw_die "multiple worktrees use the default branch: $_taw_default_branch"
    return 1
  }
  for _taw_path in "${_taw_paths[@]}"; do
    if [[ -n "$_taw_default_path" && "$_taw_default_path" == "$_taw_path"/* ]]; then
      _taw_die "--convert cannot move a worktree that contains another registered worktree: $_taw_path"
      return 1
    fi
    for _taw_other_path in "${_taw_paths[@]}"; do
      if [[ "$_taw_other_path" == "$_taw_path"/* ]]; then
        _taw_die "--convert cannot move a worktree that contains another registered worktree: $_taw_path"
        return 1
      fi
    done
  done
  if [[ -n "$_taw_default_path" ]]; then
    _taw_before_default_status="$(git -C "$_taw_default_path" status \
      --porcelain=v2 --branch --untracked-files=all)" || return 1
    if git -C "$_taw_default_path" ls-files --error-unmatch .worktrees \
      >/dev/null 2>&1; then
      _taw_die "--convert cannot promote a worktree that tracks .worktrees"
      return 1
    fi
  elif [[ -n "$_taw_default_ref" ]]; then
    _taw_output="$(git --git-dir "$_taw_original_git_dir" ls-tree \
      --name-only "$_taw_default_ref" -- .worktrees 2>/dev/null)" || return 1
    if [[ -n "$_taw_output" ]]; then
      _taw_die "--convert cannot check out a default branch that tracks .worktrees"
      return 1
    fi
  fi

  if [[ "$_taw_original_git_dir" != "$_taw_project_root/.git" ]]; then
    if [[ -e "$_taw_project_root/.git" || -L "$_taw_project_root/.git" ]]; then
      _taw_die "conversion target already has .git: $_taw_project_root"
      return 1
    fi
  fi

  _taw_saved_pwd="$(pwd -P)" || return 1
  for (( _taw_i = 1; _taw_i <= ${#_taw_paths[@]}; _taw_i++ )); do
    if [[ "$_taw_saved_pwd" == "${_taw_paths[_taw_i]}" \
      || "$_taw_saved_pwd" == "${_taw_paths[_taw_i]}"/* ]]; then
      _taw_caller_target="worktree:$_taw_i"
      _taw_caller_relative="${_taw_saved_pwd#${_taw_paths[_taw_i]}}"
      _taw_caller_original_path="${_taw_paths[_taw_i]}$_taw_caller_relative"
      break
    fi
  done
  if [[ "$_taw_caller_target" == outside && -n "$_taw_default_path" \
    && ( "$_taw_saved_pwd" == "$_taw_default_path" \
      || "$_taw_saved_pwd" == "$_taw_default_path"/* ) ]]; then
    _taw_caller_target=default
    _taw_caller_relative="${_taw_saved_pwd#$_taw_default_path}"
    _taw_caller_original_path="$_taw_default_path$_taw_caller_relative"
  fi

  _taw_backup="$(mktemp -d \
    "${_taw_project_root:h}/.${_taw_project_root:t}.taw-convert.XXXXXX")" \
    || return 1
  mkdir -p -- "$_taw_backup/meta" "$_taw_backup/tree" || {
    rm -rf -- "$_taw_backup"
    return 1
  }
  cp -p -- "$_taw_original_git_dir/config" "$_taw_backup/meta/config" \
    && cp -p -- "$_taw_original_git_dir/HEAD" "$_taw_backup/meta/HEAD" \
    || _taw_failure="could not preserve bare repository metadata"

  if [[ -z "$_taw_failure" && "$_taw_caller_target" != outside ]]; then
    # Git refuses to run after the caller's worktree directory is removed.
    if builtin cd -q -- "${_taw_project_root:h}"; then
      _taw_caller_relocated=true
    else
      _taw_failure="could not move the invoking shell to a stable directory"
    fi
  fi

  if [[ -z "$_taw_failure" && "$_taw_default_ref" != "$_taw_default_branch" \
    && -n "$_taw_default_ref" ]]; then
    _taw_default_commit="$(git --git-dir "$_taw_active_git_dir" rev-parse \
      --verify "$_taw_default_ref^{commit}" 2>/dev/null)" \
      || _taw_failure="could not resolve the remote default branch"
    if [[ -z "$_taw_failure" ]] && git --git-dir "$_taw_active_git_dir" update-ref \
      "refs/heads/$_taw_default_branch" "$_taw_default_commit" ""; then
      _taw_default_created=true
    elif [[ -z "$_taw_failure" ]]; then
      _taw_failure="could not create the default tracking branch"
    fi
    if [[ -z "$_taw_failure" ]]; then
      git --git-dir "$_taw_active_git_dir" config \
        "branch.$_taw_default_branch.remote" origin \
        && git --git-dir "$_taw_active_git_dir" config \
          "branch.$_taw_default_branch.merge" "refs/heads/$_taw_default_branch" \
        || _taw_failure="could not configure the default tracking branch"
    fi
    if [[ -z "$_taw_failure" ]] \
      && ! git --git-dir "$_taw_active_git_dir" config --get-all \
        remote.origin.fetch >/dev/null 2>&1; then
      git --git-dir "$_taw_active_git_dir" config --add \
        remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*" \
        || _taw_failure="could not configure the default tracking branch"
    fi
  fi

  for (( _taw_i = 1; _taw_i <= ${#_taw_paths[@]}; _taw_i++ )); do
    [[ -z "$_taw_failure" ]] || break
    if [[ "${_taw_paths[_taw_i]}" != "${_taw_destinations[_taw_i]}" ]]; then
      mkdir -p -- "${_taw_destinations[_taw_i]:h}" \
        || _taw_failure="could not create .worktrees destination"
      if [[ -z "$_taw_failure" ]] && git --git-dir "$_taw_active_git_dir" worktree move \
        "${_taw_paths[_taw_i]}" "${_taw_destinations[_taw_i]}"; then
        _taw_moved_flags[_taw_i]=true
        _taw_prune_empty_worktree_parents \
          "${_taw_paths[_taw_i]}" "$_taw_project_root"
      elif [[ -z "$_taw_failure" ]]; then
        _taw_failure="could not move worktree: ${_taw_paths[_taw_i]}"
      fi
    fi
  done

  if [[ -z "$_taw_failure" && -n "$_taw_default_path" ]]; then
    if git --git-dir "$_taw_active_git_dir" worktree move \
      "$_taw_default_path" "$_taw_backup/default"; then
      _taw_default_staged=true
      _taw_prune_empty_worktree_parents \
        "$_taw_default_path" "$_taw_project_root"
    else
      _taw_failure="could not stage the default worktree"
    fi
  fi

  if [[ -z "$_taw_failure" && -d "$_taw_project_root" ]]; then
    mkdir -p -- "$_taw_backup/wrapper" \
      || _taw_failure="could not preserve wrapper entries"
    if [[ -z "$_taw_failure" ]]; then
      _taw_move_primary_entries "$_taw_project_root" "$_taw_backup/wrapper" \
        "$_taw_original_git_dir" \
        || _taw_failure="could not preserve wrapper entries"
      _taw_wrapper_entries=( "$_taw_backup/wrapper"/*(ND) )
      (( ${#_taw_wrapper_entries[@]} == 0 )) || _taw_wrapper_staged=true
    fi
    if [[ -z "$_taw_failure" && "$_taw_wrapper_staged" == true ]]; then
      if [[ "$_taw_default_staged" == true ]]; then
        _taw_default_entries=(
          "$_taw_backup/default"/*(N)
          "$_taw_backup/default"/.[!.]*(N)
          "$_taw_backup/default"/..?*(N)
        )
        _taw_output="$(git -C "$_taw_backup/default" ls-files --cached 2>/dev/null)" \
          || _taw_failure="could not inspect the default worktree index"
        if [[ -z "$_taw_failure" ]]; then
          for _taw_line in "${(@f)_taw_output}"; do
            [[ -n "$_taw_line" ]] || continue
            _taw_default_entries+=( "${_taw_line%%/*}" )
          done
        fi
      elif [[ -n "$_taw_default_ref" ]]; then
        _taw_output="$(git --git-dir "$_taw_active_git_dir" ls-tree \
          --name-only "$_taw_default_ref" 2>/dev/null)" \
          || _taw_failure="could not inspect the default checkout"
        [[ -n "$_taw_failure" ]] \
          || _taw_default_entries=( "${(@f)_taw_output}" )
      fi
      if [[ -z "$_taw_failure" ]]; then
        for _taw_wrapper_entry in "${_taw_wrapper_entries[@]}"; do
          for _taw_default_entry in "${_taw_default_entries[@]}"; do
            [[ "${_taw_default_entry:t}" == .git ]] && continue
            if [[ "${_taw_wrapper_entry:t}" == "${_taw_default_entry:t}" ]]; then
              _taw_failure="wrapper entry conflicts with default checkout: ${_taw_wrapper_entry:t}"
              break 2
            fi
          done
        done
      fi
    fi
  fi

  if [[ -z "$_taw_failure" && "$_taw_original_git_dir" != "$_taw_project_root/.git" ]]; then
    mkdir -p -- "$_taw_project_root" || _taw_failure="could not create normal repository root"
    if [[ -z "$_taw_failure" ]] && mv -- "$_taw_original_git_dir" "$_taw_project_root/.git"; then
      _taw_active_git_dir="$_taw_project_root/.git"
      _taw_common_moved=true
      local -a _taw_repair_paths=( "${_taw_destinations[@]}" )
      [[ "$_taw_default_staged" != true ]] || _taw_repair_paths+=( "$_taw_backup/default" )
      git --git-dir "$_taw_active_git_dir" worktree repair "${_taw_repair_paths[@]}" \
        >/dev/null 2>&1 || _taw_failure="could not repair moved worktree metadata"
    elif [[ -z "$_taw_failure" ]]; then
      _taw_failure="could not move the bare Git directory"
    fi
  fi

  if [[ -z "$_taw_failure" && "$_taw_default_staged" == true ]]; then
    _taw_default_git_dir="$(git -C "$_taw_backup/default" rev-parse \
      --path-format=absolute --git-dir 2>/dev/null)" \
      || _taw_failure="could not resolve the default worktree index"
    if [[ -z "$_taw_failure" && -f "$_taw_default_git_dir/index" ]]; then
      cp -p -- "$_taw_default_git_dir/index" "$_taw_backup/meta/index" \
        && _taw_index_present=true \
        || _taw_failure="could not preserve the default worktree index"
    fi
    if [[ -z "$_taw_failure" ]]; then
      _taw_move_worktree_entries "$_taw_backup/default" "$_taw_backup/tree" \
        || _taw_failure="could not preserve the default working tree"
    fi
    if [[ -z "$_taw_failure" ]]; then
      if git --git-dir "$_taw_active_git_dir" worktree remove --force \
        "$_taw_backup/default"; then
        _taw_default_removed=true
      else
        _taw_failure="could not remove the staged default worktree"
      fi
    fi
  fi

  if [[ -z "$_taw_failure" ]]; then
    git --git-dir "$_taw_active_git_dir" config core.bare false \
      && git --git-dir "$_taw_active_git_dir" config --unset-all core.worktree \
        >/dev/null 2>&1 || true
    if [[ "$(git --git-dir "$_taw_active_git_dir" config --bool core.bare)" == false ]]; then
      _taw_config_changed=true
    else
      _taw_failure="could not make the repository non-bare"
    fi
  fi
  if [[ -z "$_taw_failure" ]]; then
    git --git-dir "$_taw_active_git_dir" symbolic-ref \
      HEAD "refs/heads/$_taw_default_branch" \
      || _taw_failure="could not set the normal repository default branch"
  fi
  if [[ -z "$_taw_failure" && "$_taw_index_present" == true ]]; then
    cp -p -- "$_taw_backup/meta/index" "$_taw_active_git_dir/index" \
      || _taw_failure="could not restore the default worktree index"
  fi
  if [[ -z "$_taw_failure" && "$_taw_default_staged" == true ]]; then
    _taw_move_worktree_entries "$_taw_backup/tree" "$_taw_project_root" \
      || _taw_failure="could not promote the default working tree"
  elif [[ -z "$_taw_failure" ]] \
    && git --git-dir "$_taw_active_git_dir" rev-parse --verify \
      --quiet HEAD^{commit} >/dev/null 2>&1; then
    git -C "$_taw_project_root" reset --hard HEAD \
      || _taw_failure="could not check out the default branch"
  fi
  if [[ -z "$_taw_failure" && "$_taw_wrapper_staged" == true ]]; then
    _taw_move_worktree_entries "$_taw_backup/wrapper" "$_taw_project_root" \
      || _taw_failure="could not restore wrapper entries"
  fi

  if [[ -z "$_taw_failure" ]]; then
    [[ "$(git -C "$_taw_project_root" rev-parse \
      --is-bare-repository 2>/dev/null)" == false ]] \
      || _taw_failure="converted repository is still bare"
  fi
  if [[ -z "$_taw_failure" ]]; then
    [[ "$(git -C "$_taw_project_root" symbolic-ref \
      --quiet --short HEAD 2>/dev/null)" == "$_taw_default_branch" ]] \
      || _taw_failure="normal repository HEAD does not name the default branch"
  fi
  if [[ -z "$_taw_failure" && -n "$_taw_default_path" ]]; then
    _taw_after_default_status="$(git -C "$_taw_project_root" status \
      --porcelain=v2 --branch --untracked-files=all)" \
      || _taw_failure="could not verify the promoted default worktree"
    [[ -n "$_taw_failure" ]] \
      || _taw_status_records_preserved \
        "$_taw_before_default_status" "$_taw_after_default_status" \
      || _taw_failure="default worktree status changed during conversion"
  fi
  for (( _taw_i = 1; _taw_i <= ${#_taw_destinations[@]}; _taw_i++ )); do
    [[ -z "$_taw_failure" ]] || break
    [[ "$(git -C "${_taw_destinations[_taw_i]}" status \
      --porcelain=v2 --branch --untracked-files=all)" == "${_taw_statuses[_taw_i]}" ]] \
      || _taw_failure="worktree status changed during conversion: ${_taw_destinations[_taw_i]}"
  done

  if [[ -n "$_taw_failure" ]]; then
    if [[ "$_taw_config_changed" == true ]]; then
      _taw_move_primary_entries "$_taw_project_root" "$_taw_backup/tree" \
        || _taw_rollback_ok=false
      git --git-dir "$_taw_active_git_dir" config core.bare true \
        || _taw_rollback_ok=false
    fi
    if [[ "$_taw_default_removed" == true ]]; then
      mkdir -p -- "${_taw_default_path:h}" || _taw_rollback_ok=false
      if git --git-dir "$_taw_active_git_dir" worktree add --no-checkout \
        "$_taw_default_path" "$_taw_default_branch"; then
        _taw_actual_git_dir="$(git -C "$_taw_default_path" rev-parse \
          --path-format=absolute --git-dir 2>/dev/null)" || _taw_rollback_ok=false
        if [[ "$_taw_index_present" == true ]]; then
          cp -p -- "$_taw_backup/meta/index" "$_taw_actual_git_dir/index" \
            || _taw_rollback_ok=false
        fi
        _taw_move_worktree_entries "$_taw_backup/tree" "$_taw_default_path" \
          || _taw_rollback_ok=false
      else
        _taw_rollback_ok=false
      fi
    elif [[ "$_taw_default_staged" == true && -d "$_taw_backup/default" ]]; then
      mkdir -p -- "${_taw_default_path:h}" || _taw_rollback_ok=false
      if ! git --git-dir "$_taw_active_git_dir" worktree move \
        "$_taw_backup/default" "$_taw_default_path"; then
        _taw_rollback_ok=false
      fi
    fi
    for (( _taw_i = ${#_taw_paths[@]}; _taw_i >= 1; _taw_i-- )); do
      if [[ "${_taw_moved_flags[_taw_i]}" == true ]]; then
        mkdir -p -- "${_taw_paths[_taw_i]:h}" || _taw_rollback_ok=false
        git --git-dir "$_taw_active_git_dir" worktree move \
          "${_taw_destinations[_taw_i]}" "${_taw_paths[_taw_i]}" \
          || _taw_rollback_ok=false
      fi
    done
    if [[ "$_taw_common_moved" == true ]]; then
      mv -- "$_taw_project_root/.git" "$_taw_original_git_dir" \
        || _taw_rollback_ok=false
      _taw_active_git_dir="$_taw_original_git_dir"
      git --git-dir "$_taw_active_git_dir" worktree repair \
        "${_taw_paths[@]}" ${_taw_default_path:+"$_taw_default_path"} \
        >/dev/null 2>&1 || _taw_rollback_ok=false
    fi
    cp -p -- "$_taw_backup/meta/config" "$_taw_active_git_dir/config" \
      && cp -p -- "$_taw_backup/meta/HEAD" "$_taw_active_git_dir/HEAD" \
      || _taw_rollback_ok=false
    if [[ "$_taw_default_created" == true ]]; then
      git --git-dir "$_taw_active_git_dir" update-ref -d \
        "refs/heads/$_taw_default_branch" || _taw_rollback_ok=false
    fi
    if [[ "$_taw_wrapper_staged" == true && -d "$_taw_backup/wrapper" ]]; then
      _taw_move_worktree_entries "$_taw_backup/wrapper" "$_taw_project_root" \
        || _taw_rollback_ok=false
    fi
    if [[ "$_taw_rollback_ok" == true && "$_taw_caller_relocated" == true ]]; then
      builtin cd -- "$_taw_caller_original_path" || _taw_rollback_ok=false
    fi
    if [[ "$_taw_rollback_ok" == true ]]; then
      rm -rf -- "$_taw_backup"
      _taw_die "$_taw_failure; original bare project restored"
    else
      _taw_die "$_taw_failure; rollback incomplete; recovery files remain at $_taw_backup"
    fi
    return 1
  fi

  rm -rf -- "$_taw_backup" || return 1
  case "$_taw_caller_target" in
    default)
      builtin cd -- "$_taw_project_root$_taw_caller_relative" || return 1
      ;;
    worktree:*)
      _taw_i="${_taw_caller_target#worktree:}"
      builtin cd -- "${_taw_destinations[_taw_i]}$_taw_caller_relative" || return 1
      ;;
  esac

  print -r -- "taw: converted $_taw_project_root to a normal project"
  print -r -- "taw: default worktree: $_taw_project_root"
  for _taw_path in "${_taw_destinations[@]}"; do
    print -r -- "taw: linked worktree: $_taw_path"
  done
}

_taw_worktree_picker_rows() {
  local _taw_line _taw_path _taw_branch_ref _taw_branch
  local _taw_is_bare_entry _taw_is_detached_entry
  local -a _taw_worktree_fields

  _taw_worktree_fields=( "${(@0)$(_taw_git worktree list --porcelain -z 2>/dev/null)}" ) \
    || return 1
  for _taw_line in "${_taw_worktree_fields[@]}"; do
    case "$_taw_line" in
      worktree\ *)
        _taw_path="${_taw_line#worktree }"
        _taw_branch_ref=
        _taw_is_bare_entry=false
        _taw_is_detached_entry=false
        _taw_picker_safe "$_taw_path" || _taw_path=
        ;;
      branch\ *)
        _taw_branch_ref="${_taw_line#branch }"
        ;;
      bare)
        _taw_is_bare_entry=true
        ;;
      detached)
        _taw_is_detached_entry=true
        ;;
      "")
        if [[ -n "$_taw_path" && "$_taw_is_bare_entry" != true ]]; then
          if [[ "$_taw_branch_ref" == refs/heads/* ]]; then
            _taw_branch="${_taw_branch_ref#refs/heads/}"
            _taw_emit_picker_row "${_taw_branch} [worktree]"$'\t'"worktree"$'\t'"$_taw_branch"$'\t'"$_taw_branch"$'\t'"$_taw_path" || return 1
          elif [[ "$_taw_is_detached_entry" == true ]]; then
            _taw_emit_picker_row "${_taw_path:t} [detached]"$'\t'"worktree"$'\t\t\t'"$_taw_path" || return 1
          fi
        fi
        _taw_path=
        ;;
    esac
  done

}

_taw_bare_picker_rows() {
  local _taw_worktree_rows _taw_branch_rows _taw_branch
  local _taw_rows="" _taw_row
  local -a _taw_fields
  local -A _taw_seen_by_branch

  _taw_worktree_rows="$(_taw_worktree_picker_rows)" || return 1
  _taw_rows="$_taw_worktree_rows"
  [[ -z "$_taw_rows" ]] || _taw_rows+=$'\n'
  for _taw_row in "${(@f)_taw_worktree_rows}"; do
    [[ -n "$_taw_row" ]] || continue
    _taw_fields=( "${(@ps:\t:)_taw_row}" )
    _taw_branch="${_taw_fields[3]}"
    [[ -n "$_taw_branch" ]] && _taw_seen_by_branch[$_taw_branch]=1
  done

  _taw_branch_rows="$(_taw_picker_branch_rows)" || return 1
  for _taw_row in "${(@f)_taw_branch_rows}"; do
    [[ -n "$_taw_row" ]] || continue
    _taw_fields=( "${(@ps:\t:)_taw_row}" )
    _taw_branch="${_taw_fields[3]}"
    [[ -n "$_taw_branch" && -z "${_taw_seen_by_branch[$_taw_branch]-}" ]] || continue
    _taw_rows+="$_taw_row"$'\n'
  done

  print -r -- "$_taw_rows"
}

_taw_select_bare_target_with_fzf() {
  local _taw_rows _taw_choice _taw_status
  local -a _taw_fields

  command -v fzf >/dev/null 2>&1 || return 2
  _taw_rows="$(_taw_bare_picker_rows)" || return 1
  [[ -n "$_taw_rows" ]] || return 2
  _taw_choice="$(print -r -- "$_taw_rows" | fzf --delimiter=$'\t' --with-nth=1 --prompt='taw> ')" || _taw_status=$?
  _taw_status=${_taw_status:-0}
  case "$_taw_status" in
    0) ;;
    130) return 130 ;;
    2) return 2 ;;
    1) return 1 ;;
    *) return 1 ;;
  esac
  [[ -n "$_taw_choice" ]] || return 1

  _taw_fields=( "${(@ps:\t:)_taw_choice}" )
  (( ${#_taw_fields[@]} == 5 )) || return 1
  _taw_require_picker_safe "picker selection" "${_taw_fields[@]}" || return 1
  _taw_picker_kind="${_taw_fields[2]}"
  _taw_picker_branch="${_taw_fields[3]}"
  _taw_picker_ref="${_taw_fields[4]}"
  _taw_picker_path="${_taw_fields[5]}"
}

_taw_existing_worktree_for_branch() {
  local _taw_branch="refs/heads/$1" _taw_output _taw_line
  local _taw_path _taw_seen_branch _taw_is_bare_entry

  _taw_output="$(_taw_git worktree list --porcelain 2>/dev/null)" || return 1

  for _taw_line in "${(@f)_taw_output}" ""; do
    case "$_taw_line" in
      worktree\ *)
        _taw_path="${_taw_line#worktree }"
        _taw_seen_branch=
        _taw_is_bare_entry=false
        ;;
      branch\ *)
        _taw_seen_branch="${_taw_line#branch }"
        ;;
      bare)
        _taw_is_bare_entry=true
        ;;
      "")
        if [[ "$_taw_is_bare_entry" != true && "$_taw_seen_branch" == "$_taw_branch" && -n "$_taw_path" ]]; then
          print -r -- "$_taw_path"
          return 0
        fi
        ;;
    esac
  done

  return 1
}

_taw_current_head_ref() {
  _taw_git symbolic-ref --quiet --short HEAD 2>/dev/null \
    || print -r -- HEAD
}

_taw_checkout_existing_worktree_branch() {
  local _taw_path="$1" _taw_expected_branch="$2" _taw_existing_branch _taw_ref="$3"
  local _taw_confirm_switch="${4:-true}"
  local _taw_remote_target _taw_remote_name _taw_remote_branch _taw_start_point _taw_is_remote_ref=false

  _taw_existing_branch="$(git -C "$_taw_path" symbolic-ref --quiet --short HEAD 2>/dev/null)" \
    || _taw_existing_branch="$(git -C "$_taw_path" rev-parse --short HEAD 2>/dev/null)" \
    || _taw_existing_branch=unknown

  [[ "$_taw_existing_branch" == "$_taw_expected_branch" ]] && return 0

  [[ "$_taw_confirm_switch" != true ]] \
    || _taw_confirm "Worktree $_taw_path is on $_taw_existing_branch; switch to $_taw_expected_branch?" || {
    _taw_die "worktree branch mismatch"
    return 1
  }

  if git -C "$_taw_path" show-ref --verify --quiet "refs/heads/$_taw_expected_branch"; then
    git -C "$_taw_path" checkout "$_taw_expected_branch" || return 1
  else
    [[ -n "$_taw_ref" ]] || _taw_ref="$(_taw_current_head_ref)"
    if _taw_branch_exists "$_taw_ref"; then
      _taw_start_point="$_taw_ref"
    elif [[ "$_taw_ref" == */* ]]; then
      _taw_remote_target="$(_taw_remote_branch_for_path "$_taw_ref")" || return 1
      _taw_remote_name="${_taw_remote_target%%$'\t'*}"
      _taw_remote_branch="${_taw_remote_target#*$'\t'}"
      _taw_start_point="$(git -C "$_taw_path" rev-parse --verify --quiet "refs/remotes/$_taw_remote_name/$_taw_remote_branch^{commit}" 2>/dev/null)" || return 1
      _taw_is_remote_ref=true
    else
      _taw_start_point="$_taw_ref"
    fi
    git -C "$_taw_path" checkout -b "$_taw_expected_branch" "$_taw_start_point" || return 1
    if [[ "$_taw_is_remote_ref" == true ]]; then
      if ! git -C "$_taw_path" config --get "remote.$_taw_remote_name.url" >/dev/null 2>&1; then
        git -C "$_taw_path" config "remote.$_taw_remote_name.url" "$_taw_git_dir" || return 1
      fi
      _taw_ensure_remote_fetch_refspec "$_taw_remote_name" || return 1
      git -C "$_taw_path" config "branch.$_taw_expected_branch.remote" "$_taw_remote_name" || return 1
      git -C "$_taw_path" config "branch.$_taw_expected_branch.merge" "refs/heads/$_taw_remote_branch" || return 1
    fi
  fi
}

_taw_prepare_worktree() {
  local _taw_path="$1" _taw_branch="$2" _taw_ref="$3" _taw_existing_common
  local _taw_remote_target _taw_remote_name _taw_remote_branch _taw_start_point _taw_is_remote_ref=false

  [[ "$_taw_project_kind" == normal || "$_taw_is_bare" == true ]] || return 1
  git check-ref-format --branch "$_taw_branch" >/dev/null 2>&1 || {
    _taw_die "invalid worktree branch: $_taw_branch"
    return 1
  }

  if [[ -e "$_taw_path" ]]; then
    git -C "$_taw_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
      _taw_die "worktree path exists but is not a git worktree: $_taw_path"
      return 1
    }
    _taw_existing_common="$(git -C "$_taw_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || {
      _taw_die "could not inspect worktree git dir: $_taw_path"
      return 1
    }
    _taw_existing_common="${_taw_existing_common:A}"
    if [[ "$_taw_existing_common" != "${_taw_git_dir:A}" ]]; then
      _taw_die "worktree path does not belong to selected project: $_taw_path"
      return 1
    fi
    _taw_checkout_existing_worktree_branch "$_taw_path" "$_taw_branch" "$_taw_ref" || return 1
    return 0
  fi

  mkdir -p -- "${_taw_path:h}" || return 1
  if _taw_branch_exists "$_taw_branch"; then
    _taw_git worktree add "$_taw_path" "$_taw_branch" || return 1
  else
    [[ -n "$_taw_ref" ]] || _taw_ref="$(_taw_current_head_ref)"
    if _taw_branch_exists "$_taw_ref"; then
      _taw_start_point="$_taw_ref"
    elif [[ "$_taw_ref" == */* ]]; then
      _taw_remote_target="$(_taw_remote_branch_for_path "$_taw_ref")" || return 1
      _taw_remote_name="${_taw_remote_target%%$'\t'*}"
      _taw_remote_branch="${_taw_remote_target#*$'\t'}"
      _taw_start_point="$(_taw_git rev-parse --verify --quiet "refs/remotes/$_taw_remote_name/$_taw_remote_branch^{commit}" 2>/dev/null)" || return 1
      _taw_is_remote_ref=true
    else
      _taw_start_point="$_taw_ref"
    fi
    _taw_git worktree add -b "$_taw_branch" "$_taw_path" "$_taw_start_point" || return 1
    if [[ "$_taw_is_remote_ref" == true ]]; then
      if ! _taw_git config --get "remote.$_taw_remote_name.url" >/dev/null 2>&1; then
        _taw_git config "remote.$_taw_remote_name.url" "$_taw_git_dir" || return 1
      fi
      _taw_ensure_remote_fetch_refspec "$_taw_remote_name" || return 1
      _taw_git config "branch.$_taw_branch.remote" "$_taw_remote_name" || return 1
      _taw_git config "branch.$_taw_branch.merge" "refs/heads/$_taw_remote_branch" || return 1
    fi
  fi
}

_taw_resolve_bare_worktree_arg() {
  local _taw_arg="$1" _taw_worktree_root _taw_path _taw_branch _taw_branch_start

  [[ -n "$_taw_arg" ]] || {
    _taw_die "invalid bare worktree path: $_taw_arg"
    return 1
  }
  if _taw_bare_worktree_input_has_dot_segment "$_taw_arg"; then
    _taw_die "invalid bare worktree path: $_taw_arg"
    return 1
  fi
  _taw_worktree_root="${_taw_project_dir:A}/.worktrees"
  if [[ "$_taw_arg" == /* ]]; then
    _taw_path="${_taw_arg:A}"
  else
    _taw_path="${_taw_worktree_root}/$_taw_arg"
    _taw_path="${_taw_path:A}"
  fi

  if [[ "$_taw_path" != "$_taw_worktree_root"/* ]]; then
    _taw_die "worktree path must stay under .worktrees: $_taw_arg"
    return 1
  fi

  _taw_branch_start=$(( ${#_taw_worktree_root} + 2 ))
  _taw_branch="${_taw_path[$_taw_branch_start,-1]}"
  [[ -n "$_taw_branch" ]] || {
    _taw_die "invalid bare worktree path: $_taw_arg"
    return 1
  }

  print -r -- "$_taw_path"$'\t'"$_taw_branch"
}

_taw_prepare_orphan_worktree() {
  local _taw_path="$1" _taw_branch="$2" _taw_existing_common

  [[ "$_taw_project_kind" == normal || "$_taw_is_bare" == true ]] || return 1
  git check-ref-format --branch "$_taw_branch" >/dev/null 2>&1 || {
    _taw_die "invalid worktree branch: $_taw_branch"
    return 1
  }

  if [[ -e "$_taw_path" ]]; then
    git -C "$_taw_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
      _taw_die "worktree path exists but is not a git worktree: $_taw_path"
      return 1
    }
    _taw_existing_common="$(git -C "$_taw_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || {
      _taw_die "could not inspect worktree git dir: $_taw_path"
      return 1
    }
    _taw_existing_common="${_taw_existing_common:A}"
    if [[ "$_taw_existing_common" != "${_taw_git_dir:A}" ]]; then
      _taw_die "worktree path does not belong to selected project: $_taw_path"
      return 1
    fi
    _taw_die "orphan worktree path already exists: $_taw_path"
    return 1
  fi

  mkdir -p -- "${_taw_path:h}" || return 1
  _taw_git worktree add --orphan -b "$_taw_branch" "$_taw_path" || return 1
}

_taw_open_managed_worktree() {
  local _taw_branch="$1" _taw_ref="$2" _taw_path="${3:-}"
  local _taw_existing_worktree

  if [[ -z "$_taw_path" ]]; then
    _taw_path="${_taw_project_dir:A}/.worktrees/$_taw_branch"
  fi

  _taw_existing_worktree="$(_taw_existing_worktree_for_branch "$_taw_branch")" \
    || _taw_existing_worktree=
  if [[ -n "$_taw_existing_worktree" ]]; then
    _taw_window_dir="${_taw_existing_worktree:A}"
    return 0
  fi

  _taw_window_dir="${_taw_path:A}"
  _taw_prepare_worktree "$_taw_window_dir" "$_taw_branch" "$_taw_ref"
}

_taw_parse_created_window() {
  local _taw_created="$1"
  _taw_created_window="${_taw_created%% *}"
  _taw_created_pane="${_taw_created##* }"
}

_taw_parse_created_session() {
  local _taw_created="$1" _taw_rest

  _taw_created_session_id="${_taw_created%%$'\t'*}"
  _taw_rest="${_taw_created#*$'\t'}"
  [[ "$_taw_rest" != "$_taw_created" ]] || return 1
  _taw_created_session_name="${_taw_rest%%$'\t'*}"
  _taw_rest="${_taw_rest#*$'\t'}"
  [[ "$_taw_rest" != "$_taw_created_session_name" ]] || return 1
  _taw_created_window="${_taw_rest%%$'\t'*}"
  _taw_created_pane="${_taw_rest#*$'\t'}"
  [[ "$_taw_created_pane" != "$_taw_rest" && -n "$_taw_created_session_id" \
    && -n "$_taw_created_session_name" && -n "$_taw_created_window" \
    && -n "$_taw_created_pane" ]]
}

_taw_resolve_layout_session() {
  if [[ -n "$_taw_project_session_target" ]]; then
    tmux has-session -t "$_taw_project_session_target" 2>/dev/null || return 2
    _taw_session_target="$_taw_project_session_target"
    return 0
  fi

  _taw_resolve_tmux_session_exact "$_taw_session_name"
  case $? in
    0)
      _taw_session_name="$_taw_resolved_tmux_session_name"
      _taw_session_target="$_taw_resolved_tmux_session_id"
      return 0
      ;;
    1) return 1 ;;
    *) return 2 ;;
  esac
}

_taw_existing_tmux_window_for_dir() {
  local _taw_panes _taw_line _taw_window _taw_pane _taw_pane_path _taw_pane_real _taw_window_match=
  local _taw_target_dir="${_taw_window_dir:A}" _taw_tab=$'\t'

  _taw_panes="$(tmux list-panes -s -t "$_taw_session_target:" \
    -F '#{window_id}	#{pane_id}	#{pane_current_path}' 2>/dev/null)" || return 1

  for _taw_line in "${(@f)_taw_panes}"; do
    _taw_window="${_taw_line%%${_taw_tab}*}"
    _taw_pane="${_taw_line#*${_taw_tab}}"
    _taw_pane="${_taw_pane%%${_taw_tab}*}"
    _taw_pane_path="${_taw_line##*${_taw_tab}}"
    [[ "$_taw_pane_path" != "$_taw_line" && -n "$_taw_window" && -n "$_taw_pane" && -d "$_taw_pane_path" ]] || continue
    _taw_pane_real="${_taw_pane_path:A}"
    if [[ "$_taw_pane_real" == "$_taw_target_dir" ]]; then
      print -r -- "$_taw_window	$_taw_pane"
      return 0
    elif [[ "$_taw_pane_real" == "$_taw_target_dir"/* ]]; then
      [[ -n "$_taw_window_match" ]] || _taw_window_match="$_taw_window"
    fi
  done

  [[ -n "$_taw_window_match" ]] || return 1
  print -r -- "$_taw_window_match"
  return 0
}

_taw_peer_tmux_window_for_dir() {
  local _taw_panes _taw_line _taw_session_id _taw_session _taw_window _taw_pane _taw_pane_path
  local _taw_pane_real _taw_rest _taw_rank _taw_best_rank=99 _taw_best_session_id
  local _taw_best_window _taw_best_pane _taw_target_dir="${_taw_window_dir:A}" _taw_tab=$'\t'

  _taw_panes="$(tmux list-panes -a \
    -F '#{session_id}	#{session_name}	#{window_id}	#{pane_id}	#{pane_current_path}' \
    2>/dev/null)" || return 1

  for _taw_line in "${(@f)_taw_panes}"; do
    _taw_session_id="${_taw_line%%${_taw_tab}*}"
    _taw_rest="${_taw_line#*${_taw_tab}}"
    _taw_session="${_taw_rest%%${_taw_tab}*}"
    _taw_rest="${_taw_rest#*${_taw_tab}}"
    _taw_window="${_taw_rest%%${_taw_tab}*}"
    _taw_rest="${_taw_rest#*${_taw_tab}}"
    _taw_pane="${_taw_rest%%${_taw_tab}*}"
    _taw_pane_path="${_taw_rest#*${_taw_tab}}"
    [[ -n "$_taw_session_id" && -n "$_taw_session" && -n "$_taw_window" \
      && -n "$_taw_pane" && -d "$_taw_pane_path" ]] || continue

    _taw_pane_real="${_taw_pane_path:A}"
    if [[ "$_taw_session_id" == "$_taw_current_session_id" ]]; then
      _taw_rank=0
    elif [[ "$_taw_session_id" == "$_taw_session_target" \
      || "$_taw_session" == "$_taw_session_target" ]]; then
      _taw_rank=2
    else
      _taw_rank=4
    fi

    if [[ "$_taw_pane_real" == "$_taw_target_dir" ]]; then
      :
    elif [[ "$_taw_pane_real" == "$_taw_target_dir"/* ]]; then
      _taw_rank=$((_taw_rank + 1))
    else
      continue
    fi

    (( _taw_rank < _taw_best_rank )) || continue
    _taw_best_rank="$_taw_rank"
    _taw_best_session_id="$_taw_session_id"
    _taw_best_window="$_taw_window"
    if (( _taw_rank % 2 == 0 )); then
      _taw_best_pane="$_taw_pane"
    else
      _taw_best_pane=
    fi
  done

  [[ -n "$_taw_best_window" ]] || return 1
  print -r -- "$_taw_best_session_id	$_taw_best_window	$_taw_best_pane"
}

_taw_switch_to_tmux_window() {
  local _taw_window_id="$1" _taw_pane_id="${2:-}"

  if [[ "$_taw_peer" == true ]]; then
    tmux select-window -t "$_taw_window_id" || return 1
    if [[ -n "$_taw_pane_id" ]]; then
      tmux select-pane -t "$_taw_pane_id" || return 1
    fi
  elif [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$_taw_session_target" || return 1
    tmux select-window -t "$_taw_window_id" || return 1
    if [[ -n "$_taw_pane_id" ]]; then
      tmux select-pane -t "$_taw_pane_id" || return 1
    fi
  else
    tmux select-window -t "$_taw_window_id" || return 1
    if [[ -n "$_taw_pane_id" ]]; then
      tmux select-pane -t "$_taw_pane_id" || return 1
    fi
    tmux attach-session -t "$_taw_session_target" || return 1
  fi
}

_taw_switch_to_selected_tmux_session() {
  local _taw_selected_window_id _taw_current_window_ids _taw_window_id
  local _taw_selected_window_is_linked=false

  tmux has-session -t "$_taw_selected_tmux_session_target" 2>/dev/null || {
    _taw_die "could not resolve tmux session: $_taw_selected_tmux_session_name"
    return 1
  }

  if [[ "$_taw_peer" == true ]]; then
    _taw_selected_window_id="$(
      tmux display-message -p -t "$_taw_selected_tmux_session_target:" \
        '#{window_id}' 2>/dev/null
    )" || {
      _taw_die "could not resolve active window for tmux session: $_taw_selected_tmux_session_name"
      return 1
    }
    [[ -n "$_taw_selected_window_id" ]] || {
      _taw_die "could not resolve active window for tmux session: $_taw_selected_tmux_session_name"
      return 1
    }

    _taw_current_window_ids="$(
      tmux list-windows -t "$_taw_current_session_id" -F '#{window_id}' 2>/dev/null
    )" || {
      _taw_die "could not resolve current tmux session"
      return 1
    }
    for _taw_window_id in "${(@f)_taw_current_window_ids}"; do
      if [[ "$_taw_window_id" == "$_taw_selected_window_id" ]]; then
        _taw_selected_window_is_linked=true
        break
      fi
    done

    if [[ "$_taw_selected_window_is_linked" != true ]]; then
      tmux link-window -d -s "$_taw_selected_window_id" \
        -t "$_taw_current_session_id:" || return 1
    fi
    tmux select-window -t "$_taw_selected_window_id"
  elif [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$_taw_selected_tmux_session_target"
  else
    tmux attach-session -t "$_taw_selected_tmux_session_target"
  fi
}

_taw_can_reuse_existing_window() {
  [[ "$_taw_agent_arg_provided" != true \
    && "$_taw_editor_arg_provided" != true \
    && "$_taw_shell_arg_provided" != true \
    && "$_taw_agent_env_override" != true ]]
}

_taw_create_tmux_window() {
  local _taw_created _taw_created_window _taw_created_pane _taw_window_id _taw_initial_pane
  local _taw_editor_pane _taw_focus_pane _taw_shell_is_initial=false
  local _taw_created_session_id _taw_created_session_name _taw_session_status
  local _taw_agent_pane _taw_shell_pane _taw_last_shell_pane _taw_shell_cmd _taw_existing_window
  local _taw_shell_anchor_pane
  local _taw_existing_session_id _taw_existing_window_id _taw_existing_pane_id _taw_existing_rest
  local -a _taw_initial_cmd_args

  if [[ "$_taw_editor_enabled" == true ]]; then
    _taw_initial_cmd_args=( "$_taw_editor_cmd" )
  elif [[ "$_taw_agent_enabled" == true ]]; then
    _taw_initial_cmd_args=( "$_taw_agent_cmd" )
  elif [[ "$_taw_shell_enabled" == true ]]; then
    _taw_shell_is_initial=true
    if [[ -n "${_taw_shell_cmds[1]}" ]]; then
      _taw_initial_cmd_args=( "${_taw_shell_cmds[1]}" )
    fi
  else
    _taw_die "layout must include at least one pane"
    return 1
  fi

  if [[ "$_taw_peer" == true ]]; then
    if [[ "$_taw_force" != true ]]; then
      _taw_existing_window="$(_taw_peer_tmux_window_for_dir)" \
        || _taw_existing_window=
    fi
    if [[ -n "$_taw_existing_window" ]]; then
      _taw_existing_session_id="${_taw_existing_window%%$'\t'*}"
      _taw_existing_rest="${_taw_existing_window#*$'\t'}"
      _taw_existing_window_id="${_taw_existing_rest%%$'\t'*}"
      _taw_existing_pane_id="${_taw_existing_rest#*$'\t'}"
      [[ "$_taw_existing_pane_id" == "$_taw_existing_rest" ]] && _taw_existing_pane_id=

      if ! _taw_can_reuse_existing_window; then
        _taw_die "matching tmux window already exists; use --force to create a fresh layout"
        return 1
      fi

      if [[ "$_taw_existing_session_id" != "$_taw_current_session_id" ]]; then
        tmux link-window -d -s "$_taw_existing_window_id" \
          -t "$_taw_current_session_id:" || return 1
      fi
      _taw_switch_to_tmux_window "$_taw_existing_window_id" "$_taw_existing_pane_id"
      return
    fi

    _taw_created="$(tmux new-window -d -P -F '#{window_id} #{pane_id}' \
      -t "$_taw_current_session_id:" -n "$_taw_window_name" -c "$_taw_window_dir" \
      "${_taw_initial_cmd_args[@]}")" || return 1
  else
    _taw_resolve_layout_session
    _taw_session_status=$?
    if (( _taw_session_status == 0 )); then
      if _taw_can_reuse_existing_window \
        && _taw_existing_window="$(_taw_existing_tmux_window_for_dir)"; then
        _taw_existing_window_id="${_taw_existing_window%%$'\t'*}"
        if [[ "$_taw_existing_window" == *$'\t'* ]]; then
          _taw_existing_pane_id="${_taw_existing_window#*$'\t'}"
        else
          _taw_existing_pane_id=
        fi
        _taw_switch_to_tmux_window "$_taw_existing_window_id" "$_taw_existing_pane_id"
        return
      fi

      _taw_created="$(tmux new-window -d -P -F '#{window_id} #{pane_id}' \
        -t "$_taw_session_target:" -n "$_taw_window_name" -c "$_taw_window_dir" \
        "${_taw_initial_cmd_args[@]}")" || return 1
    elif (( _taw_session_status == 2 )) || [[ -n "$_taw_project_session_target" ]]; then
      _taw_die "could not resolve tmux session: $_taw_session_name"
      return 1
    else
      _taw_created="$(tmux new-session -d -P \
        -F '#{session_id}	#{session_name}	#{window_id}	#{pane_id}' \
        -s "$_taw_session_name" -n "$_taw_window_name" -c "$_taw_window_dir" \
        "${_taw_initial_cmd_args[@]}")" || {
        _taw_die "could not create tmux session: $_taw_session_name"
        return 1
      }
      _taw_parse_created_session "$_taw_created" || {
        _taw_die "tmux returned invalid session metadata"
        return 1
      }
      _taw_session_name="$_taw_created_session_name"
      _taw_session_target="$_taw_created_session_id"
    fi
  fi

  if [[ -z "$_taw_created_session_id" ]]; then
    _taw_parse_created_window "$_taw_created"
  fi
  _taw_window_id="$_taw_created_window"
  _taw_initial_pane="$_taw_created_pane"
  if [[ "$_taw_editor_enabled" == true ]]; then
    _taw_editor_pane="$_taw_initial_pane"
  elif [[ "$_taw_agent_enabled" == true ]]; then
    _taw_agent_pane="$_taw_initial_pane"
  else
    _taw_shell_pane="$_taw_initial_pane"
    _taw_last_shell_pane="$_taw_initial_pane"
  fi
  tmux set-window-option -t "$_taw_window_id" automatic-rename off >/dev/null || return 1
  tmux set-window-option -t "$_taw_window_id" allow-rename off >/dev/null || return 1
  tmux rename-window -t "$_taw_window_id" "$_taw_window_name" >/dev/null || return 1

  _taw_shell_anchor_pane="$_taw_initial_pane"
  if [[ "$_taw_agent_enabled" == true && "$_taw_editor_enabled" == true ]]; then
    _taw_agent_pane="$(tmux split-window -h -P -F '#{pane_id}' \
      -t "$_taw_editor_pane" -c "$_taw_window_dir" "$_taw_agent_cmd")" || return 1
    _taw_shell_anchor_pane="$_taw_agent_pane"
  fi

  if [[ "$_taw_shell_enabled" == true && "$_taw_shell_is_initial" != true ]]; then
    if [[ -n "${_taw_shell_cmds[1]}" ]]; then
      if [[ "$_taw_agent_enabled" == true && "$_taw_editor_enabled" == true ]]; then
        _taw_shell_pane="$(tmux split-window -v -P -F '#{pane_id}' \
          -t "$_taw_shell_anchor_pane" -c "$_taw_window_dir" \
          "${_taw_shell_cmds[1]}")" || return 1
      else
        _taw_shell_pane="$(tmux split-window -h -P -F '#{pane_id}' \
          -t "$_taw_shell_anchor_pane" -c "$_taw_window_dir" \
          "${_taw_shell_cmds[1]}")" || return 1
      fi
    else
      if [[ "$_taw_agent_enabled" == true && "$_taw_editor_enabled" == true ]]; then
        _taw_shell_pane="$(tmux split-window -v -P -F '#{pane_id}' \
          -t "$_taw_shell_anchor_pane" -c "$_taw_window_dir")" || return 1
      else
        _taw_shell_pane="$(tmux split-window -h -P -F '#{pane_id}' \
          -t "$_taw_shell_anchor_pane" -c "$_taw_window_dir")" || return 1
      fi
    fi
    _taw_last_shell_pane="$_taw_shell_pane"
  fi

  if [[ "$_taw_shell_enabled" == true ]]; then
    for _taw_shell_cmd in "${_taw_shell_cmds[@]:1}"; do
      if [[ -n "$_taw_shell_cmd" ]]; then
        _taw_last_shell_pane="$(tmux split-window -h -P -F '#{pane_id}' \
          -t "$_taw_last_shell_pane" -c "$_taw_window_dir" \
          "$_taw_shell_cmd")" || return 1
      else
        _taw_last_shell_pane="$(tmux split-window -h -P -F '#{pane_id}' \
          -t "$_taw_last_shell_pane" -c "$_taw_window_dir")" || return 1
      fi
    done
  fi

  _taw_focus_pane="${_taw_editor_pane:-$_taw_initial_pane}"
  tmux select-pane -t "$_taw_focus_pane" >/dev/null 2>&1 || return 1
  _taw_switch_to_tmux_window "$_taw_window_id"
}

_taw_request_picker_mode() {
  local _taw_requested_mode="${1:l}"

  [[ "$_taw_explicit_picker_requested" != true ]] || {
    _taw_die "picker mode may only be specified once"
    return 1
  }
  case "$_taw_requested_mode" in
    ts|session) _taw_picker_mode=session ;;
    wt|worktree) _taw_picker_mode=worktree ;;
    b|branch) _taw_picker_mode=branch ;;
    *)
      _taw_die "unknown picker mode: $1"
      return 1
      ;;
  esac
  _taw_explicit_picker_requested=true
  _taw_project_picker_requested=true
}

while (( $# > 0 )); do
  case "$1" in
    --)
      shift
      _taw_positionals+=( "$@" )
      break
      ;;
    -debug|--debug)
      _taw_debug=true
      shift
      ;;
    --peer)
      _taw_peer=true
      shift
      ;;
    --convert)
      _taw_convert=true
      shift
      ;;
    --force)
      _taw_force=true
      shift
      ;;
    -ts|--ts|-picker|--picker|-pick-project|--pick-project)
      _taw_request_picker_mode session || return 1
      shift
      ;;
    --mode)
      (( $# >= 2 )) || _taw_die "--mode requires a value" || return 1
      [[ -n "$2" ]] || _taw_die "--mode requires a non-empty value" || return 1
      _taw_request_picker_mode "$2" || return 1
      shift 2
      ;;
    --mode=*)
      [[ -n "${1#*=}" ]] || _taw_die "--mode requires a non-empty value" || return 1
      _taw_request_picker_mode "${1#*=}" || return 1
      shift
      ;;
    -p|-proj|-prj|-r|-repo|-repository)
      (( $# >= 2 )) || _taw_die "$1 requires a value" || return 1
      [[ -n "$2" ]] || _taw_die "$1 requires a non-empty value" || return 1
      _taw_project_arg="$2"
      shift 2
      ;;
    -p=*|-proj=*|-prj=*|-r=*|-repo=*|-repository=*)
      _taw_project_arg="${1#*=}"
      [[ -n "$_taw_project_arg" ]] || _taw_die "${1%%=*} requires a non-empty value" || return 1
      shift
      ;;
    -agent)
      (( $# >= 2 )) || _taw_die "-agent requires a value" || return 1
      [[ -n "$2" ]] || _taw_die "-agent requires a non-empty value" || return 1
      _taw_agent_cmd="$2"
      _taw_agent_arg_provided=true
      shift 2
      ;;
    -agent=*)
      _taw_agent_cmd="${1#*=}"
      [[ -n "$_taw_agent_cmd" ]] || _taw_die "-agent requires a non-empty value" || return 1
      _taw_agent_arg_provided=true
      shift
      ;;
    -ed|-editor)
      (( $# >= 2 )) || _taw_die "$1 requires a value" || return 1
      [[ -n "$2" ]] || _taw_die "$1 requires a non-empty value" || return 1
      _taw_editor_cmd="$2"
      _taw_editor_arg_provided=true
      shift 2
      ;;
    -ed=*|-editor=*)
      _taw_editor_cmd="${1#*=}"
      [[ -n "$_taw_editor_cmd" ]] || _taw_die "-editor requires a non-empty value" || return 1
      _taw_editor_arg_provided=true
      shift
      ;;
    -b|-branch)
      (( $# >= 2 )) || _taw_die "$1 requires a value" || return 1
      [[ -n "$2" ]] || _taw_die "$1 requires a non-empty value" || return 1
      _taw_named_branch="$2"
      shift 2
      ;;
    -b=*|-branch=*)
      _taw_named_branch="${1#*=}"
      [[ -n "$_taw_named_branch" ]] || _taw_die "${1%%=*} requires a non-empty value" || return 1
      shift
      ;;
    -sh|-shell)
      _taw_shell_arg_provided=true
      if (( $# >= 2 )) && [[ "$2" != "--" && "$2" != -* ]]; then
        _taw_shell_cmds+=( "$2" )
        shift 2
      else
        _taw_shell_cmds+=( "" )
        shift
      fi
      ;;
    -sh=*|-shell=*)
      _taw_shell_arg_provided=true
      _taw_shell_cmds+=( "${1#*=}" )
      shift
      ;;
    -*)
      _taw_die "unknown option: $1"
      return 1
      ;;
    *)
      _taw_positionals+=( "$1" )
      shift
      ;;
  esac
done

(( ${#_taw_positionals[@]} <= 2 )) || {
  _taw_die "expected at most worktree and branch positional arguments"
  return 1
}

if [[ "$_taw_force" == true && "$_taw_peer" != true ]]; then
  _taw_die "--force requires --peer"
  return 1
fi

if [[ "$_taw_convert" == true ]]; then
  if (( ${#_taw_positionals[@]} != 1 )); then
    _taw_die "--convert requires exactly one project"
    return 1
  fi
  if [[ -n "$_taw_project_arg" || "$_taw_project_picker_requested" == true \
    || -n "$_taw_named_branch" || "$_taw_peer" == true || "$_taw_force" == true \
    || "$_taw_agent_arg_provided" == true || "$_taw_editor_arg_provided" == true \
    || ${#_taw_shell_cmds[@]} -gt 0 ]]; then
    _taw_die "--convert cannot be combined with project, branch, picker, peer, or layout options"
    return 1
  fi

  _taw_resolve_convert_project "${_taw_positionals[1]}" || return 1
  _taw_convert_project
  return
fi

if [[ "$_taw_peer" == true ]]; then
  [[ -n "${TMUX:-}" ]] || {
    _taw_die "--peer requires an active tmux client"
    return 1
  }
  _taw_current_session_id="$(tmux display-message -p '#{session_id}' 2>/dev/null)" || {
    _taw_die "could not resolve current tmux session"
    return 1
  }
  [[ -n "$_taw_current_session_id" ]] || {
    _taw_die "could not resolve current tmux session"
    return 1
  }
fi

if [[ -z "$_taw_editor_cmd" ]]; then
  if [[ -n "${EDITOR:-}" ]]; then
    _taw_editor_cmd="$EDITOR"
  elif command -v nvim >/dev/null 2>&1; then
    _taw_editor_cmd=nvim
  elif command -v vim >/dev/null 2>&1; then
    _taw_editor_cmd=vim
  else
    _taw_editor_cmd=nvim
  fi
fi

_taw_debug_dump "before project resolution"
_taw_resolve_project
case $? in
  0) ;;
  130) return 0 ;;
  *) return 1 ;;
esac

if [[ -n "$_taw_selected_tmux_session_target" ]]; then
  _taw_switch_to_selected_tmux_session
  return
fi

_taw_classify_operands || return 1

if [[ "$_taw_project_kind" == normal \
  && "$_taw_explicit_picker_requested" == true \
  && "$_taw_picker_mode" == branch ]]; then
  local _taw_existing_worktree

  _taw_existing_worktree="$(_taw_existing_worktree_for_branch "$_taw_picker_branch")" \
    || _taw_existing_worktree=
  if [[ -n "$_taw_existing_worktree" ]]; then
    _taw_window_dir="${_taw_existing_worktree:A}"
  else
    _taw_window_dir="$_taw_project_dir"
    _taw_checkout_existing_worktree_branch \
      "$_taw_project_dir" "$_taw_picker_branch" "$_taw_picker_ref" false || return 1
  fi
elif [[ "$_taw_project_kind" != plain && -n "$_taw_worktree_arg" ]]; then
  local _taw_worktree_target _taw_worktree_branch

  _taw_worktree_target="$(_taw_resolve_bare_worktree_arg "$_taw_worktree_arg")" || return 1
  _taw_window_dir="${_taw_worktree_target%%$'\t'*}"
  _taw_worktree_branch="${_taw_worktree_target#*$'\t'}"
  if [[ -n "$_taw_base_ref" ]]; then
    _taw_resolve_branch_target "$_taw_base_ref" || return 1
    _taw_open_managed_worktree "$_taw_worktree_branch" \
      "$_taw_branch_target_ref" "$_taw_window_dir" || return 1
  elif [[ "$_taw_project_kind" == normal ]] \
    && _taw_resolve_branch_target "$_taw_worktree_branch"; then
    _taw_worktree_branch="$_taw_branch_target_name"
    if [[ "$_taw_worktree_arg" != /* ]]; then
      _taw_window_dir="${_taw_project_dir:A}/.worktrees/$_taw_worktree_branch"
    fi
    _taw_open_managed_worktree "$_taw_worktree_branch" \
      "$_taw_branch_target_ref" "$_taw_window_dir" || return 1
  elif [[ "$_taw_project_kind" == normal \
    && "$_taw_worktree_branch" == refs/remotes/* ]]; then
    return 1
  elif [[ "$_taw_project_kind" == normal ]] \
    && _taw_has_configured_remote_prefix "$_taw_worktree_branch"; then
    return 1
  elif _taw_git rev-parse --verify --quiet HEAD^{commit} >/dev/null 2>&1; then
    _taw_open_managed_worktree "$_taw_worktree_branch" \
      "$(_taw_current_head_ref)" "$_taw_window_dir" || return 1
  else
    _taw_prepare_orphan_worktree "$_taw_window_dir" "$_taw_worktree_branch" || return 1
  fi
elif [[ "$_taw_project_kind" == normal || "$_taw_is_bare" == true ]]; then
  local _taw_branch_worktree _taw_branch_ref _taw_existing_worktree _taw_skip_prepare_worktree
  local _taw_nonbare_worktree_count

  _taw_skip_prepare_worktree=false
  if [[ "$_taw_explicit_picker_requested" == true && "$_taw_picker_mode" == worktree ]]; then
    [[ -n "$_taw_selected_worktree_dir" ]] || {
      _taw_die "selected worktree is missing a path"
      return 1
    }
    _taw_window_dir="$_taw_selected_worktree_dir"
    _taw_skip_prepare_worktree=true
  elif [[ "$_taw_explicit_picker_requested" == true && "$_taw_picker_mode" == branch ]]; then
    _taw_existing_worktree="$(_taw_existing_worktree_for_branch "$_taw_picker_branch")" \
      || _taw_existing_worktree=
    if [[ -n "$_taw_existing_worktree" ]]; then
      _taw_window_dir="${_taw_existing_worktree:A}"
      _taw_skip_prepare_worktree=true
    else
      _taw_branch_worktree="$_taw_picker_branch"
      _taw_branch_ref="$_taw_picker_ref"
    fi
  elif [[ -n "$_taw_selected_worktree_dir" && -z "$_taw_base_ref" ]]; then
    _taw_window_dir="$_taw_selected_worktree_dir"
    _taw_skip_prepare_worktree=true
  elif [[ -n "$_taw_base_ref" ]]; then
    _taw_resolve_branch_target "$_taw_base_ref" || return 1
    _taw_branch_worktree="$_taw_branch_target_name"
    _taw_branch_ref="$_taw_branch_target_ref"
  elif [[ "$_taw_project_kind" == normal \
    && "$_taw_project_picker_requested" == true ]]; then
    _taw_window_dir="$_taw_project_dir"
    _taw_skip_prepare_worktree=true
  else
    _taw_nonbare_worktree_count="$(_taw_bare_worktree_count)" || return 1
    if [[ "$_taw_project_picker_requested" != true ]] \
      && (( _taw_nonbare_worktree_count > 0 )) \
      && command -v fzf >/dev/null 2>&1; then
      _taw_select_bare_target_with_fzf
      case $? in
        0)
          case "$_taw_picker_kind" in
            worktree)
              [[ -n "$_taw_picker_path" ]] || {
                _taw_die "selected worktree is missing a path"
                return 1
              }
              _taw_window_dir="${_taw_picker_path:A}"
              _taw_skip_prepare_worktree=true
              ;;
            branch)
              [[ -n "$_taw_picker_branch" && -n "$_taw_picker_ref" ]] || {
                _taw_die "selected branch is incomplete"
                return 1
              }
              _taw_branch_worktree="$_taw_picker_branch"
              _taw_branch_ref="$_taw_picker_ref"
              ;;
            *)
              _taw_die "unknown picker selection: $_taw_picker_kind"
              return 1
              ;;
          esac
          ;;
        2)
          if [[ "$_taw_project_kind" == normal ]]; then
            _taw_window_dir="$_taw_project_dir"
            _taw_skip_prepare_worktree=true
          else
            _taw_default_bare_target || {
              _taw_die "could not determine default branch for bare project"
              return 1
            }
            _taw_branch_worktree="$_taw_default_branch_result"
            _taw_branch_ref="$_taw_default_base_ref"
          fi
          ;;
        130)
          return 0
          ;;
        *)
          _taw_die "worktree selection failed"
          return 1
          ;;
      esac
    elif [[ "$_taw_project_kind" == normal ]]; then
      _taw_window_dir="$_taw_project_dir"
      _taw_skip_prepare_worktree=true
    else
      _taw_default_bare_target || {
        _taw_die "could not determine default branch for bare project"
        return 1
      }
      _taw_branch_worktree="$_taw_default_branch_result"
      _taw_branch_ref="$_taw_default_base_ref"
    fi
  fi

  if [[ "$_taw_skip_prepare_worktree" != true ]]; then
    if [[ -n "$_taw_branch_ref" ]]; then
      _taw_open_managed_worktree "$_taw_branch_worktree" "$_taw_branch_ref" || return 1
    else
      _taw_window_dir="${_taw_project_dir:A}/.worktrees/$_taw_branch_worktree"
      _taw_prepare_orphan_worktree "$_taw_window_dir" "$_taw_branch_worktree" || return 1
    fi
  fi
else
  _taw_window_dir="$_taw_project_dir"
  _taw_window_name="${_taw_project_dir:t}"
fi

_taw_window_name="${_taw_window_dir:t}"
_taw_window_name="${_taw_window_name//:/_}"
if [[ -n "$_taw_project_session_name" ]]; then
  _taw_session_name="$_taw_project_session_name"
  _taw_session_target="${_taw_project_session_target:-$_taw_session_name}"
else
  _taw_project_name="${_taw_project_dir:t}"
  _taw_project_name="${_taw_project_name%.git}"
  _taw_session_name="${_taw_project_name//:/_}"
  _taw_session_target="$_taw_session_name"
fi

_taw_editor_enabled=true
if (( ${#_taw_shell_cmds[@]} > 0 )); then
  _taw_shell_enabled=true
else
  _taw_shell_enabled=false
fi

if [[ -n "$_taw_picker_layout" ]]; then
  case "$_taw_picker_layout" in
    shell)
      _taw_editor_enabled=false
      _taw_agent_enabled=false
      _taw_shell_enabled=true
      ;;
    agent)
      _taw_editor_enabled=false
      _taw_agent_enabled=true
      _taw_shell_enabled=false
      ;;
    editor-shell)
      _taw_agent_enabled=false
      _taw_shell_enabled=true
      ;;
    editor-agent)
      _taw_agent_enabled=true
      _taw_shell_enabled=false
      ;;
    editor-agent-shell)
      _taw_agent_enabled=true
      _taw_shell_enabled=true
      ;;
  esac

  if [[ "$_taw_shell_enabled" == true && ${#_taw_shell_cmds[@]} -eq 0 ]]; then
    _taw_shell_cmds+=( "" )
  fi
  if [[ "$_taw_agent_enabled" == true && "$_taw_agent_arg_provided" != true \
    && -n "${TAW_AGENT:-}" ]]; then
    local _taw_agent_override

    _taw_agent_override="$(_taw_trim_whitespace "$TAW_AGENT")"
    [[ -n "$_taw_agent_override" ]] && _taw_agent_cmd="$_taw_agent_override"
  fi
elif [[ "$_taw_agent_arg_provided" == true ]]; then
  _taw_agent_enabled=true
elif [[ "$_taw_project_picker_requested" == true ]]; then
  _taw_agent_enabled=false
else
  _taw_agent_enabled=true
  if [[ -n "${TAW_AGENT:-}" ]]; then
    local _taw_agent_override

    _taw_agent_override="$(_taw_trim_whitespace "$TAW_AGENT")"
    if [[ -n "$_taw_agent_override" ]]; then
      _taw_agent_cmd="$_taw_agent_override"
      _taw_agent_env_override=true
    fi
  fi
fi

_taw_debug_dump "before tmux window"
_taw_create_tmux_window
