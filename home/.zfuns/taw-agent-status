#!/usr/bin/env bash

set -u

usage() {
  printf 'usage: taw-agent-status start <codex|claude> [pane]\n' >&2
  printf '       taw-agent-status set <codex|claude> <idle|thinking|waiting> [pane]\n' >&2
  printf '       taw-agent-status hook claude <idle|thinking|waiting>\n' >&2
  printf '       taw-agent-status acknowledge [pane]\n' >&2
  printf '       taw-agent-status clear [pane]\n' >&2
  printf '       taw-agent-status sync\n' >&2
  printf '       taw-agent-status refresh\n' >&2
  printf '       taw-agent-status unlink <window>\n' >&2
}

AGENT_SESSION_NAME=agents
AGENT_SESSION_MARKER=@taw_agent_link_session
AGENT_DASHBOARD_SESSION_MARKER=@taw_agent_dashboard_session
AGENT_SUPPRESSION_OPTION=@taw_agent_link_suppressed
AGENT_PANE_PID_OPTION=@taw_agent_pane_pid
AGENT_LINK_LOCK=taw-agent-link-session
AGENT_SESSION_ID=
AGENT_SESSION_NAMED_ID=
SOURCE_WINDOW_IDS=()
SOURCE_WINDOW_MEMBERS=()
SOURCE_WINDOW_SUPPRESSIONS=()
SOURCE_WINDOW_SESSIONS=()
SOURCE_WINDOW_LABELS=()
DESIRED_WINDOW_IDS=()
SOURCE_WINDOW_INDEX=-1
STATUS_TMUX=(tmux)
CLAUDE_ROUTE_ROOT=
CLAUDE_HOOK_SESSION=
CLAUDE_EVENT_AT=
CLAUDE_HOOK_FOREGROUND=false
CLAUDE_START=false
STATUS_LOCK=taw-agent-status

with_tmux_lock() (
  local lock="$1"
  shift

  "${STATUS_TMUX[@]}" wait-for -L "$lock" >/dev/null 2>&1 || return 0
  trap '"${STATUS_TMUX[@]}" wait-for -U "$lock" >/dev/null 2>&1 || true' EXIT
  trap 'exit 0' HUP INT TERM
  "$@"
)

with_status_lock() {
  with_tmux_lock "$STATUS_LOCK" "$@"
}

capture_claude_event_time() {
  command -v jq >/dev/null 2>&1 || return 1
  # Lock contention must not make an earlier hook appear newer than a native idle transition.
  CLAUDE_EVENT_AT="$(jq -n 'now * 1000 | floor' 2>/dev/null)"
}

claude_domain() {
  case "$(uname -s 2>/dev/null)" in
    Darwin) printf 'darwin\n' ;;
    Linux) printf 'linux\n' ;;
    *) return 1 ;;
  esac
}

process_start() {
  local started

  started="$(TZ=UTC LC_ALL=C ps -p "$1" -o lstart= 2>/dev/null)" || return 1
  started="${started#"${started%%[![:space:]]*}"}"
  started="${started%"${started##*[![:space:]]}"}"
  [[ -n "$started" ]] || return 1
  printf '%s\n' "$started"
}

read_claude_payload() {
  local payload="$1"

  command -v jq >/dev/null 2>&1 || return 1
  [[ -n "$payload" ]] || payload='{}'
  CLAUDE_HOOK_SESSION="$(jq -ser '
    select(length == 1) | .[0] | select(type == "object")
    | select(.agent_id == null or .agent_id == "")
    | (.session_id // "") | select(type == "string")
    | select(. == "" or test("^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"))
  ' <<<"$payload" 2>/dev/null)"
}

claude_route_record() {
  local record="$1" session="$2" domain="$3"

  jq -ser --arg session "$session" --arg domain "$domain" '
    select(length == 1) | .[0]
    | select(type == "object" and .kind == "interactive" and .pidDomain == $domain)
    | select(.sessionId | type == "string")
    | select(.sessionId | test("^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"))
    | select($session == "" or .sessionId == $session
      or .parkedJobId == ($session | split("-")[0]))
    | select((.pid | type) == "number" and .pid > 0 and .pid == (.pid | floor))
    | select((.tmux | type) == "string" and (.procStart | type) == "string")
    | [.pid, .tmux, .procStart] | @tsv
  ' "$record" 2>/dev/null
}

claude_route_valid() {
  local route="$1" owner address started current pane window live root agent saved_root
  local actual_pane actual_window parent steps=0

  IFS=$'\t' read -r owner address started <<<"$route"
  [[ "$owner" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$address" =~ :(@[0-9]+)\.(%[0-9]+)$ ]] || return 1
  window="${BASH_REMATCH[1]}"
  pane="${BASH_REMATCH[2]}"
  current="$(process_start "$owner")" || return 1
  [[ -n "$started" && "$current" == "$started" ]] || return 1
  live="$("${STATUS_TMUX[@]}" display-message -p -t "$pane" \
    $'#{pane_id}\t#{window_id}\t#{pane_pid}\t#{@taw_agent}\t#{@taw_agent_pane_pid}' \
    2>/dev/null)" || return 1
  IFS=$'\t' read -r actual_pane actual_window root agent saved_root <<<"$live"
  [[ "$actual_pane" == "$pane" && "$actual_window" == "$window" \
    && "$agent" == claude && "$root" =~ ^[1-9][0-9]*$ && "$saved_root" == "$root" ]] \
    || return 1

  current="$owner"
  while [[ "$current" =~ ^[1-9][0-9]*$ && "$current" -gt 1 && "$steps" -lt 256 ]]; do
    if [[ "$current" == "$root" ]]; then
      CLAUDE_ROUTE_ROOT="$root"
      return 0
    fi
    parent="$(ps -p "$current" -o ppid= 2>/dev/null)" || return 1
    parent="${parent//[[:space:]]/}"
    [[ "$parent" != "$current" ]] || return 1
    current="$parent"
    ((steps += 1))
  done
  return 1
}

publish_claude_hook() {
  local state="$1" pane session owner address started payload
  local config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

  [[ ! -t 0 ]] || return 0
  payload="$(cat)" || return 0
  read_claude_payload "$payload" || return 0
  [[ -n "$payload" ]] || payload='{}'
  if [[ "$(jq -r '.hook_event_name == "PostToolUseFailure" and .is_interrupt == true' \
    <<<"$payload" 2>/dev/null)" == true ]]; then
    state=idle
  fi
  if pane="$(pane_target)"; then
    CLAUDE_HOOK_FOREGROUND=true
    set_status claude "$state" "$pane"
    return 0
  fi
  session="$CLAUDE_HOOK_SESSION"
  [[ -n "$session" ]] || return 0
  # Detached workers lose tmux routing, but the interactive owner retains the job association.
  find_claude_record "" "$session" "$config_dir" || return 0
  IFS=$'\t' read -r owner address started <<<"$CLAUDE_ROUTE"
  pane="${address##*.}"
  set_status claude "$state" "$pane" "$CLAUDE_ROUTE_ROOT"
}

find_claude_record() {
  local pane="$1" session="$2" config_dir="$3" domain record route owner address started
  local matches=0

  CLAUDE_RECORD=
  CLAUDE_ROUTE=
  domain="$(claude_domain)" || return 1
  for record in "$config_dir"/sessions/[0-9]*.json; do
    [[ -f "$record" ]] || continue
    route="$(claude_route_record "$record" "$session" "$domain")" || continue
    IFS=$'\t' read -r owner address started <<<"$route"
    [[ "${record##*/}" == "$owner.json" ]] || continue
    [[ -z "$pane" || "${address##*.}" == "$pane" ]] || continue
    claude_route_valid "$route" || continue
    ((matches += 1))
    CLAUDE_RECORD="$record"
    CLAUDE_ROUTE="$route"
  done
  [[ "$matches" == 1 ]] || return 1
  route="$(claude_route_record "$CLAUDE_RECORD" "$session" "$domain")" || return 1
  [[ "$route" == "$CLAUDE_ROUTE" ]] && claude_route_valid "$route"
}

remember_claude_status() {
  local pane="$1" root="$2" meta config_dir session

  command -v jq >/dev/null 2>&1 || return 0
  meta="$("${STATUS_TMUX[@]}" show-option -pqv -t "$pane" @taw_claude_status 2>/dev/null)"
  if [[ "$CLAUDE_START" == true ]]; then
    meta='{}'
  fi
  meta="$(jq -ce --arg root "$root" '
    if type == "object" and .root == $root then . else {} end
  ' <<<"${meta:-null}" 2>/dev/null)" || meta='{}'
  config_dir="$(jq -r '.config_dir // empty' <<<"$meta")"
  config_dir="${CLAUDE_CONFIG_DIR:-${config_dir:-$HOME/.claude}}"
  session="$(jq -r '.session_id // empty' <<<"$meta")"
  if [[ "$CLAUDE_START" == true || "$CLAUDE_HOOK_FOREGROUND" == true || -z "$session" ]]; then
    session="${CLAUDE_HOOK_SESSION:-$session}"
  fi
  meta="$(jq -c --arg root "$root" --arg config "$config_dir" --arg session "$session" \
    --argjson event_at "$CLAUDE_EVENT_AT" '
    if .session_id != null and .session_id != $session then {} else . end
    | .root = $root | .config_dir = $config | .session_id = $session
    | .event_at = $event_at
  ' <<<"$meta")" || return 0
  if [[ "$(jq -r '.route // empty' <<<"$meta")" == "" ]] \
    && find_claude_record "$pane" "$session" "$config_dir"; then
    meta="$(jq -c --arg route "$CLAUDE_ROUTE" '.route = $route' <<<"$meta")" || return 0
    if [[ -z "$session" ]]; then
      session="$(jq -r '.sessionId' "$CLAUDE_RECORD")" || return 0
      meta="$(jq -c --arg session "$session" '.session_id = $session' <<<"$meta")" || return 0
    fi
  fi
  "${STATUS_TMUX[@]}" set-option -p -t "$pane" @taw_claude_status "$meta" \
    >/dev/null 2>&1 || true
}

refresh_claude_pane() {
  local pane="$1" live root state meta session config_dir saved_route owner address started
  local current snapshot native_state native_at event_at latest revision guard commands option route

  live="$(tmux display-message -p -t "$pane" \
    $'#{@taw_agent}\t#{pane_pid}\t#{@taw_agent_pane_pid}\t#{@taw_agent_state}' \
    2>/dev/null)" || return 0
  IFS=$'\t' read -r current root owner state <<<"$live"
  [[ "$current" == claude && "$root" =~ ^[1-9][0-9]*$ && "$root" == "$owner" ]] || return 0
  case "$state" in idle|thinking|waiting|acknowledged) ;; *) return 0 ;; esac
  revision="$(tmux show-option -pqv -t "$pane" @taw_agent_revision 2>/dev/null)"
  [[ -z "$revision" || "$revision" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
  guard="#{&&:#{==:#{pane_pid},$root},#{&&:#{==:#{@taw_agent},claude},#{&&:#{==:#{@taw_agent_state},$state},#{==:#{@taw_agent_revision},$revision}}}}"
  meta="$(tmux show-option -pqv -t "$pane" @taw_claude_status 2>/dev/null)"
  [[ -n "$meta" ]] || meta='{}'
  meta="$(jq -ce --arg root "$root" '
    select(type == "object") | select(.root == null or .root == $root)
    | select((.event_at // 0) | type == "number")
    | select((.config_dir // "") | type == "string")
    | select((.session_id // "") | type == "string")
    | select((.route // "") | type == "string")
  ' <<<"$meta" 2>/dev/null)" || return 0
  session="$(jq -r '.session_id // ""' <<<"$meta")"
  config_dir="$(jq -r '.config_dir // empty' <<<"$meta")"
  config_dir="${config_dir:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}"
  saved_route="$(jq -r '.route // empty' <<<"$meta")"
  if [[ -n "$saved_route" ]]; then
    IFS=$'\t' read -r owner address started <<<"$saved_route"
    [[ "$owner" =~ ^[1-9][0-9]*$ && "${address##*.}" == "$pane" && -n "$started" ]] \
      || return 0
    current="$(process_start "$owner")" || current=
    # An unreadable start time alone is not evidence that a live process exited.
    if [[ -z "$current" ]] && kill -0 "$owner" 2>/dev/null; then
      return 0
    fi
    if [[ "$current" != "$started" ]]; then
      commands=
      for option in @taw_agent_state @taw_agent "$AGENT_PANE_PID_OPTION" \
        @taw_claude_status @taw_agent_revision; do
        commands+="set-option -pu -t $pane $option ; "
      done
      tmux if-shell -F -t "$pane" "$guard" "$commands" >/dev/null 2>&1 || true
      return 10
    fi
  fi
  find_claude_record "$pane" "$session" "$config_dir" || return 0
  [[ -z "$saved_route" || "$saved_route" == "$CLAUDE_ROUTE" ]] || return 0
  snapshot="$(jq -ce 'select(type == "object")' "$CLAUDE_RECORD" 2>/dev/null)" || return 0
  route="$(claude_route_record /dev/stdin "$session" "$(claude_domain)" \
    <<<"$snapshot")" || return 0
  [[ "$route" == "$CLAUDE_ROUTE" ]] || return 0
  [[ -n "$session" ]] || session="$(jq -r '.sessionId' <<<"$snapshot")"
  meta="$(jq -c --arg root "$root" --arg config "$config_dir" --arg route "$CLAUDE_ROUTE" \
    --arg session "$session" '
      .root = $root | .config_dir = $config | .route = $route | .session_id = $session
      | .event_at = (.event_at // 0)
    ' <<<"$meta")" || return 0
  tmux set-option -p -t "$pane" @taw_claude_status "$meta" >/dev/null 2>&1 || return 0
  [[ "$state" == thinking ]] || return 0
  native_state="$(jq -r '.status // empty' <<<"$snapshot")"
  [[ "$native_state" == idle ]] || return 0
  native_at="$(jq -er '.statusUpdatedAt | select(type == "number" and . > 0) | floor' \
    <<<"$snapshot" 2>/dev/null)" || return 0
  event_at="$(jq -r '.event_at' <<<"$meta")"
  [[ "$native_at" =~ ^[0-9]+$ && "$event_at" =~ ^[0-9]+$ ]] || return 0
  # A record from before the latest prompt must not mark the new turn idle.
  (( native_at > event_at )) || return 0
  latest="$(jq -ce 'select(type == "object")' "$CLAUDE_RECORD" 2>/dev/null)" || return 0
  [[ "$latest" == "$snapshot" ]] || return 0
  claude_route_valid "$CLAUDE_ROUTE" || return 0
  tmux if-shell -F -t "$pane" "$guard" \
    "set-option -p -t $pane @taw_agent_state idle" >/dev/null 2>&1 || true
}

refresh_claude_status() {
  local now last panes pane seen=$'\n' cleared=false

  command -v jq >/dev/null 2>&1 || return 0
  now="$(date +%s)" || return 0
  last="$(tmux show-option -gqv @taw_agent_refresh_at 2>/dev/null)"
  if [[ "$last" =~ ^[0-9]+$ ]] && (( now >= last && now - last < 5 )); then
    return 0
  fi
  tmux set-option -g @taw_agent_refresh_at "$now" >/dev/null 2>&1 || return 0
  panes="$(tmux list-panes -a -F '#{?#{==:#{@taw_agent},claude},#{pane_id},}' \
    2>/dev/null)" || return 0
  while IFS= read -r pane; do
    [[ "$pane" =~ ^%[0-9]+$ && "$seen" != *$'\n'"$pane"$'\n'* ]] || continue
    seen+="$pane"$'\n'
    if ! with_status_lock refresh_claude_pane "$pane"; then
      cleared=true
    fi
  done <<<"$panes"
  [[ "$cleared" != true ]] || sync_agent_session >/dev/null 2>&1 || true
}

dashboard_state_file() {
  local runtime_dir server_key

  runtime_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
  server_key="${TMUX:-}"
  server_key="${server_key%%,*}"
  if [[ -z "$server_key" ]] && command -v tmux >/dev/null 2>&1; then
    server_key="$(tmux display-message -p '#{socket_path}' 2>/dev/null || true)"
  fi
  server_key="${server_key//\//_}"
  server_key="${server_key//:/_}"
  server_key="${server_key//[^[:alnum:]_.-]/_}"
  if [[ -n "$server_key" ]]; then
    printf '%s\n' "${TAW_AGENT_DASHBOARD_STATE_FILE:-$runtime_dir/taw-agent-dashboard.$server_key.state}"
  else
    printf '%s\n' "${TAW_AGENT_DASHBOARD_STATE_FILE:-$runtime_dir/taw-agent-dashboard.state}"
  fi
}

sync_dashboard() {
  local dashboard="$HOME/.zfuns/taw-agent-dashboard"

  [[ -x "$dashboard" && -f "$(dashboard_state_file)" ]] || return 0
  "$dashboard" sync >/dev/null 2>&1 &
}

pane_target() {
  local explicit_pane="${1:-}"

  [[ -n "${TMUX:-}" ]] || return 1
  if [[ -n "$explicit_pane" ]]; then
    printf '%s\n' "$explicit_pane"
  elif [[ -n "${TMUX_PANE:-}" ]]; then
    printf '%s\n' "$TMUX_PANE"
  else
    return 1
  fi
}

tmux_available() {
  command -v tmux >/dev/null 2>&1
}

supported_agent() {
  case "$1" in
    codex|claude) return 0 ;;
    *) return 1 ;;
  esac
}

source_window_index() {
  local window="$1"
  local i

  SOURCE_WINDOW_INDEX=-1
  for ((i = 0; i < ${#SOURCE_WINDOW_IDS[@]}; i++)); do
    if [[ "${SOURCE_WINDOW_IDS[$i]}" = "$window" ]]; then
      SOURCE_WINDOW_INDEX="$i"
      return 0
    fi
  done
  return 1
}

array_contains() {
  local expected="$1"
  shift
  local actual

  for actual in "$@"; do
    [[ "$actual" = "$expected" ]] && return 0
  done
  return 1
}

locate_agent_session() {
  local sessions line session_id session_name marker rest tab=$'\t'
  local managed_id=

  AGENT_SESSION_ID=
  AGENT_SESSION_NAMED_ID=
  sessions="$(tmux list-sessions \
    -F $'#{session_id}\t#{session_name}\t#{@taw_agent_link_session}' 2>/dev/null)" \
    || return 1

  while IFS= read -r line; do
    [[ -n "$line" && "$line" = *"$tab"* ]] || continue
    session_id="${line%%"$tab"*}"
    rest="${line#*"$tab"}"
    session_name="${rest%%"$tab"*}"
    marker="${rest#*"$tab"}"

    if [[ "$marker" = 1 ]]; then
      if [[ -n "$managed_id" && "$managed_id" != "$session_id" ]]; then
        printf 'taw-agent-status: multiple managed agent sessions found\n' >&2
        return 2
      fi
      managed_id="$session_id"
    fi
    if [[ "$session_name" = "$AGENT_SESSION_NAME" ]]; then
      AGENT_SESSION_NAMED_ID="$session_id"
    fi
  done <<<"$sessions"

  if [[ -n "$AGENT_SESSION_NAMED_ID" && "$AGENT_SESSION_NAMED_ID" != "$managed_id" ]]; then
    printf 'taw-agent-status: refusing unowned tmux session: %s\n' \
      "$AGENT_SESSION_NAME" >&2
    return 2
  fi

  if [[ -n "$managed_id" && -z "$AGENT_SESSION_NAMED_ID" ]]; then
    tmux rename-session -t "$managed_id" "$AGENT_SESSION_NAME" >/dev/null \
      || return 1
  fi
  AGENT_SESSION_ID="$managed_id"
}

collect_source_windows() {
  local panes line session_id window_id pane_id agent agent_pane_pid pane_pid
  local suppression dashboard_session_marker rest tab=$'\t'
  local member i fingerprint session_name

  SOURCE_WINDOW_IDS=()
  SOURCE_WINDOW_MEMBERS=()
  SOURCE_WINDOW_SUPPRESSIONS=()
  SOURCE_WINDOW_SESSIONS=()
  SOURCE_WINDOW_LABELS=()
  DESIRED_WINDOW_IDS=()
  panes="$(tmux list-panes -a \
    -F $'#{session_id}\t#{window_id}\t#{pane_id}\t#{@taw_agent}\t#{@taw_agent_pane_pid}\t#{pane_pid}\t#{@taw_agent_link_suppressed}\t#{@taw_agent_dashboard_session}\t#{session_name}' \
    2>/dev/null)" || return 1

  while IFS= read -r line; do
    [[ -n "$line" && "$line" = *"$tab"* ]] || continue
    session_id="${line%%"$tab"*}"
    rest="${line#*"$tab"}"
    window_id="${rest%%"$tab"*}"
    rest="${rest#*"$tab"}"
    pane_id="${rest%%"$tab"*}"
    rest="${rest#*"$tab"}"
    agent="${rest%%"$tab"*}"
    rest="${rest#*"$tab"}"
    agent_pane_pid="${rest%%"$tab"*}"
    rest="${rest#*"$tab"}"
    pane_pid="${rest%%"$tab"*}"
    suppression="${rest#*"$tab"}"
    if [[ "$suppression" = *"$tab"* ]]; then
      dashboard_session_marker="${suppression#*"$tab"}"
      suppression="${suppression%%"$tab"*}"
      session_name=
      if [[ "$dashboard_session_marker" = *"$tab"* ]]; then
        session_name="${dashboard_session_marker#*"$tab"}"
        dashboard_session_marker="${dashboard_session_marker%%"$tab"*}"
      fi
    else
      dashboard_session_marker=
      session_name=
    fi
    [[ -n "$session_id" && -n "$window_id" && -n "$pane_id" ]] || continue
    [[ -z "$AGENT_SESSION_ID" || "$session_id" != "$AGENT_SESSION_ID" ]] || continue
    [[ "$dashboard_session_marker" = 1 ]] && continue

    if ! source_window_index "$window_id"; then
      SOURCE_WINDOW_IDS+=( "$window_id" )
      SOURCE_WINDOW_MEMBERS+=( "" )
      SOURCE_WINDOW_SUPPRESSIONS+=( "$suppression" )
      SOURCE_WINDOW_SESSIONS+=( "" )
      SOURCE_WINDOW_LABELS+=( "" )
      SOURCE_WINDOW_INDEX=$((${#SOURCE_WINDOW_IDS[@]} - 1))
    fi
    case $'\n'"${SOURCE_WINDOW_SESSIONS[$SOURCE_WINDOW_INDEX]}" in
      *$'\n'"$session_id"$'\n'*) ;;
      *)
        SOURCE_WINDOW_SESSIONS[$SOURCE_WINDOW_INDEX]+="$session_id"$'\n'
        if [[ -n "$session_name" ]]; then
          if [[ -n "${SOURCE_WINDOW_LABELS[$SOURCE_WINDOW_INDEX]}" ]]; then
            SOURCE_WINDOW_LABELS[$SOURCE_WINDOW_INDEX]+=', '
          fi
          SOURCE_WINDOW_LABELS[$SOURCE_WINDOW_INDEX]+="$session_name"
        fi
        ;;
    esac
    supported_agent "$agent" || continue
    if [[ -n "$agent_pane_pid" && "$agent_pane_pid" != "$pane_pid" ]]; then
      clear_status "$pane_id"
      continue
    fi
    if [[ -z "$agent_pane_pid" ]]; then
      tmux set-option -p -t "$pane_id" "$AGENT_PANE_PID_OPTION" "$pane_pid" \
        >/dev/null 2>&1 || true
    fi
    member="$pane_id=$agent"
    case $'\n'"${SOURCE_WINDOW_MEMBERS[$SOURCE_WINDOW_INDEX]}" in
      *$'\n'"$member"$'\n'*) ;;
      *) SOURCE_WINDOW_MEMBERS[$SOURCE_WINDOW_INDEX]+="$member"$'\n' ;;
    esac
  done <<<"$panes"

  for ((i = 0; i < ${#SOURCE_WINDOW_IDS[@]}; i++)); do
    fingerprint="$(printf '%s' "${SOURCE_WINDOW_MEMBERS[$i]}" \
      | LC_ALL=C sort -u | tr '\n' ',')"
    suppression="${SOURCE_WINDOW_SUPPRESSIONS[$i]}"

    if [[ -z "$fingerprint" ]]; then
      if [[ -n "$suppression" ]]; then
        tmux set-option -wu -t "${SOURCE_WINDOW_IDS[$i]}" \
          "$AGENT_SUPPRESSION_OPTION" >/dev/null 2>&1 || true
      fi
      continue
    fi
    if [[ "$suppression" = "$fingerprint" ]]; then
      continue
    fi
    if [[ -n "$suppression" ]]; then
      tmux set-option -wu -t "${SOURCE_WINDOW_IDS[$i]}" \
        "$AGENT_SUPPRESSION_OPTION" >/dev/null 2>&1 || true
    fi
    SOURCE_WINDOW_MEMBERS[$i]="$fingerprint"
    tmux set-option -w -t "${SOURCE_WINDOW_IDS[$i]}" @taw_agent_source_sessions \
      "${SOURCE_WINDOW_LABELS[$i]}" >/dev/null || return 1
    DESIRED_WINDOW_IDS+=( "${SOURCE_WINDOW_IDS[$i]}" )
  done
}

create_agent_session() {
  local first_window="$1"
  local temp_parent="${TMPDIR:-/tmp}" temp_template temp_dir created
  local created_session created_window_index tab=$'\t'

  if [[ "$temp_parent" = / ]]; then
    temp_template=/XXX
  else
    temp_template="${temp_parent%/}/XXX"
  fi
  temp_dir="$(mktemp -d "$temp_template")" || return 1
  created="$(tmux new-session -d -P \
    -F $'#{session_id}\t#{window_index}' -s "$AGENT_SESSION_NAME" \
    -c "$temp_dir")" || {
    rmdir "$temp_dir" >/dev/null 2>&1 || true
    return 1
  }

  created_session="${created%%"$tab"*}"
  created_window_index="${created#*"$tab"}"
  if [[ -z "$created_session" || -z "$created_window_index" \
    || "$created_session" = "$created" ]]; then
    tmux kill-session -t "=$AGENT_SESSION_NAME" >/dev/null 2>&1 || true
    return 1
  fi
  tmux set-option -t "$created_session" "$AGENT_SESSION_MARKER" 1 \
    >/dev/null || {
    tmux kill-session -t "$created_session" >/dev/null 2>&1 || true
    return 1
  }
  tmux link-window -d -k -s "$first_window" \
    -t "$created_session:$created_window_index" >/dev/null || {
    tmux kill-session -t "$created_session" >/dev/null 2>&1 || true
    return 1
  }
  AGENT_SESSION_ID="$created_session"
}

remove_agent_session_window() {
  local window="$1"

  tmux unlink-window -t "$AGENT_SESSION_ID:$window" >/dev/null 2>&1 \
    || tmux kill-window -t "$AGENT_SESSION_ID:$window" >/dev/null 2>&1 \
    || true
}

renumber_agent_session() {
  tmux has-session -t "$AGENT_SESSION_ID" 2>/dev/null || return 0
  # tmux's renumber-windows option does not close gaps left by unlink-window.
  tmux move-window -r -t "$AGENT_SESSION_ID:" >/dev/null
}

reconcile_agent_session() {
  local current_windows current desired missing_first= window
  local has_current_desired=false
  local missing_count=0
  local -a current_ids missing_ids stale_ids

  locate_agent_session || return $?
  collect_source_windows || return 1

  current_windows=
  if [[ -n "$AGENT_SESSION_ID" ]]; then
    current_windows="$(tmux list-windows -t "$AGENT_SESSION_ID" -F '#{window_id}' 2>/dev/null)" || return 1
    while IFS= read -r current; do
      [[ -n "$current" ]] || continue
      if ! array_contains "$current" "${DESIRED_WINDOW_IDS[@]+"${DESIRED_WINDOW_IDS[@]}"}"; then
        # Retained failures must stay readable after the exiting agent clears its metadata.
        if [[ "$(tmux display-message -p -t "$current" '#{P:#{pane_dead}}')" == *1* ]]; then
          DESIRED_WINDOW_IDS+=( "$current" )
        fi
      fi
    done <<<"$current_windows"
  fi

  if (( ${#DESIRED_WINDOW_IDS[@]} == 0 )); then
    if [[ -n "$AGENT_SESSION_ID" ]]; then
      tmux kill-session -t "$AGENT_SESSION_ID" >/dev/null || return 1
    fi
    return 0
  fi

  if [[ -z "$AGENT_SESSION_ID" ]]; then
    create_agent_session "${DESIRED_WINDOW_IDS[0]}" || return 1
    current_windows="$(tmux list-windows -t "$AGENT_SESSION_ID" -F '#{window_id}' 2>/dev/null)" || return 1
  fi

  current_ids=()
  while IFS= read -r current; do
    [[ -n "$current" ]] && current_ids+=( "$current" )
  done <<<"$current_windows"
  missing_ids=()
  stale_ids=()

  for current in "${current_ids[@]+"${current_ids[@]}"}"; do
    if array_contains "$current" "${DESIRED_WINDOW_IDS[@]}"; then
      has_current_desired=true
    else
      stale_ids+=( "$current" )
    fi
  done
  for desired in "${DESIRED_WINDOW_IDS[@]}"; do
    if ! array_contains "$desired" "${current_ids[@]+"${current_ids[@]}"}"; then
      missing_ids+=( "$desired" )
      ((missing_count++)) || true
    fi
  done

  # Add an anchor before removing the last stale window so the session survives.
  if [[ "$has_current_desired" != true ]] && (( missing_count > 0 )); then
    missing_first="${missing_ids[0]}"
    tmux link-window -d -a -s "$missing_first" \
      -t "$AGENT_SESSION_ID:{end}" >/dev/null || return 1
    missing_ids=( "${missing_ids[@]:1}" )
  fi

  for window in "${stale_ids[@]+"${stale_ids[@]}"}"; do
    remove_agent_session_window "$window"
  done
  for window in "${missing_ids[@]+"${missing_ids[@]}"}"; do
    tmux link-window -d -a -s "$window" \
      -t "$AGENT_SESSION_ID:{end}" >/dev/null || return 1
  done
  renumber_agent_session
}

sync_agent_session() (
  local status

  tmux wait-for -L "$AGENT_LINK_LOCK" >/dev/null 2>&1 || return 1
  trap 'tmux wait-for -U "$AGENT_LINK_LOCK" >/dev/null 2>&1 || true' EXIT
  reconcile_agent_session
  status=$?
  (( status == 0 )) || return "$status"
  sync_dashboard
)

unlink_agent_window() (
  local window="$1" fingerprint= linked_windows linked
  local -a linked_ids

  tmux wait-for -L "$AGENT_LINK_LOCK" >/dev/null 2>&1 || return 1
  trap 'tmux wait-for -U "$AGENT_LINK_LOCK" >/dev/null 2>&1 || true' EXIT
  locate_agent_session || return $?
  [[ -n "$AGENT_SESSION_ID" ]] || return 0
  collect_source_windows || return 1
  source_window_index "$window" || return 0
  fingerprint="${SOURCE_WINDOW_MEMBERS[$SOURCE_WINDOW_INDEX]}"
  linked_windows="$(tmux list-windows -t "$AGENT_SESSION_ID" \
    -F '#{window_id}' 2>/dev/null)" || return 1
  linked_ids=()
  while IFS= read -r linked; do
    [[ -n "$linked" ]] && linked_ids+=( "$linked" )
  done <<<"$linked_windows"
  array_contains "$window" "${linked_ids[@]+"${linked_ids[@]}"}" || return 0

  if [[ -n "$fingerprint" ]]; then
    tmux set-option -w -t "$window" "$AGENT_SUPPRESSION_OPTION" "$fingerprint" \
      >/dev/null || return 1
  fi
  if ! tmux unlink-window -t "$AGENT_SESSION_ID:$window" >/dev/null; then
    tmux set-option -wu -t "$window" "$AGENT_SUPPRESSION_OPTION" \
      >/dev/null 2>&1 || true
    return 1
  fi
  renumber_agent_session || return 1
  sync_dashboard
)

set_status() {
  local agent="$1"
  local state="$2"
  local pane="$3"
  local pane_pid

  pane_pid="$("${STATUS_TMUX[@]}" display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null)" \
    || return 0
  [[ -n "$pane_pid" ]] || return 0
  [[ -z "${4:-}" || "$pane_pid" == "$4" ]] || return 0
  if [[ "$agent" == claude ]]; then
    "${STATUS_TMUX[@]}" set-option -p -t "$pane" @taw_agent_revision \
      "$(date +%s).$$.$RANDOM" >/dev/null 2>&1 || return 0
  fi
  "${STATUS_TMUX[@]}" set-option -p -t "$pane" @taw_agent "$agent" >/dev/null 2>&1 || return 0
  "${STATUS_TMUX[@]}" set-option -p -t "$pane" @taw_agent_state "$state" >/dev/null 2>&1 || true
  "${STATUS_TMUX[@]}" set-option -p -t "$pane" "$AGENT_PANE_PID_OPTION" "$pane_pid" \
    >/dev/null 2>&1 || true
  if [[ "$agent" == claude ]]; then
    remember_claude_status "$pane" "$pane_pid"
  else
    "${STATUS_TMUX[@]}" set-option -pu -t "$pane" @taw_claude_status >/dev/null 2>&1 || true
    "${STATUS_TMUX[@]}" set-option -pu -t "$pane" @taw_agent_revision >/dev/null 2>&1 || true
  fi
}

acknowledge_status() {
  local pane="$1"
  local state

  pane="$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null)" || return 0
  [[ "$pane" =~ ^%[0-9]+$ ]] || return 0
  state="$(tmux show-option -pqv -t "$pane" @taw_agent_state 2>/dev/null)" || return 0
  [[ "$state" = waiting ]] || return 0
  tmux if-shell -F -t "$pane" '#{&&:#{!:#{pane_dead}},#{==:#{@taw_agent_state},waiting}}' \
    "set-option -p -t $pane @taw_agent_state acknowledged" >/dev/null 2>&1 || true
}

clear_status() {
  local pane="$1"

  tmux set-option -pu -t "$pane" @taw_agent_state >/dev/null 2>&1 || true
  tmux set-option -pu -t "$pane" @taw_agent >/dev/null 2>&1 || true
  tmux set-option -pu -t "$pane" "$AGENT_PANE_PID_OPTION" >/dev/null 2>&1 || true
  tmux set-option -pu -t "$pane" @taw_claude_status >/dev/null 2>&1 || true
  tmux set-option -pu -t "$pane" @taw_agent_revision >/dev/null 2>&1 || true
}

case "${1:-}" in
  hook)
    [[ $# == 3 && "$2" == claude ]] || { usage; exit 2; }
    case "$3" in idle|thinking|waiting) ;; *) usage; exit 2 ;; esac
    tmux_available || exit 0
    capture_claude_event_time || exit 0
    [[ -n "${TMUX:-}" ]] || STATUS_TMUX=(tmux -L default)
    with_status_lock publish_claude_hook "$3"
    ;;
  start)
    [[ $# -ge 2 && $# -le 3 ]] || { usage; exit 2; }
    supported_agent "$2" || { usage; exit 2; }
    pane="$(pane_target "${3:-}")" || exit 0
    tmux_available || exit 0
    if [[ "$2" == claude ]]; then
      capture_claude_event_time || exit 0
      if [[ ! -t 0 ]]; then
        read_claude_payload "$(cat)" || exit 0
      fi
      CLAUDE_START=true
    fi
    with_status_lock set_status "$2" idle "$pane"
    sync_agent_session || true
    ;;
  set)
    [[ $# -ge 3 && $# -le 4 ]] || { usage; exit 2; }
    case "$2" in codex|claude) ;; *) usage; exit 2 ;; esac
    case "$3" in idle|thinking|waiting) ;; *) usage; exit 2 ;; esac
    pane="$(pane_target "${4:-}")" || exit 0
    tmux_available || exit 0
    if [[ "$2" == claude ]]; then
      capture_claude_event_time || exit 0
    fi
    with_status_lock set_status "$2" "$3" "$pane"
    ;;
  acknowledge)
    [[ $# -le 2 ]] || { usage; exit 2; }
    pane="$(pane_target "${2:-}")" || exit 0
    tmux_available || exit 0
    with_status_lock acknowledge_status "$pane"
    ;;
  clear)
    [[ $# -le 2 ]] || { usage; exit 2; }
    pane="$(pane_target "${2:-}")" || exit 0
    tmux_available || exit 0
    with_status_lock clear_status "$pane"
    sync_agent_session || true
    ;;
  sync)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    [[ -n "${TMUX:-}" ]] || exit 0
    tmux_available || exit 0
    sync_agent_session
    ;;
  refresh)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    [[ -n "${TMUX:-}" ]] || exit 0
    tmux_available || exit 0
    with_tmux_lock taw-agent-refresh refresh_claude_status </dev/null
    ;;
  unlink)
    [[ $# -eq 2 ]] || { usage; exit 2; }
    [[ -n "${TMUX:-}" ]] || exit 0
    tmux_available || exit 0
    unlink_agent_window "$2"
    ;;
  *)
    usage
    exit 2
    ;;
esac
