#!/usr/bin/env bash

set -u

usage() {
  printf 'usage: taw-agent-dashboard [open|focus|sync|toggle|close|unlink]\n' >&2
}

AGENT_SESSION_NAME=agents
AGENT_SESSION_MARKER=@taw_agent_link_session
DASHBOARD_SESSION_MARKER=@taw_agent_dashboard_session
DASHBOARD_SOURCE_WINDOW_OPTION=@taw_agent_dashboard_window_id
DASHBOARD_LOCK=taw-agent-dashboard
DASHBOARD_RUNTIME_DIR="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
DASHBOARD_SERVER_KEY="${TMUX:-}"
DASHBOARD_SERVER_KEY="${DASHBOARD_SERVER_KEY%%,*}"
if [[ -z "$DASHBOARD_SERVER_KEY" ]] && command -v tmux >/dev/null 2>&1; then
  DASHBOARD_SERVER_KEY="$(tmux display-message -p '#{socket_path}' 2>/dev/null || true)"
fi
DASHBOARD_SERVER_KEY="${DASHBOARD_SERVER_KEY//\//_}"
DASHBOARD_SERVER_KEY="${DASHBOARD_SERVER_KEY//:/_}"
DASHBOARD_SERVER_KEY="${DASHBOARD_SERVER_KEY//[^[:alnum:]_.-]/_}"
if [[ -n "$DASHBOARD_SERVER_KEY" ]]; then
  DASHBOARD_DEFAULT_STATE_FILE="$DASHBOARD_RUNTIME_DIR/taw-agent-dashboard.$DASHBOARD_SERVER_KEY.state"
else
  DASHBOARD_DEFAULT_STATE_FILE="$DASHBOARD_RUNTIME_DIR/taw-agent-dashboard.state"
fi
DASHBOARD_STATE_FILE="${TAW_AGENT_DASHBOARD_STATE_FILE:-$DASHBOARD_DEFAULT_STATE_FILE}"
DASHBOARD_OSASCRIPT="${TAW_AGENT_DASHBOARD_OSASCRIPT:-osascript}"

MANAGED_SESSION_ID=
STATE_WINDOW_ID=
STATE_TERMINALS=()
STATE_SESSIONS=()
STATE_SOURCE_WINDOWS=()
STATE_EXCLUDED_SOURCE_WINDOWS=()
STATE_PENDING_WINDOW_ID=
STATE_PENDING_SESSIONS=()
STATE_EXCLUSIONS_PRUNED=0
DESIRED_WINDOWS=()
PRESERVED_VIEW_SESSIONS=()
PRESERVE_STATE_ON_FAILURE=0

tmux_available() {
  command -v tmux >/dev/null 2>&1
}

osascript_available() {
  [[ -n "${TAW_AGENT_DASHBOARD_OSASCRIPT:-}" ]] \
    || command -v osascript >/dev/null 2>&1
}

locate_managed_session() {
  local sessions line session_id session_name marker rest tab=$'\t'
  local managed_id= named_id=

  MANAGED_SESSION_ID=
  sessions="$(tmux list-sessions \
    -F $'#{session_id}\t#{session_name}\t#{@taw_agent_link_session}' 2>/dev/null)" \
    || return 2

  while IFS= read -r line; do
    [[ -n "$line" && "$line" = *"$tab"* ]] || continue
    session_id="${line%%"$tab"*}"
    rest="${line#*"$tab"}"
    session_name="${rest%%"$tab"*}"
    marker="${rest#*"$tab"}"
    [[ "$marker" = 1 ]] && managed_id="$session_id"
    [[ "$session_name" = "$AGENT_SESSION_NAME" ]] && named_id="$session_id"
  done <<<"$sessions"

  [[ -n "$managed_id" && ( -z "$named_id" || "$named_id" = "$managed_id" ) ]] \
    || return 1
  MANAGED_SESSION_ID="$managed_id"
}

collect_desired_windows() {
  local windows window status

  DESIRED_WINDOWS=()
  locate_managed_session || {
    status=$?
    return "$status"
  }
  windows="$(tmux list-windows -t "$MANAGED_SESSION_ID" -F '#{window_id}' 2>/dev/null)" \
    || return 2
  while IFS= read -r window; do
    [[ -n "$window" ]] && DESIRED_WINDOWS+=( "$window" )
  done <<<"$windows"
  ((${#DESIRED_WINDOWS[@]} > 0))
}

load_state() {
  local line kind value session source tab=$'\t'

  STATE_WINDOW_ID=
  STATE_TERMINALS=()
  STATE_SESSIONS=()
  STATE_SOURCE_WINDOWS=()
  STATE_EXCLUDED_SOURCE_WINDOWS=()
  STATE_PENDING_WINDOW_ID=
  STATE_PENDING_SESSIONS=()
  [[ -s "$DASHBOARD_STATE_FILE" ]] || return 1

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    kind="${line%%"$tab"*}"
    value="${line#*"$tab"}"
    case "$kind" in
      window)
        STATE_WINDOW_ID="$value"
        ;;
      terminal)
        STATE_TERMINALS+=( "${value%%"$tab"*}" )
        value="${value#*"$tab"}"
        session="${value%%"$tab"*}"
        source="${value#*"$tab"}"
        [[ "$value" != "$source" && -n "$session" && -n "$source" ]] \
          || return 1
        STATE_SESSIONS+=( "$session" )
        STATE_SOURCE_WINDOWS+=( "$source" )
        ;;
      exclude)
        [[ -n "$value" ]] || return 1
        STATE_EXCLUDED_SOURCE_WINDOWS+=( "$value" )
        ;;
      pending)
        [[ -n "$value" ]] || return 1
        STATE_PENDING_WINDOW_ID="$value"
        ;;
      pending-session)
        [[ -n "$value" ]] || return 1
        STATE_PENDING_SESSIONS+=( "$value" )
        ;;
      *)
        return 1
        ;;
    esac
  done <"$DASHBOARD_STATE_FILE"

  if [[ -n "$STATE_WINDOW_ID" ]]; then
    [[ ${#STATE_TERMINALS[@]} -gt 0 \
      && ${#STATE_TERMINALS[@]} -eq ${#STATE_SESSIONS[@]} \
      && ${#STATE_TERMINALS[@]} -eq ${#STATE_SOURCE_WINDOWS[@]} ]]
  else
    [[ ${#STATE_TERMINALS[@]} -eq 0 \
      && ( -n "$STATE_PENDING_WINDOW_ID" || ${#STATE_PENDING_SESSIONS[@]} > 0 ) ]]
  fi
}

state_has_dashboard() {
  [[ -n "$STATE_WINDOW_ID" && ${#STATE_TERMINALS[@]} -gt 0 \
    && ${#STATE_TERMINALS[@]} -eq ${#STATE_SESSIONS[@]} \
    && ${#STATE_TERMINALS[@]} -eq ${#STATE_SOURCE_WINDOWS[@]} ]]
}

write_state() {
  local window_id="$1"
  shift
  local parent temp i source session

  parent="${DASHBOARD_STATE_FILE%/*}"
  [[ "$parent" != "$DASHBOARD_STATE_FILE" ]] || parent=.
  mkdir -p "$parent" || return 1
  temp="$DASHBOARD_STATE_FILE.$$"
  {
    printf 'window\t%s\n' "$window_id"
    if [[ -n "$STATE_PENDING_WINDOW_ID" ]]; then
      printf 'pending\t%s\n' "$STATE_PENDING_WINDOW_ID"
    fi
    for session in "${STATE_PENDING_SESSIONS[@]}"; do
      printf 'pending-session\t%s\n' "$session"
    done
    for ((i = 0; i < ${#STATE_SESSIONS[@]}; i++)); do
      printf 'terminal\t%s\t%s\t%s\n' \
        "${STATE_TERMINALS[$i]}" "${STATE_SESSIONS[$i]}" \
        "${STATE_SOURCE_WINDOWS[$i]}"
    done
    for source in "${STATE_EXCLUDED_SOURCE_WINDOWS[@]+${STATE_EXCLUDED_SOURCE_WINDOWS[@]}}"; do
      printf 'exclude\t%s\n' "$source"
    done
  } >"$temp" || {
    rm -f "$temp"
    return 1
  }
  mv -f "$temp" "$DASHBOARD_STATE_FILE" || {
    rm -f "$temp"
    return 1
  }
}

clear_state() {
  local status

  rm -f "$DASHBOARD_STATE_FILE"
  status=$?
  STATE_PENDING_WINDOW_ID=
  STATE_PENDING_SESSIONS=()
  return "$status"
}

array_contains() {
  local expected="$1"
  shift
  local actual

  for actual in "$@"; do
    [[ "$actual" = "$expected" ]] && return 0
  done
  return 1
}

apply_state_exclusions() {
  local source window
  local -a active_exclusions filtered_windows

  STATE_EXCLUSIONS_PRUNED=0
  active_exclusions=()
  for source in "${STATE_EXCLUDED_SOURCE_WINDOWS[@]+${STATE_EXCLUDED_SOURCE_WINDOWS[@]}}"; do
    array_contains "$source" "${DESIRED_WINDOWS[@]+${DESIRED_WINDOWS[@]}}" \
      || continue
    active_exclusions+=( "$source" )
  done
  if ((${#active_exclusions[@]} < ${#STATE_EXCLUDED_SOURCE_WINDOWS[@]})); then
    STATE_EXCLUSIONS_PRUNED=1
  fi
  STATE_EXCLUDED_SOURCE_WINDOWS=(
    "${active_exclusions[@]+${active_exclusions[@]}}"
  )

  filtered_windows=()
  for window in "${DESIRED_WINDOWS[@]}"; do
    array_contains "$window" \
      "${STATE_EXCLUDED_SOURCE_WINDOWS[@]+${STATE_EXCLUDED_SOURCE_WINDOWS[@]}}" \
      && continue
    filtered_windows+=( "$window" )
  done
  DESIRED_WINDOWS=( "${filtered_windows[@]}" )
}

state_matches_desired() {
  local i marker source session active_window

  ((${#STATE_SOURCE_WINDOWS[@]} == ${#DESIRED_WINDOWS[@]})) || return 1
  dashboard_terminals_are_live || return $?
  for ((i = 0; i < ${#DESIRED_WINDOWS[@]}; i++)); do
    [[ "${STATE_SOURCE_WINDOWS[$i]}" = "${DESIRED_WINDOWS[$i]}" ]] || return 1
    session="${STATE_SESSIONS[$i]}"
    tmux has-session -t "=$session" >/dev/null 2>&1 || return 1
    marker="$(tmux show-option -qv -t "$session" \
      "$DASHBOARD_SESSION_MARKER" 2>/dev/null)" || return 1
    source="$(tmux show-option -qv -t "$session" \
      "$DASHBOARD_SOURCE_WINDOW_OPTION" 2>/dev/null)" || return 1
    [[ "$marker" = 1 && "$source" = "${STATE_SOURCE_WINDOWS[$i]}" ]] \
      || return 1
    active_window="$(tmux display-message -p -t "$session:" '#{window_id}' \
      2>/dev/null)" || return 1
    if [[ "$active_window" != "${STATE_SOURCE_WINDOWS[$i]}" ]]; then
      tmux select-window -t "$session:${STATE_SOURCE_WINDOWS[$i]}" \
        >/dev/null 2>&1 || return 1
      active_window="$(tmux display-message -p -t "$session:" '#{window_id}' \
        2>/dev/null)" || return 1
      [[ "$active_window" = "${STATE_SOURCE_WINDOWS[$i]}" ]] || return 1
    fi
  done
}

dashboard_script() {
  local mode="$1"
  shift

  "$DASHBOARD_OSASCRIPT" - "$mode" "$@" <<'APPLESCRIPT'
on run argv
    set mode to item 1 of argv

    if mode is "health" or mode is "terminals-health" then
        if not (application "Ghostty" is running) then
            return "0"
        end if
    end if

    tell application "Ghostty"
        if mode is "health" then
            set targetWindowID to item 2 of argv
            repeat with candidateWindow in windows
                if (id of candidateWindow as text) is targetWindowID then return "1"
            end repeat
            return "0"
        end if

        if mode is "terminals-health" then
            repeat with terminalIndex from 2 to (count of argv)
                set targetTerminalID to item terminalIndex of argv
                set foundTerminal to false
                repeat with candidateTerminal in terminals
                    if (id of candidateTerminal as text) is targetTerminalID then
                        set foundTerminal to true
                        exit repeat
                    end if
                end repeat
                if not foundTerminal then return "0"
            end repeat
            return "1"
        end if

        if mode is "focus" then
            set targetWindowID to item 2 of argv
            repeat with candidateWindow in windows
                if (id of candidateWindow as text) is targetWindowID then
                    activate window candidateWindow
                    return "1"
                end if
            end repeat
            return "0"
        end if

        if mode is "close" then
            set targetWindowID to item 2 of argv
            repeat with candidateWindow in windows
                if (id of candidateWindow as text) is targetWindowID then
                    close window candidateWindow
                    return "1"
                end if
            end repeat
            return "0"
        end if

        if mode is "close-terminal" then
            set targetTerminalID to item 2 of argv
            repeat with candidateTerminal in terminals
                if (id of candidateTerminal as text) is targetTerminalID then
                    close candidateTerminal
                    return "1"
                end if
            end repeat
            return "0"
        end if

        if mode is "build" then
            set sessionNames to items 2 thru (count of argv) of argv
            set surfaceCount to count of sessionNames
            if surfaceCount is less than 1 then error "dashboard requires a session"

            set columnCount to 1
            repeat while (columnCount * columnCount) is less than surfaceCount
                set columnCount to columnCount + 1
            end repeat
            set rowCount to (surfaceCount + columnCount - 1) div columnCount

            try
                set cfg to new surface configuration
                set win to new window with configuration cfg
                set firstTerminal to terminal 1 of selected tab of win
                set allTerms to {firstTerminal}
                set rowAnchors to {firstTerminal}

                repeat with column from 2 to columnCount
                    set anchorTerminal to item (column - 1) of rowAnchors
                    set newTerminal to split anchorTerminal direction right with configuration cfg
                    set end of rowAnchors to newTerminal
                    set end of allTerms to newTerminal
                end repeat

                set nextSurface to columnCount + 1
                repeat with row from 2 to rowCount
                    repeat with column from 1 to columnCount
                        if nextSurface is less than or equal to surfaceCount then
                            set anchorTerminal to item column of rowAnchors
                            set newTerminal to split anchorTerminal direction down with configuration cfg
                            set item column of rowAnchors to newTerminal
                            set end of allTerms to newTerminal
                            set nextSurface to nextSurface + 1
                        end if
                    end repeat
                end repeat

                repeat with surfaceIndex from 1 to surfaceCount
                    set sessionName to item surfaceIndex of sessionNames
                    set currentTerminal to item surfaceIndex of allTerms
                    input text ("env -u TMUX tmux attach-session -t " & sessionName) to currentTerminal
                    send key "enter" to currentTerminal
                end repeat

                try
                    perform action "equalize_splits" on firstTerminal
                end try
                focus firstTerminal

                set outputLines to {(id of win as text)}
                repeat with currentTerminal in allTerms
                    set end of outputLines to (id of currentTerminal as text)
                end repeat
                set AppleScript's text item delimiters to linefeed
                return outputLines as text
            on error errorMessage number errorNumber
                try
                    close window win
                end try
                error errorMessage number errorNumber
            end try
        end if
    end tell

    error "unknown dashboard operation"
end run
APPLESCRIPT
}

view_session_name() {
  local source_window="$1" base candidate suffix marker source

  base="taw-agent-view-${source_window#@}"
  candidate="$base"
  suffix=1
  while tmux has-session -t "=$candidate" >/dev/null 2>&1; do
    marker="$(tmux show-option -qv -t "$candidate" "$DASHBOARD_SESSION_MARKER" 2>/dev/null)" \
      || marker=
    source="$(tmux show-option -qv -t "$candidate" \
      "$DASHBOARD_SOURCE_WINDOW_OPTION" 2>/dev/null)" || source=
    if [[ "$marker" = 1 && "$source" = "$source_window" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
    candidate="$base-$suffix"
    suffix=$((suffix + 1))
  done
  printf '%s\n' "$candidate"
}

ensure_view_session() {
  local source_window="$1" source_path="$2" session_name created session_id window_index
  local tab=$'\t'

  session_name="$(view_session_name "$source_window")" || return 1
  if tmux has-session -t "=$session_name" >/dev/null 2>&1; then
    tmux link-window -d -k -s "$MANAGED_SESSION_ID:$source_window" \
      -t "$session_name:" >/dev/null 2>&1 || return 1
    printf '%s\n' "$session_name"
    return 0
  fi

  created="$(tmux new-session -d -P -F $'#{session_id}\t#{window_index}' \
    -s "$session_name" -c "$source_path" 2>/dev/null)" || return 1
  session_id="${created%%"$tab"*}"
  window_index="${created#*"$tab"}"
  if [[ -z "$session_id" || "$session_id" = "$created" || -z "$window_index" ]]; then
    cleanup_new_view_session "$session_name" || true
    return 1
  fi
  tmux set-option -t "$session_id" "$DASHBOARD_SESSION_MARKER" 1 >/dev/null \
    || {
      cleanup_new_view_session "$session_name" || true
      return 1
    }
  tmux set-option -t "$session_id" "$DASHBOARD_SOURCE_WINDOW_OPTION" \
    "$source_window" >/dev/null || {
    cleanup_new_view_session "$session_name" || true
    return 1
  }
  tmux link-window -d -k -s "$MANAGED_SESSION_ID:$source_window" \
    -t "$session_id:$window_index" >/dev/null || {
    cleanup_new_view_session "$session_name" || true
    return 1
  }
  printf '%s\n' "$session_name"
}

cleanup_new_view_session() {
  local session_name="$1"

  tmux kill-session -t "=$session_name" >/dev/null 2>&1 && return 0
  printf '%s\n' "$session_name"
  return 1
}

destroy_view_session() {
  local session_name="$1" marker actual sessions

  if ! tmux has-session -t "=$session_name" >/dev/null 2>&1; then
    sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null)" || return 1
    while IFS= read -r actual; do
      [[ "$actual" = "$session_name" ]] && return 1
    done <<<"$sessions"
    return 0
  fi
  marker="$(tmux show-option -qv -t "$session_name" "$DASHBOARD_SESSION_MARKER" 2>/dev/null)" \
    || marker=
  [[ "$marker" = 1 ]] || return 1
  tmux kill-session -t "=$session_name" >/dev/null 2>&1
}

cleanup_created_view_sessions() {
  local session status=0

  STATE_PENDING_SESSIONS=()
  for session in "${VIEW_SESSIONS[@]+${VIEW_SESSIONS[@]}}"; do
    array_contains "$session" \
      "${PRESERVED_VIEW_SESSIONS[@]+${PRESERVED_VIEW_SESSIONS[@]}}" \
      && continue
    if ! destroy_view_session "$session"; then
      STATE_PENDING_SESSIONS+=( "$session" )
      status=1
    fi
  done
  if ((status)); then
    write_state "$STATE_WINDOW_ID" || true
  fi
  return "$status"
}

cleanup_state_view_sessions() {
  local session status=0
  for session in "${STATE_SESSIONS[@]+${STATE_SESSIONS[@]}}"; do
    [[ -n "$session" ]] || continue
    destroy_view_session "$session" || status=1
  done
  return "$status"
}

dashboard_is_live() {
  local health

  osascript_available || return 1
  health="$(dashboard_script health "$STATE_WINDOW_ID" 2>/dev/null)" || return 2
  [[ "$health" = 1 ]]
}

dashboard_terminals_are_live() {
  local health

  health="$(dashboard_script terminals-health \
    "${STATE_TERMINALS[@]+${STATE_TERMINALS[@]}}" 2>/dev/null)" || return 2
  [[ "$health" = 1 ]]
}

focus_dashboard() {
  dashboard_script focus "$STATE_WINDOW_ID" >/dev/null
}

focus_existing_dashboard() {
  load_state || return 0
  state_has_dashboard || return 0
  dashboard_is_live || return 0
  focus_dashboard
}

close_dashboard_window() {
  local health_status

  if dashboard_is_live; then
    dashboard_script close "$STATE_WINDOW_ID" >/dev/null
    return
  else
    health_status=$?
  fi
  [[ "$health_status" -eq 2 ]] && return 1
  return 0
}

cleanup_pending_window() {
  [[ -n "$STATE_PENDING_WINDOW_ID" ]] || return 0
  dashboard_script close "$STATE_PENDING_WINDOW_ID" >/dev/null 2>&1 || return 1
  STATE_PENDING_WINDOW_ID=
  write_state "$STATE_WINDOW_ID"
}

cleanup_pending_sessions() {
  local session status=0 had_pending=0
  local -a remaining

  remaining=()
  for session in "${STATE_PENDING_SESSIONS[@]+${STATE_PENDING_SESSIONS[@]}}"; do
    had_pending=1
    if destroy_view_session "$session"; then
      continue
    fi
    remaining+=( "$session" )
    status=1
  done
  STATE_PENDING_SESSIONS=( "${remaining[@]+${remaining[@]}}" )
  if ((status)); then
    write_state "$STATE_WINDOW_ID" || true
    return 1
  fi
  if ((had_pending)); then
    write_state "$STATE_WINDOW_ID"
  fi
  return 0
}

parse_build_result() {
  local result="$1" line
  local -a result_lines

  STATE_WINDOW_ID=
  result_lines=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && result_lines+=( "$line" )
  done <<<"$result"
  ((${#result_lines[@]} > 0)) && STATE_WINDOW_ID="${result_lines[0]}"
  (( ${#result_lines[@]} == ${#DESIRED_WINDOWS[@]} + 1 )) || return 1
  STATE_TERMINALS=()
  STATE_SESSIONS=()
  STATE_SOURCE_WINDOWS=()
  local i
  for ((i = 0; i < ${#DESIRED_WINDOWS[@]}; i++)); do
    STATE_TERMINALS+=( "${result_lines[$((i + 1))]}" )
    STATE_SESSIONS+=( "${VIEW_SESSIONS[$i]}" )
    STATE_SOURCE_WINDOWS+=( "${DESIRED_WINDOWS[$i]}" )
  done
}

VIEW_SESSIONS=()

create_dashboard() {
  local window source_path view_session result session

  VIEW_SESSIONS=()
  for window in "${DESIRED_WINDOWS[@]}"; do
    source_path="$(tmux display-message -p -t "$MANAGED_SESSION_ID:$window" \
      '#{pane_current_path}' 2>/dev/null)" || {
        cleanup_created_view_sessions
        return 1
      }
    if view_session="$(ensure_view_session "$window" "$source_path")"; then
      VIEW_SESSIONS+=( "$view_session" )
    else
      [[ -n "$view_session" ]] && VIEW_SESSIONS+=( "$view_session" )
      cleanup_created_view_sessions
      return 1
    fi
  done

  result="$(dashboard_script build "${VIEW_SESSIONS[@]}" 2>/dev/null)" || {
    cleanup_created_view_sessions
    return 1
  }
  parse_build_result "$result" || {
    [[ -z "$STATE_WINDOW_ID" ]] || \
      dashboard_script close "$STATE_WINDOW_ID" >/dev/null 2>&1 || true
    cleanup_created_view_sessions
    return 1
  }
  write_state "$STATE_WINDOW_ID" || {
    if ! dashboard_script close "$STATE_WINDOW_ID" >/dev/null 2>&1; then
      STATE_PENDING_WINDOW_ID="$STATE_WINDOW_ID"
      STATE_WINDOW_ID=
      STATE_TERMINALS=()
      STATE_SESSIONS=()
      STATE_SOURCE_WINDOWS=()
      STATE_EXCLUDED_SOURCE_WINDOWS=()
    fi
    cleanup_created_view_sessions
    if [[ -n "$STATE_PENDING_WINDOW_ID" ]]; then
      write_state "$STATE_WINDOW_ID" || true
    elif (( ! PRESERVE_STATE_ON_FAILURE )) \
      && ((${#STATE_PENDING_SESSIONS[@]} == 0)); then
      clear_state
    fi
    return 1
  }
}

rebuild_dashboard() {
  local old_window_id="$STATE_WINDOW_ID" replacement_window_id session
  local cleanup_status=0
  local -a old_terminals old_sessions old_sources old_exclusions
  local -a old_pending_sessions failed_sessions
  local old_pending_window_id failed_window_id

  old_terminals=( "${STATE_TERMINALS[@]+${STATE_TERMINALS[@]}}" )
  old_sessions=( "${STATE_SESSIONS[@]+${STATE_SESSIONS[@]}}" )
  old_sources=( "${STATE_SOURCE_WINDOWS[@]+${STATE_SOURCE_WINDOWS[@]}}" )
  old_exclusions=(
    "${STATE_EXCLUDED_SOURCE_WINDOWS[@]+${STATE_EXCLUDED_SOURCE_WINDOWS[@]}}"
  )
  old_pending_sessions=(
    "${STATE_PENDING_SESSIONS[@]+${STATE_PENDING_SESSIONS[@]}}"
  )
  old_pending_window_id="$STATE_PENDING_WINDOW_ID"

  PRESERVED_VIEW_SESSIONS=()
  for session in "${STATE_SESSIONS[@]+${STATE_SESSIONS[@]}}"; do
    tmux has-session -t "=$session" >/dev/null 2>&1 \
      && PRESERVED_VIEW_SESSIONS+=( "$session" )
  done
  PRESERVE_STATE_ON_FAILURE=1
  if ! create_dashboard; then
    failed_window_id="$STATE_PENDING_WINDOW_ID"
    failed_sessions=(
      "${STATE_PENDING_SESSIONS[@]+${STATE_PENDING_SESSIONS[@]}}"
    )
    STATE_WINDOW_ID="$old_window_id"
    STATE_TERMINALS=( "${old_terminals[@]+${old_terminals[@]}}" )
    STATE_SESSIONS=( "${old_sessions[@]+${old_sessions[@]}}" )
    STATE_SOURCE_WINDOWS=( "${old_sources[@]+${old_sources[@]}}" )
    STATE_EXCLUDED_SOURCE_WINDOWS=(
      "${old_exclusions[@]+${old_exclusions[@]}}"
    )
    STATE_PENDING_WINDOW_ID="$old_pending_window_id"
    [[ -n "$failed_window_id" ]] \
      && STATE_PENDING_WINDOW_ID="$failed_window_id"
    STATE_PENDING_SESSIONS=( "${old_pending_sessions[@]+${old_pending_sessions[@]}}" )
    for session in "${failed_sessions[@]+${failed_sessions[@]}}"; do
      array_contains "$session" \
        "${STATE_PENDING_SESSIONS[@]+${STATE_PENDING_SESSIONS[@]}}" \
        || STATE_PENDING_SESSIONS+=( "$session" )
    done
    write_state "$old_window_id" || true
    PRESERVED_VIEW_SESSIONS=()
    PRESERVE_STATE_ON_FAILURE=0
    return 1
  fi
  if [[ -n "$old_window_id" && "$old_window_id" != "$STATE_WINDOW_ID" ]] && \
    ! dashboard_script close "$old_window_id" >/dev/null 2>&1; then
    replacement_window_id="$STATE_WINDOW_ID"
    if ! dashboard_script close "$replacement_window_id" >/dev/null 2>&1; then
      STATE_PENDING_WINDOW_ID="$replacement_window_id"
    else
      STATE_PENDING_WINDOW_ID="$old_pending_window_id"
    fi
    cleanup_created_view_sessions
    STATE_WINDOW_ID="$old_window_id"
    STATE_TERMINALS=( "${old_terminals[@]+${old_terminals[@]}}" )
    STATE_SESSIONS=( "${old_sessions[@]+${old_sessions[@]}}" )
    STATE_SOURCE_WINDOWS=( "${old_sources[@]+${old_sources[@]}}" )
    STATE_EXCLUDED_SOURCE_WINDOWS=(
      "${old_exclusions[@]+${old_exclusions[@]}}"
    )
    if ! write_state "$old_window_id"; then
      write_state "$old_window_id" || {
        PRESERVED_VIEW_SESSIONS=()
        PRESERVE_STATE_ON_FAILURE=0
        return 1
      }
    fi
    PRESERVED_VIEW_SESSIONS=()
    PRESERVE_STATE_ON_FAILURE=0
    return 1
  fi
  failed_sessions=()
  for session in "${PRESERVED_VIEW_SESSIONS[@]+${PRESERVED_VIEW_SESSIONS[@]}}"; do
    array_contains "$session" "${STATE_SESSIONS[@]+${STATE_SESSIONS[@]}}" \
      && continue
    if ! destroy_view_session "$session"; then
      failed_sessions+=( "$session" )
      cleanup_status=1
    fi
  done
  STATE_PENDING_SESSIONS=( "${failed_sessions[@]+${failed_sessions[@]}}" )
  if ((cleanup_status)); then
    write_state "$STATE_WINDOW_ID" || true
  fi
  PRESERVED_VIEW_SESSIONS=()
  PRESERVE_STATE_ON_FAILURE=0
  return "$cleanup_status"
}

open_dashboard() {
  local health_status match_status

  collect_desired_windows || {
    printf 'taw-agent-dashboard: no managed Codex or Claude windows found\n' >&2
    return 1
  }
  osascript_available || {
    printf 'taw-agent-dashboard: Ghostty AppleScript requires macOS and osascript\n' >&2
    return 1
  }

  if load_state; then
    cleanup_pending_window || return 1
    cleanup_pending_sessions || return 1
    if ! state_has_dashboard; then
      clear_state || return 1
    elif dashboard_is_live; then
      if ((${#STATE_EXCLUDED_SOURCE_WINDOWS[@]} > 0)); then
        STATE_EXCLUDED_SOURCE_WINDOWS=()
        rebuild_dashboard
        return
      fi
      if state_matches_desired; then
        focus_dashboard
        return
      else
        match_status=$?
        [[ "$match_status" -eq 2 ]] && return 1
        rebuild_dashboard
        return
      fi
    fi
    health_status=$?
    [[ "$health_status" -eq 2 ]] && return 1
    cleanup_state_view_sessions || return 1
    clear_state || return 1
  fi
  create_dashboard || return 1
  sync_dashboard
}

sync_dashboard() {
  local health_status membership_status match_status

  load_state || return 0
  cleanup_pending_window || return 1
  cleanup_pending_sessions || return 1
  if ! state_has_dashboard; then
    clear_state
    return
  fi
  if dashboard_is_live; then
    :
  else
    health_status=$?
    [[ "$health_status" -eq 2 ]] && return 1
    cleanup_state_view_sessions || return 1
    clear_state || return 1
    return 0
  fi
  if collect_desired_windows; then
    :
  else
    membership_status=$?
    [[ "$membership_status" -eq 2 ]] && return 1
    close_dashboard_window || return 1
    cleanup_state_view_sessions || return 1
    clear_state || return 1
    return 0
  fi
  apply_state_exclusions
  if ((${#DESIRED_WINDOWS[@]} == 0)); then
    close_dashboard_window || return 1
    cleanup_state_view_sessions || return 1
    clear_state || return 1
    return 0
  fi
  if state_matches_desired; then
    if ((STATE_EXCLUSIONS_PRUNED)); then
      write_state "$STATE_WINDOW_ID" || return 1
    fi
    return 0
  else
    match_status=$?
    [[ "$match_status" -eq 2 ]] && return 1
    rebuild_dashboard
  fi
}

close_dashboard() {
  load_state || return 0
  cleanup_pending_window || return 1
  cleanup_pending_sessions || return 1
  if ! state_has_dashboard; then
    clear_state
    return
  fi
  close_dashboard_window || return 1
  cleanup_state_view_sessions || return 1
  clear_state
}

unlink_dashboard_window() {
  local session_target="$1" source_window marker source terminal i session_name
  local old_window_id
  local -a remaining_terminals remaining_sessions remaining_sources
  local -a old_terminals old_sessions old_sources old_exclusions

  session_name="$(tmux display-message -p -t "$session_target" '#{session_name}' \
    2>/dev/null)" || return 0
  [[ -n "$session_name" ]] || return 0
  marker="$(tmux show-option -qv -t "$session_target" \
    "$DASHBOARD_SESSION_MARKER" 2>/dev/null)" || marker=
  [[ "$marker" = 1 ]] || return 0
  source="$(tmux show-option -qv -t "$session_target" \
    "$DASHBOARD_SOURCE_WINDOW_OPTION" 2>/dev/null)" || source=
  [[ "$source" = "$2" ]] || return 0

  if load_state; then
    cleanup_pending_window || return 1
    cleanup_pending_sessions || return 1
    old_window_id="$STATE_WINDOW_ID"
    old_terminals=( "${STATE_TERMINALS[@]+${STATE_TERMINALS[@]}}" )
    old_sessions=( "${STATE_SESSIONS[@]+${STATE_SESSIONS[@]}}" )
    old_sources=( "${STATE_SOURCE_WINDOWS[@]+${STATE_SOURCE_WINDOWS[@]}}" )
    old_exclusions=(
      "${STATE_EXCLUDED_SOURCE_WINDOWS[@]+${STATE_EXCLUDED_SOURCE_WINDOWS[@]}}"
    )
    terminal=
    for ((i = 0; i < ${#STATE_SESSIONS[@]}; i++)); do
      if [[ "${STATE_SESSIONS[$i]}" = "$session_name" ]]; then
        terminal="${STATE_TERMINALS[$i]}"
        break
      fi
    done
    remaining_terminals=()
    remaining_sessions=()
    remaining_sources=()
    for ((i = 0; i < ${#STATE_SESSIONS[@]}; i++)); do
      [[ "${STATE_SESSIONS[$i]}" = "$session_name" ]] && continue
      remaining_terminals+=( "${STATE_TERMINALS[$i]}" )
      remaining_sessions+=( "${STATE_SESSIONS[$i]}" )
      remaining_sources+=( "${STATE_SOURCE_WINDOWS[$i]}" )
    done
    array_contains "$source" \
      "${STATE_EXCLUDED_SOURCE_WINDOWS[@]+${STATE_EXCLUDED_SOURCE_WINDOWS[@]}}" \
      || STATE_EXCLUDED_SOURCE_WINDOWS+=( "$source" )

    if ((${#remaining_sessions[@]} > 0)); then
      STATE_TERMINALS=( "${remaining_terminals[@]}" )
      STATE_SESSIONS=( "${remaining_sessions[@]}" )
      STATE_SOURCE_WINDOWS=( "${remaining_sources[@]}" )
    fi
    write_state "$STATE_WINDOW_ID" || return 1
    if [[ -n "$terminal" ]] && \
      ! dashboard_script close-terminal "$terminal" >/dev/null 2>&1; then
      STATE_WINDOW_ID="$old_window_id"
      STATE_TERMINALS=( "${old_terminals[@]+${old_terminals[@]}}" )
      STATE_SESSIONS=( "${old_sessions[@]+${old_sessions[@]}}" )
      STATE_SOURCE_WINDOWS=( "${old_sources[@]+${old_sources[@]}}" )
      STATE_EXCLUDED_SOURCE_WINDOWS=(
        "${old_exclusions[@]+${old_exclusions[@]}}"
      )
      write_state "$old_window_id" || true
      return 1
    fi
    if ! destroy_view_session "$session_name"; then
      STATE_PENDING_SESSIONS+=( "$session_name" )
      write_state "$STATE_WINDOW_ID" || true
      return 1
    fi
    if ((${#remaining_sessions[@]} == 0)); then
      clear_state || return 1
    fi
  else
    destroy_view_session "$session_name" || return 1
  fi
}

with_lock() {
  local command="$1"
  shift

  tmux wait-for -L "$DASHBOARD_LOCK" >/dev/null 2>&1 || return 1
  trap 'tmux wait-for -U "$DASHBOARD_LOCK" >/dev/null 2>&1 || true' EXIT
  "$command" "$@"
}

case "${1:-toggle}" in
  open)
    tmux_available || exit 0
    with_lock open_dashboard
    ;;
  sync)
    tmux_available || exit 0
    with_lock sync_dashboard
    ;;
  focus)
    tmux_available || exit 0
    with_lock focus_existing_dashboard
    ;;
  toggle)
    tmux_available || exit 0
    if load_state && dashboard_is_live; then
      with_lock close_dashboard
    else
      with_lock open_dashboard
    fi
    ;;
  close)
    tmux_available || exit 0
    with_lock close_dashboard
    ;;
  unlink)
    [[ $# -eq 3 ]] || { usage; exit 2; }
    tmux_available || exit 0
    with_lock unlink_dashboard_window "$2" "$3"
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage
    exit 2
    ;;
esac
