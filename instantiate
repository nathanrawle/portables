#!/usr/bin/env bash

SCRIPT=${BASH_SOURCE[0]}
for ((hops = 0; hops < 40; hops++)); do
  [[ -L "$SCRIPT" ]] || break
  directory="$(cd -- "$(dirname -- "$SCRIPT")" && pwd -P)" || exit 1
  target="$(readlink "$SCRIPT")" || exit 1
  case "$target" in /*) SCRIPT="$target" ;; *) SCRIPT="$directory/$target" ;; esac
done
[[ ! -L "$SCRIPT" ]] || { printf 'script symlink loop\n' >&2; exit 1; }
HERE="$(cd -- "$(dirname -- "$SCRIPT")" && pwd -P)" || exit 1
. "$HERE/lib/maintenance.bash" || exit 1
LOG_NAME=${LOG_NAME:-instantiate}
export LOG_NAME
if [[ ${1:-} = --help && $# = 1 ]]; then
  printf 'Usage: instantiate\n'
  exit 0
fi
[[ $# = 0 ]] || { log -e "Usage: instantiate"; exit 2; }

case "$OS:$ID" in
  Darwin:*) manager=brew; update=( brew update ); install=( brew install ) ;;
  Linux:ubuntu|Linux:debian|Linux:pop)
    manager=apt; update=( sudo apt-get update ); install=( sudo apt-get install -y ) ;;
  Linux:arch)
    manager=pacman; update=(); install=( sudo pacman -S --needed --noconfirm ) ;;
  Linux:fedora)
    manager=dnf; update=( sudo dnf check-update ); install=( sudo dnf install -y ) ;;
  *) log -e "unsupported platform: $OS $ID"; exit 1 ;;
esac

write_machine_env() {
  local machine target temp
  machine="$(printf '%s' "${HOST:-$(hostname)}" | tr '[:upper:]' '[:lower:]')"
  machine=${machine%%.*}
  case "$machine" in ''|*[!a-z0-9_-]*) log -e "invalid hostname: $machine"; return 1 ;; esac
  target="$PORTABLE_HOME/.$machine.env"
  MACHENV="$target"
  MACHENV_LINK="$HOME/.$machine.env"
  [[ ! -L "$target" ]] || {
    log -e "repository machine env must not be a symlink: $target"
    return 1
  }
  temp="$(mktemp "$PORTABLE_HOME/.machine-env.XXXXXX")" || return 1
  if [[ -e "$target" ]]; then
    cp -p "$target" "$temp" || { rm -f "$temp"; return 1; }
    awk '!/^[[:space:]]*(export[[:space:]]+)?PORTABLES=/' "$target" >"$temp" ||
      { rm -f "$temp"; return 1; }
  fi
  printf 'export PORTABLES=%q\n' "$PORTABLES" >>"$temp" || { rm -f "$temp"; return 1; }
  mv "$temp" "$target"
}
write_machine_env || { failure "machine environment"; finish; exit 1; }
. "$MACHENV" || { failure "load machine environment"; finish; exit 1; }
bash "$PORTABLES/symlinks" || failure "initial symlinks"
if [[ ! -L "$MACHENV_LINK" || ! "$MACHENV_LINK" -ef "$MACHENV" ]]; then
  failure "machine environment link must target repository source: $MACHENV_LINK"
fi

system_ready=1
if [[ "$OS" = Darwin ]]; then
  if ! xcode-select -p >/dev/null 2>&1; then
    log -e "install Xcode command-line tools with xcode-select --install, then rerun"
    system_ready=0
  elif ! command -v brew >/dev/null 2>&1; then
    bash "$MACHINE_TOOLS/homebrew.sh" self-install || system_ready=0
  fi
fi
if [[ "$system_ready" = 1 && ${#update[@]} -gt 0 ]]; then
  rc=0
  "${update[@]}" || rc=$?
  if [[ "$rc" != 0 && ! ( "$manager" = dnf && "$rc" = 100 ) ]]; then system_ready=0; fi
fi
[[ "$system_ready" = 1 ]] || failure "system package prerequisites or metadata"

system_install() {
  local package="$1"
  case "$manager" in
    brew)
      if [[ "$package" = cask:* ]]; then
        package=${package#cask:}
        brew list --cask "$package" >/dev/null 2>&1 && return 0
        [[ "$system_ready" = 1 ]] || return 1
        brew install --cask "$package"
      else
        brew list --formula "$package" >/dev/null 2>&1 && return 0
        [[ "$system_ready" = 1 ]] || return 1
        brew install --formula "$package"
      fi
      ;;
    apt)
      [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null)" = 'install ok installed' ]] && return 0
      [[ "$system_ready" = 1 ]] || return 1
      "${install[@]}" "$package"
      ;;
    pacman)
      pacman -Q "$package" >/dev/null 2>&1 && return 0
      [[ "$system_ready" = 1 ]] || return 1
      "${install[@]}" "$package"
      ;;
    dnf)
      rpm -q "$package" >/dev/null 2>&1 && return 0
      [[ "$system_ready" = 1 ]] || return 1
      "${install[@]}" "$package"
      ;;
  esac
}
for command in curl git; do
  command -v "$command" >/dev/null 2>&1 || system_install "$command" || failure "bootstrap $command"
done

shopt -s nullglob
tools=( "$MACHINE_TOOLS"/*.sh )
owners=()
tokens=()
results=()
blocked=()
inventory_failed=0
for ((i = 0; i < ${#tools[@]}; i++)); do
  blocked[i]=0
  if ! declarations="$(bash "${tools[i]}" install)"; then
    failure "requirements ${tools[i]##*/}"
    inventory_failed=1
    continue
  fi
  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    case "$token" in
      self-install|syspkgmgr:?*|uv:?*|pip:?*|pipx:?*|nvm:?*|npm:?*) ;;
      *) failure "unknown requirement: $token"; inventory_failed=1; continue ;;
    esac
    if [[ "$token" = *[[:space:]]* || "$token" = syspkgmgr:ext:* ]]; then
      failure "invalid requirement: $token"
      inventory_failed=1
      continue
    fi
    owners+=( "$i" )
    tokens+=( "$token" )
    results+=( pending )
  done <<<"$declarations"
done
[[ "$inventory_failed" = 0 ]] || { finish; exit 1; }

ensure_uv() {
  provider_ready uv || return 1
  command -v uv >/dev/null 2>&1 || bash "$MACHINE_TOOLS/uv.sh" self-install || return 1
  require_commands uv
}

load_nvm() {
  provider_ready nvm || return 1
  export NVM_DIR="$HOME/.nvm"
  [[ -s "$NVM_DIR/nvm.sh" ]] || bash "$MACHINE_TOOLS/nvm.sh" self-install || return 1
  require_files "$NVM_DIR/nvm.sh" || return 1
  . "$NVM_DIR/nvm.sh"
}

provider_ready() {
  local index
  for ((index = 0; index < ${#tools[@]}; index++)); do
    if [[ "${tools[index]##*/}" = "$1.sh" && "${blocked[index]}" = 1 ]]; then
      log -e "blocked provider: $1"
      return 1
    fi
  done
}

execute_requirement() (
  local token="$1" owner="$2" value="${1#*:}" version python_path
  local args=()
  case "$token" in
    syspkgmgr:*) system_install "$value" ;;
    self-install) bash "${tools[owner]}" self-install ;;
    uv:python:*)
      ensure_uv || return 1
      IFS=: read -r -a args <<<"${value#python:}"
      if [[ "${args[0]}" = --default ]]; then
        if python_path="$(uv python find --managed-python 2>/dev/null)"; then
          version="$("$python_path" -c 'import platform; print(platform.python_version())')" || return 1
          uv python install "$version" "${args[@]}"
        else
          uv python install "${args[@]}"
        fi
      else
        uv python find --managed-python "${args[0]}" >/dev/null 2>&1 ||
          uv python install "${args[@]}"
      fi
      ;;
    uv:*) ensure_uv && uv tool install "$value" ;;
    pip:*)
      require_commands python3 || return 1
      if ! python3 -m pip --version >/dev/null 2>&1; then
        case "$manager" in
          apt|dnf) system_install python3-pip || return 1 ;;
          pacman) system_install python-pip || return 1 ;;
          brew) log -e "pip unavailable; configure Python first"; return 1 ;;
        esac
      fi
      python3 -m pip install --user "$value"
      ;;
    pipx:*)
      command -v pipx >/dev/null 2>&1 || system_install pipx || return 1
      pipx install "$value"
      ;;
    nvm:*)
      load_nvm || return 1
      version="$(nvm version "$value")" || version=N/A
      [[ "$version" != N/A ]] || nvm install "$value"
      ;;
    npm:*)
      load_nvm || return 1
      require_commands npm || return 1
      npm list -g --depth=0 "$value" >/dev/null 2>&1 || npm install -g "$value"
      ;;
  esac
)

for phase in system self node python uv pip pipx npm; do
  for ((i = 0; i < ${#tokens[@]}; i++)); do
    token=${tokens[i]}
    case "$token" in
      syspkgmgr:*) category=system ;;
      self-install) category=self ;;
      nvm:*) category=node ;;
      uv:python:*) category=python ;;
      uv:*) category=uv ;;
      pip:*) category=pip ;;
      pipx:*) category=pipx ;;
      npm:*) category=npm ;;
    esac
    [[ "$category" = "$phase" ]] || continue
    reused=0
    for ((j = 0; j < i; j++)); do
      if [[ "${tokens[j]}" = "$token" && "${results[j]}" != blocked &&
          ( "$token" != self-install || "${owners[j]}" = "${owners[i]}" ) ]]; then
        results[i]=${results[j]}
        reused=1
        break
      fi
    done
    if [[ "$reused" = 0 ]]; then
      log "ensuring $token (${tools[owners[i]]##*/})"
      results[i]=0
      if [[ "${blocked[owners[i]]}" = 1 ]]; then
        results[i]=blocked
      else
        execute_requirement "$token" "${owners[i]}" || results[i]=1
      fi
    fi
    if [[ "${results[i]}" != 0 ]]; then
      blocked[owners[i]]=1
      failure "$token for ${tools[owners[i]]##*/}"
    fi
  done
done

for ((i = 0; i < ${#tools[@]}; i++)); do
  if [[ "${blocked[i]}" = 1 ]]; then
    failure "blocked config ${tools[i]##*/}"
  else
    bash "${tools[i]}" config || failure "config ${tools[i]##*/}"
  fi
done
bash "$PORTABLES/symlinks" || failure "final symlinks"
finish
